# ============================================================
# 本地 git 仓库忽略规则：只跟踪源码/文档/脚本/补丁/状态
# 大件产物、设备备份、私钥、第三方源码一律不进版本库
# ============================================================

# ---- 顶层大目录 ----
/build/
/backups/
/archive/
/.venv/
/logs/

# New work/ outputs are local. Existing tracked historical files remain tracked.
# Maintained sources belong in apps/, scripts/, kernel/ or packaging/.
/work/

# ---- 白名单目录内仍排除：产物/二进制/密钥 ----
*.img
*.ext4
*.qcow2
*.iso
*.tar
*.tar.gz
*.tgz
*.zip
*.deb
*.AppImage
*.bin
*.elf
*.fw
*.pem
*.key
id_rsa*
id_ed25519*
known_hosts
.secret*
*.token
*.log
__pycache__/
*.pyc

# ---- 第三方源码与工具二进制 ----
/research/src-mm/
/tools/platform-tools/
/tools/stub-lib/

# ---- 公开目录内不入库的文件 ----
/apps/**/node_modules/
/apps/**/dist/
/apps/**/.venv/
/apps/**/build/
/apps/**/*.egg-info/
/apps/**/.pytest_cache/
# ---- 其它 ----
.checkpatch-camelcase.date.0
