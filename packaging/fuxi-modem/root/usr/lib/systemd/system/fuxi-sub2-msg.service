[Unit]
Description=fuxi SIM2 VOICE/WMS listener (incoming SMS and passive call discovery)
After=ModemManager.service 81voltd.service
Wants=ModemManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/sbin/fuxi-qmi-sub2-msg.py
Restart=always
RestartSec=10
RuntimeDirectory=fuxi-sub2-msg
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
