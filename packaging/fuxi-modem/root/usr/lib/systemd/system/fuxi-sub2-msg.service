[Unit]
Description=fuxi SIM2 VOICE/WMS listener (incoming SMS saved + acked, call state logged)
After=ModemManager.service 81voltd.service
Wants=ModemManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/sbin/fuxi-qmi-sub2-msg.py
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
