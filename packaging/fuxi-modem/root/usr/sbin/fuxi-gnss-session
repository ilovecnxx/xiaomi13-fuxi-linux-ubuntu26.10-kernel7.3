#!/usr/bin/env python3
"""Bounded LOC or ModemManager session; never print coordinates."""
import argparse
import fcntl
import json
import math
import os
import signal
import struct
import subprocess
import time


SESSION_ID = 126
MM_LOCATION = "org.freedesktop.ModemManager1.Modem.Location"
GPS_RAW = 2


class ModemManagerTransport:
    interrupted = False

    def __init__(self):
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
        self.Gio, self.GLib = Gio, GLib
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.path = "/org/freedesktop/ModemManager1"
        objects, = self.call("org.freedesktop.DBus.ObjectManager", "GetManagedObjects")
        paths = [path for path, interfaces in objects.items() if MM_LOCATION in interfaces]
        if len(paths) != 1:
            raise ValueError("exactly one modem location interface is required")
        self.path = paths[0]

    def call(self, interface, method, parameters=None):
        return self.bus.call_sync(
            "org.freedesktop.ModemManager1", self.path, interface, method,
            parameters, None, self.Gio.DBusCallFlags.NONE, 15000, None).unpack()

    def properties(self):
        properties, = self.call("org.freedesktop.DBus.Properties", "GetAll",
                                self.GLib.Variant("(s)", (MM_LOCATION,)))
        return properties

    def setup(self, enabled, signals):
        self.call(MM_LOCATION, "Setup", self.GLib.Variant("(ub)", (enabled, signals)))

    def interrupt(self, *_):
        self.interrupted = True

    def sample(self, seconds):
        deadline = time.monotonic() + seconds
        while not self.interrupted and time.monotonic() < deadline:
            time.sleep(min(0.2, max(0, deadline - time.monotonic())))


def mm_session(transport, seconds):
    report = {"schema_version": 1, "backend": "modemmanager",
              "requested_seconds": seconds, "status": "preflight_failed",
              "satellite_fix": "not_tested", "cleanup": {"restored": False}}
    attempted = False
    stage = "preflight"
    try:
        initial = transport.properties()
        enabled, signals = initial["Enabled"], initial["SignalsLocation"]
        if (type(enabled) is not int or enabled not in (0, 1)
                or type(signals) is not bool):
            raise ValueError("another location source is enabled or state is unknown")
        if not initial["Capabilities"] & GPS_RAW:
            report["finding"] = "modemmanager_gps_raw_not_exposed"
            return report
        if transport.interrupted:
            report["status"] = "interrupted"
            return report
        stage = "enable"
        attempted = True
        transport.setup(enabled | GPS_RAW, signals)
        stage = "verify_enabled"
        current = transport.properties()
        if (current["Enabled"], current["SignalsLocation"]) != (enabled | GPS_RAW, signals):
            raise ValueError("location configuration changed")
        report["gps_raw_enabled"] = True
        stage = "sample"
        transport.sample(seconds)
        report["status"] = "interrupted" if transport.interrupted else "completed"
    except Exception:
        report["failed_stage"] = stage
        if stage != "preflight":
            report["status"] = "failed"
    finally:
        if attempted:
            try:
                current = transport.properties()
                # Preserve sources/signalling enabled by another client during the test.
                transport.setup(current["Enabled"] & ~GPS_RAW, current["SignalsLocation"])
                final = transport.properties()
                report["cleanup"]["restored"] = (
                    (final["Enabled"], final["SignalsLocation"]) == (enabled, signals))
            except Exception:
                pass
            if not report["cleanup"]["restored"]:
                report["status"] = "cleanup_failed"
    return report


def preflight(run=subprocess.run):
    def query(argv):
        result = run(argv, capture_output=True, text=True, timeout=8,
                     check=True, env={**os.environ, "LC_ALL": "C"})
        return result.stdout

    location = json.loads(query(["mmcli", "-m", "any", "--location-status",
                                 "--output-json"]))["modem"]["location"]
    enabled = location["enabled"]
    if not isinstance(enabled, list) or not all(isinstance(s, str) for s in enabled):
        raise ValueError("unknown location state")
    if any(s != "3gpp-lac-ci" for s in enabled):
        raise ValueError("another location source is enabled")
    nodes = set()
    for line in query(["qrtr-lookup", "16"]).splitlines():
        fields = line.split()
        try:
            service, _, _, node, _ = map(int, fields[:5])
        except ValueError:
            continue
        if service == 16 and node >= 0:
            nodes.add(node)
    if len(nodes) != 1:
        raise ValueError("LOC discovery must identify exactly one node")
    return nodes.pop()


def position_counts(report, output, satellite_mask):
    try:
        if int(output.get_session_id()) != SESSION_ID:
            return
        status = int(output.get_session_status())
    except Exception:
        report["invalid_reports"] += 1
        return
    report["position_reports"] += 1
    counts = report["session_status_counts"]
    counts[str(status)] = counts.get(str(status), 0) + 1
    if status != 0:
        return
    try:
        lat, lon = output.get_latitude(), output.get_longitude()
        valid = (math.isfinite(lat) and math.isfinite(lon)
                 and -90 <= lat <= 90 and -180 <= lon <= 180)
    except Exception:
        valid = False
    if not valid:
        report["invalid_reports"] += 1
        return
    report["valid_position_reports"] += 1
    try:
        satellite = bool(int(output.get_technology_used()) & satellite_mask)
        if not satellite:
            return
    except Exception:
        return
    try:
        if output.get_satellites_used():
            report["satellite_fix_reports"] += 1
    except Exception:
        pass
    # The MM producer requires satellite technology, not the legacy SV list.
    try:
        radius = output.get_horizontal_uncertainty_circular()
        if not math.isfinite(radius) or radius <= 0:
            return
        report["satellite_position_with_radius"] += 1
        # Same timestamp bounds as mm_fuxi_loc_raw_dictionary().
        if not 0 < output.get_utc_timestamp() <= 253402300799999:
            return
        report["satellite_position_with_radius_utc"] += 1
        # Count field co-occurrence only: confidence refers to the ellipse if present.
        if 0 < output.get_horizontal_confidence() <= 99:
            report["satellite_position_with_radius_utc_confidence"] += 1
    except Exception:
        # Optional LOC fields raise GLib.Error when absent.
        pass


def sv_counts(report, output, snr_mask, missing_list):
    report["sv_reports"] += 1
    try:
        entries = output.get_list()
        if entries:
            report["sv_reports_with_entries"] += 1
            if any(int(sv.valid_information) & snr_mask
                   and math.isfinite(sv.signal_to_noise_ratio_bhz)
                   and sv.signal_to_noise_ratio_bhz > 0 for sv in entries):
                report["sv_reports_with_signal"] += 1
    except Exception as exc:
        key = "sv_reports_without_legacy_list" if missing_list(exc) else "sv_reports_unreadable"
        report[key] += 1


class Transport:
    def __init__(self):
        import gi
        gi.require_version("Qmi", "1.0")
        gi.require_version("Qrtr", "1.0")
        from gi.repository import GLib, Qmi, Qrtr
        self.GLib, self.Qmi, self.Qrtr = GLib, Qmi, Qrtr
        self.device = self.client = None
        self.handlers = []
        self.interrupted = False
        self.loop = None

    def interrupt(self, _signum, _frame):
        self.interrupted = True
        if self.loop is not None:
            self.loop.quit()

    def call(self, obj, method, *args):
        box = []
        getattr(obj, method)(*args, lambda src, result: box.append(result))
        context = self.GLib.MainContext.default()
        while not box:
            context.iteration(True)
        finish = method.removesuffix("_async") + "_finish"
        return getattr(obj, finish)(box[0])

    def open(self, node_id):
        q = self.Qmi
        bus = self.call(self.Qrtr.Bus, "new", 1000, None)
        node = bus.peek_node(node_id)
        if node is None:
            raise RuntimeError("LOC node disappeared")
        self.device = self.call(q.Device, "new_from_node", node, None)
        self.call(self.device, "open", q.DeviceOpenFlags.PROXY, 8, None)
        self.client = self.call(self.device, "allocate_client", q.Service.LOC,
                                q.CID_NONE, 8, None)

    def raw(self, message_id, tlvs):
        q = self.Qmi
        message = q.message_new(q.Service.LOC, self.client.get_cid(),
                                self.client.get_next_transaction_id(), message_id)
        for kind, data in tlvs:
            offset = q.message_tlv_write_init(message, kind)
            for byte in data:
                q.message_tlv_write_guint8(message, byte)
            q.message_tlv_write_complete(message, offset)
        response = self.call(self.device, "command_full", message,
                             q.MessageContext.new(), 8, None)
        offset = q.message_tlv_read_init(response, 0x02)[0]
        _, cursor, result = q.message_tlv_read_guint16(response, offset, 0, q.Endian.LITTLE)
        _, _, error = q.message_tlv_read_guint16(response, offset, cursor, q.Endian.LITTLE)
        if result or error:
            raise RuntimeError("QMI operation failed (%d, %d)" % (result, error))

    def expanded_sv(self, _, message, report):
        # Device::indication supplies a QMUX frame as bytes in PyGObject.
        if len(message) < 13:
            return
        marker, size, _, service, cid, flags, _, msg_id, payload_size = struct.unpack_from('<BHBBBBHHH', message)
        if (marker != 1 or service != int(self.Qmi.Service.LOC) or flags != 4 or msg_id != 0x25
                or cid not in (self.client.get_cid(), self.Qmi.CID_BROADCAST)):
            return
        expanded = None
        try:
            if size != len(message) - 1 or payload_size != len(message) - 13:
                raise ValueError('inconsistent frame size')
            pos = 13
            while pos < len(message):
                kind, length = struct.unpack_from('<BH', message, pos)
                pos += 3
                end = pos + length
                if end > len(message):
                    raise ValueError('truncated TLV')
                if kind == 0x11:
                    if expanded is not None:
                        raise ValueError('duplicate expanded SV list')
                    expanded = memoryview(message)[pos:end]
                pos = end
            if expanded is None:
                report['expanded_sv_list_absent'] += 1
                return
            count, = struct.unpack_from('B', expanded)
            # LOC v02: one count byte, then 29 wire bytes per expanded SV.
            if count > 176 or len(expanded) != 1 + 29 * count:
                raise ValueError('invalid expanded SV list length')
            signal = False
            for valid, snr in struct.iter_unpack('<I20xf1x', expanded[1:]):
                if valid & 0x80 and math.isfinite(snr) and snr > 0:
                    signal = True
                    break
            report['expanded_sv_lists'] += 1
            report['expanded_sv_lists_with_entries'] += bool(count)
            report['expanded_sv_lists_with_signal'] += signal
        except (ValueError, struct.error):
            report['expanded_sv_list_errors'] += 1

    def register(self, report):
        q = self.Qmi
        flags = q.LocEventRegistrationFlag
        mask = int(flags.POSITION_REPORT | flags.GNSS_SATELLITE_INFO | flags.NMEA)
        self.raw(0x21, [(0x01, struct.pack("<Q", mask)), (0x10, b"MHAL"),
                        (0x11, struct.pack("<I", 1)), (0x12, b"\x00")])
        satellite_mask = int(q.LocTechnologyUsed.SATELLITE)
        snr_mask = int(q.LocSatelliteValidInformation.SIGNAL_TO_NOISE_RATIO)
        def missing_list(exc):
            return isinstance(exc, self.GLib.Error) and exc.matches(q.core_error_quark(), q.CoreError.TLVNOTFOUND)
        callbacks = {
            "position-report": lambda _, output: position_counts(report, output, satellite_mask),
            "gnss-sv-info": lambda _, output: sv_counts(report, output, snr_mask, missing_list),
            "nmea": lambda *_: self.increment(report, "nmea_reports"),
        }
        for name, callback in callbacks.items():
            self.handlers.append((self.client, self.client.connect(name, callback)))
        self.handlers.append((self.device, self.device.connect('indication', self.expanded_sv, report)))

    @staticmethod
    def increment(report, key):
        report[key] += 1

    def start(self):
        self.raw(0x22, [(0x01, bytes([SESSION_ID])), (0x10, struct.pack("<I", 1)),
                        (0x12, struct.pack("<I", 0)), (0x13, struct.pack("<I", 1000))])

    def sample(self, seconds):
        self.loop = self.GLib.MainLoop()
        def finish():
            self.loop.quit()
            return self.GLib.SOURCE_REMOVE
        timer = self.GLib.timeout_add(seconds * 1000, finish)
        try:
            if not self.interrupted:
                self.loop.run()
        finally:
            if self.GLib.MainContext.default().find_source_by_id(timer):
                self.GLib.source_remove(timer)
            self.loop = None

    def stop(self):
        self.raw(0x23, [(0x01, bytes([SESSION_ID]))])

    def release(self):
        if self.client is not None:
            for owner, handler in self.handlers:
                owner.disconnect(handler)
            self.call(self.device, "release_client", self.client,
                      self.Qmi.DeviceReleaseClientFlags.RELEASE_CID, 8, None)
            self.client = None

    def close(self):
        if self.device is not None:
            self.call(self.device, "close_async", 8, None)


def session(transport, node, seconds):
    report = {"schema_version": 1, "requested_seconds": seconds,
              "status": "failed", "position_reports": 0, "valid_position_reports": 0,
              "satellite_fix_reports": 0, "invalid_reports": 0,
              "satellite_position_with_radius": 0, "satellite_position_with_radius_utc": 0,
              "satellite_position_with_radius_utc_confidence": 0,
              "sv_reports_with_entries": 0, "sv_reports_with_signal": 0,
              "sv_reports_without_legacy_list": 0, "sv_reports_unreadable": 0,
              "expanded_sv_lists": 0, "expanded_sv_lists_with_entries": 0,
              "expanded_sv_lists_with_signal": 0, "expanded_sv_list_absent": 0,
              "expanded_sv_list_errors": 0,
              "sv_reports": 0, "nmea_reports": 0, "session_status_counts": {},
              "cleanup": {"stop": "not_needed", "release": False, "close": False}}
    start_attempted = False
    stage = "open"
    try:
        transport.open(node)
        stage = "register"
        if not transport.interrupted:
            transport.register(report)
        if not transport.interrupted:
            stage = "start"
            start_attempted = True
            transport.start()
            stage = "sample"
            transport.sample(seconds)
        report["status"] = "interrupted" if transport.interrupted else "completed"
    except Exception:
        report["failed_stage"] = stage
    finally:
        if start_attempted:
            try:
                transport.stop()
                report["cleanup"]["stop"] = "ok"
            except Exception:
                report["cleanup"]["stop"] = "failed"
        for name in ("release", "close"):
            try:
                getattr(transport, name)()
                report["cleanup"][name] = True
            except Exception:
                pass
        cleanup = report["cleanup"]
        if cleanup["stop"] == "failed" or not cleanup["release"] or not cleanup["close"]:
            report["status"] = "cleanup_failed"
    return report


def duration(value):
    seconds = int(value)
    if not 1 <= seconds <= 120:
        raise argparse.ArgumentTypeError("seconds must be in 1..120")
    return seconds


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("seconds", type=duration, nargs="?", default=30)
    parser.add_argument("--modemmanager", action="store_true",
                        help="exercise standard GPS_RAW enable/disable without reading positions")
    args = parser.parse_args()
    try:
        with open("/run/lock/fuxi-gnss-session.lock", "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            node = None if args.modemmanager else preflight()
            transport = ModemManagerTransport() if args.modemmanager else Transport()
            for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                signal.signal(sig, transport.interrupt)
            report = (mm_session(transport, args.seconds) if args.modemmanager
                      else session(transport, node, args.seconds))
    except Exception:
        report = {"schema_version": 1, "status": "preflight_failed"}
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["status"] == "completed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
