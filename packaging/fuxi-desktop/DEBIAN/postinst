#!/bin/sh
# fuxi-desktop postinst
#  首次安装：把旧手工文件（/usr/local/bin、/usr/local/share/applications、/etc/systemd/system）中哈希与 migrate.list
#  一致的移到 /var/backups/fuxi-desktop-migrate/（否则 /etc 单元/drop-in 和 PATH 里的 /usr/local 会遮住本包），
#  原来启用的单元改为启用 /usr/lib 下的同名单元；全新系统按 80-fuxi-desktop.preset。
#  不重启任何服务：正在跑的会话不受影响，下次启动才用 /usr/lib 下的单元。/usr/local/share/applications 里的
#  软件渲染启动器覆盖一并迁走（有 GPU 时 fuxi-desktop-app 本来就直接 exec 原程序）。
set -e
BK=/var/backups/fuxi-desktop-migrate
UNITS="denial plasmamobile fuxi-autorotate"

[ "$1" = configure ] || exit 0

if [ -z "$2" ]; then
	enabled=""
	migrated=0
	for u in $UNITS; do
		if [ -f "/etc/systemd/system/$u.service" ] && ls /etc/systemd/system/*.wants/"$u.service" >/dev/null 2>&1; then
			enabled="$enabled $u"
		fi
	done
	while read -r h p; do
		case "$h" in ''|\#*) continue ;; esac
		case "$p" in /etc/xdg/*) continue ;; esac  # preinst 处理
		[ -f "$p" ] || continue
		if [ "$(sha256sum < "$p" | cut -d' ' -f1)" = "$h" ]; then
			mkdir -p "$BK$(dirname "$p")"
			mv "$p" "$BK$p"
			migrated=$((migrated + 1))
		else
			echo "fuxi-desktop: 警告：$p 与已知旧版不同（本地改过），保留；它会遮住本包的同名文件" >&2
		fi
	done <<'MIGRATE'
@MIGRATE_LIST@
MIGRATE
	[ "$migrated" -gt 0 ] && echo "fuxi-desktop: 迁走 $migrated 个旧手工文件 → $BK"
	[ -d /run/systemd/system ] && { systemctl daemon-reload || true; }
	if [ "$migrated" -gt 0 ] || [ -n "$enabled" ]; then
		for u in $enabled; do
			for l in /etc/systemd/system/*.wants/"$u.service"; do
				[ -L "$l" ] && [ ! -e "$l" ] && rm -f "$l"
			done
			systemctl enable "$u.service" >/dev/null 2>&1 || echo "fuxi-desktop: 警告：启用 $u 失败" >&2
		done
	else
		for u in $UNITS; do systemctl preset "$u.service" >/dev/null 2>&1 || true; done
	fi
fi

[ -d /run/systemd/system ] && { systemctl daemon-reload || true; }
exit 0
