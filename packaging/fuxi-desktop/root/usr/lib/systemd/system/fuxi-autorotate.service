[Unit]
Description=Fuxi auto-rotate bridge for Plasma Mobile
# kwin_wayland 未链接 QtSensors，靠这个服务把 SensorProxy 的方向转成 kscreen-doctor
After=plasmamobile.service iio-sensor-proxy.service
BindsTo=plasmamobile.service

[Service]
User=1000
NoNewPrivileges=yes
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
Environment=QT_QPA_PLATFORM=wayland
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/fuxi-autorotate
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
