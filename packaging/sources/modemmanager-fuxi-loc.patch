diff --git a/libmm-glib/tests/test-fuxi-loc.c b/libmm-glib/tests/test-fuxi-loc.c
new file mode 100644
index 0000000..e7b3e6e
--- /dev/null
+++ b/libmm-glib/tests/test-fuxi-loc.c
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <math.h>
+#include "mm-location-gps-raw.h"
+
+#define RADIUS "x-fuxi-horizontal-radius-m"
+
+static MMLocationGpsRaw *
+new_fix (GVariant *radius)
+{
+    GVariantBuilder builder;
+    g_autoptr(GVariant) dictionary = NULL;
+    g_autoptr(GError) error = NULL;
+    MMLocationGpsRaw *fix;
+
+    g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{sv}"));
+    g_variant_builder_add (&builder, "{sv}", "utc-time", g_variant_new_string ("120000.000"));
+    g_variant_builder_add (&builder, "{sv}", "latitude", g_variant_new_double (0));
+    g_variant_builder_add (&builder, "{sv}", "longitude", g_variant_new_double (0));
+    if (radius)
+        g_variant_builder_add (&builder, "{sv}", RADIUS, radius);
+    dictionary = g_variant_ref_sink (g_variant_builder_end (&builder));
+    fix = mm_location_gps_raw_new_from_dictionary (dictionary, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (fix);
+    return fix;
+}
+
+static void
+assert_radius (MMLocationGpsRaw *fix, gboolean present)
+{
+    g_autoptr(GVariant) dictionary = mm_location_gps_raw_get_dictionary (fix);
+    g_autoptr(GVariant) radius = NULL;
+
+    g_assert_nonnull (dictionary);
+    radius = g_variant_lookup_value (dictionary, RADIUS, NULL);
+    if (present) {
+        g_assert_nonnull (radius);
+        g_assert_true (g_variant_is_of_type (radius, G_VARIANT_TYPE_DOUBLE));
+        g_assert_cmpfloat (g_variant_get_double (radius), ==, 7.25);
+    } else
+        g_assert_null (radius);
+}
+
+static void
+test_roundtrip (void)
+{
+    g_autoptr(MMLocationGpsRaw) fix = new_fix (g_variant_new_double (7.25));
+    g_autoptr(MMLocationGpsRaw) copy = NULL;
+    g_autoptr(GVariant) dictionary = mm_location_gps_raw_get_dictionary (fix);
+    g_autoptr(GError) error = NULL;
+
+    assert_radius (fix, TRUE);
+    copy = mm_location_gps_raw_new_from_dictionary (dictionary, &error);
+    g_assert_no_error (error);
+    assert_radius (copy, TRUE);
+    g_assert_cmpstr (mm_location_gps_raw_get_utc_time (copy), ==, "120000.000");
+    g_assert_cmpfloat (mm_location_gps_raw_get_latitude (copy), ==, 0);
+    g_assert_cmpfloat (mm_location_gps_raw_get_longitude (copy), ==, 0);
+
+    /* Each LOC report replaces the object, including a report without radius. */
+    g_clear_object (&copy);
+    copy = new_fix (NULL);
+    assert_radius (copy, FALSE);
+
+    /* NMEA updates the existing object instead. Use a synthetic zero-coordinate fix. */
+    g_assert_true (mm_location_gps_raw_add_trace (fix,
+        "$GPGGA,120001.00,0000.000,N,00000.000,E,1,08,1.0,0.0,M,0.0,M,,*57"));
+    g_assert_cmpstr (mm_location_gps_raw_get_utc_time (fix), ==, "120001.00");
+    assert_radius (fix, FALSE);
+}
+
+static void
+test_invalid_radius (void)
+{
+    const gdouble invalid[] = { NAN, INFINITY, -INFINITY, -1, 0 };
+    g_autoptr(MMLocationGpsRaw) wrong_type = new_fix (g_variant_new_string ("7.25"));
+    guint i;
+
+    assert_radius (wrong_type, FALSE);
+    for (i = 0; i < G_N_ELEMENTS (invalid); i++) {
+        g_autoptr(MMLocationGpsRaw) fix = new_fix (g_variant_new_double (invalid[i]));
+        assert_radius (fix, FALSE);
+    }
+}
+
+int
+main (int argc, char **argv)
+{
+    g_test_init (&argc, &argv, NULL);
+    g_test_add_func ("/fuxi/loc/roundtrip", test_roundtrip);
+    g_test_add_func ("/fuxi/loc/invalid-radius", test_invalid_radius);
+    return g_test_run ();
+}
diff --git a/src/mm-fuxi-loc.h b/src/mm-fuxi-loc.h
new file mode 100644
index 0000000..e8fce06
--- /dev/null
+++ b/src/mm-fuxi-loc.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef MM_FUXI_LOC_H
+#define MM_FUXI_LOC_H
+
+#include <math.h>
+#include <glib.h>
+
+#define MM_FUXI_LOC_IDENTITY_FILE "/etc/fuxi/mm-loc-identity"
+
+/* LOC UTC timestamps are milliseconds since the Unix epoch. No NMEA is
+ * synthesized. The optional local extension carries the measured radius in metres. */
+static GVariant *
+mm_fuxi_loc_raw_dictionary (guint64 timestamp,
+                           gdouble latitude,
+                           gdouble longitude,
+                           gdouble altitude,
+                           gdouble radius)
+{
+    g_autoptr(GDateTime) date = NULL;
+    g_autofree gchar *time = NULL;
+    g_autofree gchar *utc = NULL;
+    GVariantBuilder builder;
+
+    if (!timestamp || timestamp > G_GUINT64_CONSTANT (253402300799999) ||
+        !isfinite (latitude) || latitude < -90 || latitude > 90 ||
+        !isfinite (longitude) || longitude < -180 || longitude > 180)
+        return NULL;
+    date = g_date_time_new_from_unix_utc ((gint64) (timestamp / 1000));
+    if (!date)
+        return NULL;
+    time = g_date_time_format (date, "%H%M%S");
+    utc = g_strdup_printf ("%s.%03u", time, (guint) (timestamp % 1000));
+    g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{sv}"));
+    g_variant_builder_add (&builder, "{sv}", "utc-time", g_variant_new_string (utc));
+    g_variant_builder_add (&builder, "{sv}", "latitude", g_variant_new_double (latitude));
+    g_variant_builder_add (&builder, "{sv}", "longitude", g_variant_new_double (longitude));
+    if (isfinite (altitude))
+        g_variant_builder_add (&builder, "{sv}", "altitude", g_variant_new_double (altitude));
+    if (isfinite (radius) && radius > 0)
+        g_variant_builder_add (&builder, "{sv}", "x-fuxi-horizontal-radius-m", g_variant_new_double (radius));
+    return g_variant_ref_sink (g_variant_builder_end (&builder));
+}
+
+#endif
