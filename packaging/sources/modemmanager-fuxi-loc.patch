+void
+mm_iface_modem_location_gps_raw_update (MMIfaceModemLocation *self,
+                                       GVariant *dictionary)
+{
+    MmGdbusModemLocation *skeleton = NULL;
+    g_autoptr(MMLocationGpsRaw) location = NULL;
+    LocationContext *ctx;
+
+    g_object_get (self, MM_IFACE_MODEM_LOCATION_DBUS_SKELETON, &skeleton, NULL);
+    if (!skeleton)
+        return;
+    if (!(mm_gdbus_modem_location_get_enabled (skeleton) & MM_MODEM_LOCATION_SOURCE_GPS_RAW))
+        goto out;
+    location = mm_location_gps_raw_new_from_dictionary (dictionary, NULL);
+    if (!location)
+        goto out;
+    ctx = get_location_context (self);
+    g_set_object (&ctx->location_gps_raw, location);
+    if (ctx->location_gps_raw_last_time == 0 ||
+        time (NULL) - ctx->location_gps_raw_last_time >= (glong) mm_gdbus_modem_location_get_gps_refresh_rate (skeleton)) {
+        ctx->location_gps_raw_last_time = time (NULL);
+        notify_gps_location_update (self, skeleton, NULL, location);
+    }
+out:
+    g_object_unref (skeleton);
+}
