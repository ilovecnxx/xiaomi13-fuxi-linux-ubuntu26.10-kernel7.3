+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef MM_FUXI_LOC_H
+#define MM_FUXI_LOC_H
+
+#include <math.h>
+#include <glib.h>
+
+#define MM_FUXI_LOC_IDENTITY_FILE "/etc/fuxi/mm-loc-identity"
+
+/* LOC UTC timestamps are milliseconds since the Unix epoch. No NMEA is
+ * synthesized: GPS_RAW has no satellite-count or accuracy fields. */
+static GVariant *
+mm_fuxi_loc_raw_dictionary (guint64 timestamp,
+                           gdouble latitude,
+                           gdouble longitude,
+                           gdouble altitude)
+{
+    g_autoptr(GDateTime) date = NULL;
+    g_autofree gchar *time = NULL;
+    g_autofree gchar *utc = NULL;
+    GVariantBuilder builder;
+
+    if (!timestamp || timestamp > G_GUINT64_CONSTANT (253402300799999) ||
+        !isfinite (latitude) || latitude < -90 || latitude > 90 ||
+        !isfinite (longitude) || longitude < -180 || longitude > 180)
+        return NULL;
+    date = g_date_time_new_from_unix_utc ((gint64) (timestamp / 1000));
+    if (!date)
+        return NULL;
+    time = g_date_time_format (date, "%H%M%S");
+    utc = g_strdup_printf ("%s.%03u", time, (guint) (timestamp % 1000));
+    g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{sv}"));
+    g_variant_builder_add (&builder, "{sv}", "utc-time", g_variant_new_string (utc));
+    g_variant_builder_add (&builder, "{sv}", "latitude", g_variant_new_double (latitude));
+    g_variant_builder_add (&builder, "{sv}", "longitude", g_variant_new_double (longitude));
+    if (isfinite (altitude))
+        g_variant_builder_add (&builder, "{sv}", "altitude", g_variant_new_double (altitude));
+    return g_variant_ref_sink (g_variant_builder_end (&builder));
+}
+
+#endif
