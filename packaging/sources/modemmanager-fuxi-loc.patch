+static void
+fuxi_loc_failed_start_stop_ready (QmiClientLoc *client,
+                                  GAsyncResult *res,
+                                  GTask *task)
+{
+    g_autoptr(QmiMessageLocStopOutput) output = NULL;
+    g_autoptr(GError) error = NULL;
+    GError *start_error = g_task_get_task_data (task);
+
+    output = qmi_client_loc_stop_finish (client, res, &error);
+    if (!output || !qmi_message_loc_stop_output_get_result (output, &error))
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "%s; cleanup Stop failed: %s", start_error->message, error->message);
+    else
+        g_task_return_error (task, g_error_copy (start_error));
+    g_object_unref (task);
+}
+
+static void
+fuxi_loc_start_ready (QmiClientLoc *client,
+                      GAsyncResult *res,
+                      GTask *task)
+{
+    g_autoptr(QmiMessageLocStartOutput) output = NULL;
+    g_autoptr(GError) error = NULL;
+    MMSharedQmi *self = g_task_get_source_object (task);
+    Private *priv = get_private (self);
+
+    output = qmi_client_loc_start_finish (client, res, &error);
+    if (!output || !qmi_message_loc_start_output_get_result (output, &error)) {
+        g_autoptr(QmiMessageLocStopInput) input = NULL;
+
+        /* A lost Start reply may still have started the engine. */
+        g_prefix_error (&error, "Couldn't start fuxi GPS engine: ");
+        g_task_set_task_data (task, g_steal_pointer (&error), (GDestroyNotify) g_error_free);
+        input = qmi_message_loc_stop_input_new ();
+        qmi_message_loc_stop_input_set_session_id (input, DEFAULT_LOC_SESSION_ID, NULL);
+        qmi_client_loc_stop (client, input, 10, NULL,
+                             (GAsyncReadyCallback) fuxi_loc_failed_start_stop_ready, task);
+        return;
+    }
+    g_assert (!priv->loc_client);
+    g_assert (!priv->loc_position_indication_id);
+    priv->loc_client = QMI_CLIENT (g_object_ref (client));
+    priv->loc_position_indication_id = g_signal_connect (client, "position-report",
+                                                        G_CALLBACK (loc_position_indication_cb), self);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+fuxi_loc_register_ready (QmiDevice *device,
+                         GAsyncResult *res,
+                         GTask *task)
+{
+    g_autoptr(QmiMessage) response = NULL;
+    g_autoptr(GError) error = NULL;
+    g_autoptr(QmiMessageLocStartInput) input = NULL;
+    QmiClient *client;
+    const guint8 *result;
+    guint16 length = 0;
+
+    response = qmi_device_command_full_finish (device, res, &error);
+    if (!response)
+        goto failed;
+    result = qmi_message_get_raw_tlv (response, 0x02, &length);
+    if (!result || length != 4) {
+        g_set_error_literal (&error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Missing LOC registration result");
+        goto failed;
+    }
+    if (result[0] || result[1]) {
+        g_set_error (&error, QMI_PROTOCOL_ERROR, result[2] | ((guint16) result[3] << 8),
+                      "LOC identity registration rejected (QMI %u)", result[2] | ((guint16) result[3] << 8));
+        goto failed;
+    }
+    client = mm_shared_qmi_peek_client (g_task_get_source_object (task), QMI_SERVICE_LOC,
+                                        MM_PORT_QMI_FLAG_DEFAULT, &error);
+    if (!client)
+        goto failed;
+    input = qmi_message_loc_start_input_new ();
+    qmi_message_loc_start_input_set_session_id (input, DEFAULT_LOC_SESSION_ID, NULL);
+    qmi_message_loc_start_input_set_intermediate_report_state (input, QMI_LOC_INTERMEDIATE_REPORT_STATE_DISABLE, NULL);
+    qmi_message_loc_start_input_set_minimum_interval_between_position_reports (input, 1000, NULL);
+    qmi_message_loc_start_input_set_fix_recurrence_type (input, QMI_LOC_FIX_RECURRENCE_TYPE_REQUEST_PERIODIC_FIXES, NULL);
+    qmi_client_loc_start (QMI_CLIENT_LOC (client), input, 10, NULL,
+                          (GAsyncReadyCallback) fuxi_loc_start_ready, task);
+    return;
+
+failed:
+    g_task_return_error (task, g_steal_pointer (&error));
+    g_object_unref (task);
+}
+
+static void
+fuxi_loc_register (QmiClient *client,
+                   GTask *task)
+{
+    g_autoptr(QmiMessage) message = NULL;
+    gsize tlv;
+    const guint8 application[] = {'M', 'H', 'A', 'L'};
+    const guint8 provider[] = {1, 0, 0, 0};
+    const guint8 system_client[] = {0};
+
+    /* libqmi 1.38 has no typed API for the LOC client identity fields. */
+    message = qmi_message_new (QMI_SERVICE_LOC, qmi_client_get_cid (client),
+                               qmi_client_get_next_transaction_id (client), 0x21);
+    tlv = qmi_message_tlv_write_init (message, 0x01, NULL);
+    qmi_message_tlv_write_guint64 (message, QMI_ENDIAN_LITTLE,
+                                  QMI_LOC_EVENT_REGISTRATION_FLAG_POSITION_REPORT, NULL);
+    qmi_message_tlv_write_complete (message, tlv, NULL);
+    qmi_message_add_raw_tlv (message, 0x10, application, sizeof (application), NULL);
+    qmi_message_add_raw_tlv (message, 0x11, provider, sizeof (provider), NULL);
+    qmi_message_add_raw_tlv (message, 0x12, system_client, sizeof (system_client), NULL);
+    qmi_device_command_full (QMI_DEVICE (qmi_client_peek_device (client)), message, NULL, 10, NULL,
+                             (GAsyncReadyCallback) fuxi_loc_register_ready, task);
+}
