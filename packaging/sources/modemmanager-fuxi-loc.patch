+static void
+loc_position_indication_cb (QmiClientLoc *client,
+                            QmiIndicationLocPositionReportOutput *output,
+                            MMSharedQmi *self)
+{
+    QmiLocSessionStatus status;
+    QmiLocTechnologyUsed technology;
+    guint8 session;
+    guint64 timestamp;
+    gdouble latitude, longitude;
+    gfloat altitude = NAN;
+    g_autoptr(GVariant) dictionary = NULL;
+
+    if (!qmi_indication_loc_position_report_output_get_session_id (output, &session, NULL) ||
+        session != DEFAULT_LOC_SESSION_ID ||
+        !qmi_indication_loc_position_report_output_get_session_status (output, &status, NULL))
+        return;
+    mm_obj_dbg (self, "[LOC] position report: %s", qmi_loc_session_status_get_string (status));
+    if (status != QMI_LOC_SESSION_STATUS_SUCCESS ||
+        !qmi_indication_loc_position_report_output_get_technology_used (output, &technology, NULL) ||
+        !(technology & QMI_LOC_TECHNOLOGY_USED_SATELLITE) ||
+        !qmi_indication_loc_position_report_output_get_utc_timestamp (output, &timestamp, NULL) ||
+        !qmi_indication_loc_position_report_output_get_latitude (output, &latitude, NULL) ||
+        !qmi_indication_loc_position_report_output_get_longitude (output, &longitude, NULL))
+        return;
+    qmi_indication_loc_position_report_output_get_altitude_from_sealevel (output, &altitude, NULL);
+    dictionary = mm_fuxi_loc_raw_dictionary (timestamp, latitude, longitude, altitude);
+    if (dictionary)
+        mm_iface_modem_location_gps_raw_update (MM_IFACE_MODEM_LOCATION (self), dictionary);
+}
