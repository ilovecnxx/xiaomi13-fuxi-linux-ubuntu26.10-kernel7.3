 static void
+primary_subscription_checked (QmiClientWds *client, GAsyncResult *res, GTask *task)
+{
+    ConnectContext *ctx = g_task_get_task_data (task);
+    g_autoptr(QmiMessageWdsGetBindSubscriptionOutput) output = NULL;
+    QmiSubscriptionType subscription;
+    GError *error = NULL;
+
+    output = qmi_client_wds_get_bind_subscription_finish (client, res, &error);
+    if (!output || !qmi_message_wds_get_bind_subscription_output_get_result (output, &error) ||
+        !qmi_message_wds_get_bind_subscription_output_get_subscription_id (output, &subscription, &error)) {
+        g_prefix_error (&error, "Couldn't read bearer WDS subscription: ");
+        complete_connect (task, NULL, error);
+        return;
+    }
+    if (subscription != QMI_SUBSCRIPTION_TYPE_PRIMARY) {
+        complete_connect (task, NULL, g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                          "Expected primary bearer WDS subscription, got %u", subscription));
+        return;
+    }
+    mm_obj_info (ctx->self, "IPv%s WDS client %u verified primary (mux id %u)",
+                 ctx->running_ipv4 ? "4" : "6", qmi_client_get_cid (QMI_CLIENT (client)), ctx->mux_id);
+    ctx->step++;
+    connect_context_step (task);
+}
+
+static void
+primary_subscription_bound (QmiClientWds *client, GAsyncResult *res, GTask *task)
+{
+    g_autoptr(QmiMessageWdsBindSubscriptionOutput) output = NULL;
+    GError *error = NULL;
+
+    output = qmi_client_wds_bind_subscription_finish (client, res, &error);
+    if (!output || !qmi_message_wds_bind_subscription_output_get_result (output, &error)) {
+        g_prefix_error (&error, "Couldn't bind bearer WDS subscription: ");
+        complete_connect (task, NULL, error);
+        return;
+    }
+    qmi_client_wds_get_bind_subscription (client, NULL, 10, g_task_get_cancellable (task),
+                                          (GAsyncReadyCallback) primary_subscription_checked, task);
+}
+
+static gboolean
+bind_primary_subscription (QmiClientWds *client, GTask *task)
+{
+    g_autoptr(QmiMessageWdsBindSubscriptionInput) input = NULL;
+
+    if (!g_file_test (MM_PORT_QMI_SUB_BIND_FILE, G_FILE_TEST_EXISTS))
+        return FALSE;
+    input = qmi_message_wds_bind_subscription_input_new ();
+    qmi_message_wds_bind_subscription_input_set_subscription_id (input, QMI_SUBSCRIPTION_TYPE_PRIMARY, NULL);
+    qmi_client_wds_bind_subscription (client, input, 10, g_task_get_cancellable (task),
+                                      (GAsyncReadyCallback) primary_subscription_bound, task);
+    return TRUE;
+}
