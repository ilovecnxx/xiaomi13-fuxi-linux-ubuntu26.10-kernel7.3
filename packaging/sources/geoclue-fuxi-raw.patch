+static void
+on_location_changed_get_gps_raw (GObject *modem_object,
+                                 GClueModemManager *manager)
+{
+        GClueModemManagerPrivate *priv = manager->priv;
+        g_autoptr(GVariant) locations = NULL;
+        g_autoptr(GVariant) dictionary = NULL;
+        g_autoptr(GClueLocation) location = NULL;
+        GVariantIter iter;
+        guint source;
+
+        if (priv->raw_setup_pending || priv->raw_stop_requested ||
+            !(mm_modem_location_get_enabled (MM_MODEM_LOCATION (modem_object)) &
+              MM_MODEM_LOCATION_SOURCE_GPS_RAW))
+                return;
+        /* Read the actual D-Bus dictionary; system libmm-glib drops vendor keys. */
+        locations = g_dbus_proxy_get_cached_property (G_DBUS_PROXY (modem_object), "Location");
+        if (!locations || !g_variant_is_of_type (locations, G_VARIANT_TYPE ("a{uv}")))
+                return;
+        g_variant_iter_init (&iter, locations);
+        while (g_variant_iter_next (&iter, "{uv}", &source, &dictionary)) {
+                if (source == MM_MODEM_LOCATION_SOURCE_GPS_RAW)
+                        break;
+                g_clear_pointer (&dictionary, g_variant_unref);
+        }
+        location = gclue_fuxi_raw_location (dictionary, g_get_real_time () / 1000,
+                                          priv->raw_started_ms, priv->raw_last_ms,
+                                          &priv->raw_last_ms);
+        if (location)
+                g_signal_emit (manager, signals[FIX_GPS_RAW], 0, location);
+}
