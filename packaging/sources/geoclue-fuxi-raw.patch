+static void
+on_location_state_ready (GObject *object, GAsyncResult *result, gpointer user_data)
+{
+        GTask *task = user_data;
+        GClueModemManager *manager = g_task_get_source_object (task);
+        GClueModemManagerPrivate *priv = manager->priv;
+        g_autoptr(GVariant) reply = NULL;
+        GError *error = NULL;
+        MMModemLocationSource enabled;
+        gboolean signals_enabled;
+        MMModemLocationSource requested = GPOINTER_TO_UINT (g_task_get_task_data (task));
+        MMModemLocationSource newly_managed;
+
+        reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (object), result, &error);
+        if (priv->modem_location != MM_MODEM_LOCATION (object)) {
+                g_clear_error (&error);
+                g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "Modem disconnected");
+                g_object_unref (task);
+                return;
+        }
+        if (!location_state_from_reply (reply, &enabled, &signals_enabled, &error)) {
+                priv->setup_task = NULL;
+                priv->caps &= ~requested;
+                if (requested == MM_MODEM_LOCATION_SOURCE_GPS_RAW) {
+                        priv->raw_setup_pending = FALSE;
+                        priv->raw_started_ms = 0;
+                        priv->raw_stop_requested = FALSE;
+                }
+                g_task_return_error (task, error);
+                if (priv->clear_pending) {
+                        g_autoptr(GError) restore_error = NULL;
+
+                        if (!restore_caps (manager, NULL, &restore_error))
+                                g_warning ("Failed to restore modem location configuration: %s", restore_error->message);
+                }
+                if (requested == MM_MODEM_LOCATION_SOURCE_GPS_RAW)
+                        restart_raw_if_requested (manager);
+                start_next_setup (manager);
+                g_object_unref (task);
+                return;
+        }
+        if (!priv->baseline_valid) {
+                priv->original_signals = signals_enabled;
+                priv->baseline_valid = TRUE;
+        }
+        newly_managed = requested & ~priv->managed_caps;
+        priv->original_enabled |= enabled & newly_managed;
+        priv->managed_caps |= newly_managed;
+        /* Only one internal Setup may run; notifications need not have caught up. */
+        mm_modem_location_setup (priv->modem_location,
+                                 enabled | priv->caps | requested,
+                                 TRUE, NULL, on_modem_location_setup, task);
+}
+
+static void
+start_next_setup (GClueModemManager *manager)
+{
+        GClueModemManagerPrivate *priv = manager->priv;
+        GTask *task;
+
+        if (priv->setup_task || !priv->modem_location)
+                return;
+        while ((task = g_queue_pop_head (&priv->setup_queue))) {
+                gboolean stopped = g_object_get_data (G_OBJECT (task), "stopped") != NULL ||
+                        (g_task_get_cancellable (task) &&
+                         g_cancellable_is_cancelled (g_task_get_cancellable (task)));
+
+                if (!stopped && !priv->clear_pending)
+                        break;
+                if (GPOINTER_TO_UINT (g_task_get_task_data (task)) == MM_MODEM_LOCATION_SOURCE_GPS_RAW) {
+                        priv->raw_setup_pending = FALSE;
+                        priv->raw_started_ms = 0;
+                        priv->raw_last_ms = 0;
+                        priv->raw_stop_requested = FALSE;
+                }
+                g_task_return_new_error (task, G_IO_ERROR,
+                                         stopped ? G_IO_ERROR_CANCELLED : G_IO_ERROR_FAILED,
+                                         stopped ? "Location source stopped" : "Previous configuration was not restored");
+                g_object_unref (task);
+                restart_raw_if_requested (manager);
+                if (priv->setup_task)
