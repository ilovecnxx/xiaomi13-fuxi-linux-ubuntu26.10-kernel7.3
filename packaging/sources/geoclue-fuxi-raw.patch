+                        GTask *task = g_task_new (manager, cancellable, callback, user_data);
+
+                        if (manager->priv->raw_stop_requested) {
+                                cancel_raw_restart (manager);
+                                manager->priv->raw_restart = task;
+                                return;
+                        }
+                        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_PENDING, "GPS RAW setup pending");
+                        g_object_unref (task);
+                        return;
+                }
+                if (manager->priv->raw_started_ms) {
+                        GTask *task = g_task_new (manager, cancellable, callback, user_data);
+
+                        if (manager->priv->raw_stop_requested)
+                                g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                                                         "Previous GPS RAW configuration was not restored");
+                        else
+                                g_task_return_boolean (task, TRUE);
+                        g_object_unref (task);
+                        return;
+                }
+                manager->priv->raw_started_ms = g_get_real_time () / 1000;
+                manager->priv->raw_last_ms = 0;
+                manager->priv->raw_setup_pending = TRUE;
+                manager->priv->raw_stop_requested = FALSE;
+        }
