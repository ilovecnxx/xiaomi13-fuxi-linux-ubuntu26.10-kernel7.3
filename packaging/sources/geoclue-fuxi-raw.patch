+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef GCLUE_FUXI_RAW_H
+#define GCLUE_FUXI_RAW_H
+
+#include <math.h>
+#include "gclue-location.h"
+
+/* The two extensions belong to the same LOC report as the coordinates. */
+static GClueLocation *
+gclue_fuxi_raw_location (GVariant *dictionary,
+                         guint64 now_ms,
+                         guint64 started_ms,
+                         guint64 last_ms,
+                         guint64 *accepted_ms)
+{
+        gdouble latitude, longitude, radius;
+        gdouble altitude = GCLUE_LOCATION_ALTITUDE_UNKNOWN;
+        guint64 timestamp;
+
+        if (!dictionary || !g_variant_is_of_type (dictionary, G_VARIANT_TYPE ("a{sv}")) ||
+            !g_variant_lookup (dictionary, "latitude", "d", &latitude) ||
+            !g_variant_lookup (dictionary, "longitude", "d", &longitude) ||
+            !g_variant_lookup (dictionary, "x-fuxi-horizontal-radius-m", "d", &radius) ||
+            !g_variant_lookup (dictionary, "x-fuxi-utc-ms", "t", &timestamp))
+                return NULL;
+        if (!isfinite (latitude) || latitude < -90 || latitude > 90 ||
+            !isfinite (longitude) || longitude < -180 || longitude > 180 ||
+            !isfinite (radius) || radius <= 0)
+                return NULL;
+
+        /* Reject cached fixes, replays, and clock errors without guessing a date. */
+        if (!started_ms || !timestamp || timestamp < started_ms || timestamp <= last_ms ||
+            (timestamp > now_ms && timestamp - now_ms > 5000) ||
+            (timestamp <= now_ms && now_ms - timestamp > 30000))
+                return NULL;
+        if (!g_variant_lookup (dictionary, "altitude", "d", &altitude) || !isfinite (altitude))
+                altitude = GCLUE_LOCATION_ALTITUDE_UNKNOWN;
+
+        *accepted_ms = timestamp;
+        return gclue_location_new_full (latitude, longitude, radius,
+                                       GCLUE_LOCATION_SPEED_UNKNOWN,
+                                       GCLUE_LOCATION_HEADING_UNKNOWN,
+                                       altitude, timestamp / 1000, "GPS RAW");
+}
+
+#endif
