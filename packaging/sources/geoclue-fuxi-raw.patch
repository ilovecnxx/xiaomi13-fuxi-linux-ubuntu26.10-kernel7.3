+static gboolean
+location_state_from_reply (GVariant *reply, MMModemLocationSource *enabled,
+                           gboolean *signals_enabled, GError **error)
+{
+        g_autoptr(GVariant) properties = NULL;
+        guint sources;
+
+        if (!reply)
+                return FALSE;
+        g_variant_get (reply, "(@a{sv})", &properties);
+        if (!g_variant_lookup (properties, "Enabled", "u", &sources) ||
+            !g_variant_lookup (properties, "SignalsLocation", "b", signals_enabled)) {
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                                     "Missing modem location configuration");
+                return FALSE;
+        }
+        *enabled = sources;
+        return TRUE;
+}
+
+static gboolean
+get_location_state_sync (GClueModemManager *manager, MMModemLocationSource *enabled,
+                         gboolean *signals_enabled, GCancellable *cancellable, GError **error)
+{
+        g_autoptr(GVariant) reply = g_dbus_proxy_call_sync (
+                G_DBUS_PROXY (manager->priv->modem_location),
+                "org.freedesktop.DBus.Properties.GetAll",
+                g_variant_new ("(s)", "org.freedesktop.ModemManager1.Modem.Location"),
+                G_DBUS_CALL_FLAGS_NONE, 5000, cancellable, error);
+
+        return location_state_from_reply (reply, enabled, signals_enabled, error);
+}
+
+static void start_next_setup (GClueModemManager *manager);
+static gboolean clear_caps (GClueModemManager *manager, MMModemLocationSource caps,
+                             GCancellable *cancellable, GError **error);
+
+static gboolean
+restore_caps (GClueModemManager *manager, GCancellable *cancellable, GError **error)
+{
+        GClueModemManagerPrivate *priv = manager->priv;
+        MMModemLocationSource enabled;
+        gboolean signals_enabled;
+
+        if (!priv->baseline_valid) {
+                priv->clear_pending = FALSE;
+                return TRUE;
+        }
+        priv->clear_pending = TRUE;
+        if (!get_location_state_sync (manager, &enabled, &signals_enabled, cancellable, error))
+                return FALSE;
+        enabled = (enabled & ~priv->managed_caps) | priv->original_enabled | priv->caps;
+        if (!mm_modem_location_setup_sync (priv->modem_location, enabled,
+                                            priv->caps ? TRUE : priv->original_signals,
+                                            cancellable, error))
+                return FALSE;
+        priv->managed_caps &= priv->caps;
+        priv->original_enabled &= priv->managed_caps;
+        priv->baseline_valid = priv->caps != 0;
+        priv->clear_pending = FALSE;
+        if (!(priv->caps & MM_MODEM_LOCATION_SOURCE_GPS_RAW) && !priv->raw_setup_pending) {
+                priv->raw_started_ms = 0;
+                priv->raw_last_ms = 0;
+                priv->raw_stop_requested = FALSE;
+        }
+        return TRUE;
+}
+
+static void
+on_raw_restarted (GObject *object, GAsyncResult *result, gpointer user_data)
+{
+        GTask *task = user_data;
+        GError *error = NULL;
+
+        if (gclue_modem_manager_enable_gps_finish (GCLUE_MODEM (object), result, &error))
+                g_task_return_boolean (task, TRUE);
+        else
+                g_task_return_error (task, error);
+        g_object_unref (task);
+}
+
+static void
+restart_raw_if_requested (GClueModemManager *manager)
+{
+        GTask *task = g_steal_pointer (&manager->priv->raw_restart);
+
+        if (!task)
+                return;
+        if (g_task_return_error_if_cancelled (task)) {
+                g_object_unref (task);
+                return;
+        }
+        if (manager->priv->raw_started_ms || manager->priv->clear_pending) {
+                g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                                         "Previous GPS RAW configuration was not restored");
+                g_object_unref (task);
+                return;
+        }
+        gclue_modem_manager_enable_gps (GCLUE_MODEM (manager), g_task_get_cancellable (task),
+                                        on_raw_restarted, task);
+}
+
+static void
+cancel_raw_restart (GClueModemManager *manager)
+{
+        GTask *task = g_steal_pointer (&manager->priv->raw_restart);
+
+        if (!task)
+                return;
+        g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_CANCELLED, "GPS RAW stopped");
+        g_object_unref (task);
 }
 
