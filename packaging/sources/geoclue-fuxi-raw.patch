+        priv->setup_task = task;
+        priv->caps |= GPOINTER_TO_UINT (g_task_get_task_data (task));
+        g_dbus_proxy_call (G_DBUS_PROXY (priv->modem_location),
+                          "org.freedesktop.DBus.Properties.GetAll",
+                          g_variant_new ("(s)", "org.freedesktop.ModemManager1.Modem.Location"),
