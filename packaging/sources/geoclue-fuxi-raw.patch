         g_clear_object (&manager->priv->location_nmea);
+        if (manager->priv->raw_started_ms) {
+                GClueModemManagerPrivate *priv = manager->priv;
+
+                priv->raw_stop_requested = TRUE;
+                if (priv->raw_setup_pending) {
+                        cancel_raw_restart (manager);
+                        return clear_caps (manager, MM_MODEM_LOCATION_SOURCE_GPS_RAW, cancellable, error);
+                }
+                if (!clear_caps (manager, MM_MODEM_LOCATION_SOURCE_GPS_RAW, cancellable, error))
+                        return FALSE;
+                priv->raw_started_ms = 0;
+                priv->raw_last_ms = 0;
+                priv->raw_stop_requested = FALSE;
+                return TRUE;
+        }
