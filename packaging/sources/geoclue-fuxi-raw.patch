diff --git a/src/test-fuxi-modem.c b/src/test-fuxi-modem.c
new file mode 100644
index 0000000..30d114e
--- /dev/null
+++ b/src/test-fuxi-modem.c
@@ -0,0 +1,650 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gclue-modem-manager.c"
+
+#define RAW MM_MODEM_LOCATION_SOURCE_GPS_RAW
+#define CELL MM_MODEM_LOCATION_SOURCE_3GPP_LAC_CI
+#define NMEA MM_MODEM_LOCATION_SOURCE_GPS_NMEA
+#define PATH "/org/freedesktop/ModemManager1/Modem/0"
+#define IFACE "org.freedesktop.ModemManager1.Modem.Location"
+
+typedef struct {
+        guint sources;
+        gboolean signals;
+} Setup;
+
+typedef struct {
+        GMainContext *context;
+        GMainLoop *loop;
+        GAsyncQueue *ready, *calls;
+        GDBusConnection *connection;
+        GClueModemManager *manager;
+        guint capabilities, enabled;
+        gboolean signals, fail_setup;
+        gboolean hold_setup;
+        gboolean delay_apply;
+        Setup delayed;
+        gint fail_reads;
+        gboolean fail_reads_after_release;
+        guint setup_count, reject_setup;
+        GDBusMethodInvocation *pending_setup;
+        GThread *thread;
+        gboolean done, success;
+        guint fixes;
+} Fixture;
+
+static const gchar *bus_address;
+static const gchar xml[] =
+        "<node><interface name='" IFACE "'>"
+        "<method name='Setup'><arg type='u' direction='in'/><arg type='b' direction='in'/></method>"
+        "<property name='Capabilities' type='u' access='read'/>"
+        "<property name='Enabled' type='u' access='read'/>"
+        "<property name='SignalsLocation' type='b' access='read'/>"
+        "<property name='Location' type='a{uv}' access='read'/>"
+        "</interface></node>";
+
+static GVariant *
+get_property (GDBusConnection *connection, const gchar *sender, const gchar *path,
+              const gchar *interface, const gchar *property, GError **error, gpointer data)
+{
+        Fixture *f = data;
+        if (g_str_equal (property, "Enabled") &&
+            g_atomic_int_compare_and_exchange (&f->fail_reads, 1, 0)) {
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Synthetic property failure");
+                return NULL;
+        }
+        if (g_str_equal (property, "Capabilities"))
+                return g_variant_new_uint32 (f->capabilities);
+        if (g_str_equal (property, "Enabled"))
+                return g_variant_new_uint32 (f->enabled);
+        if (g_str_equal (property, "SignalsLocation"))
+                return g_variant_new_boolean (f->signals);
+        return g_variant_new_array (G_VARIANT_TYPE ("{uv}"), NULL, 0);
+}
+
+static void
+emit_configuration (Fixture *f)
+{
+        GVariantBuilder changed;
+
+        g_variant_builder_init (&changed, G_VARIANT_TYPE_VARDICT);
+        g_variant_builder_add (&changed, "{sv}", "Enabled", g_variant_new_uint32 (f->enabled));
+        g_variant_builder_add (&changed, "{sv}", "SignalsLocation", g_variant_new_boolean (f->signals));
+        g_dbus_connection_emit_signal (f->connection, NULL, PATH,
+                                      "org.freedesktop.DBus.Properties", "PropertiesChanged",
+                                      g_variant_new ("(sa{sv}as)", IFACE, &changed, NULL), NULL);
+}
+
+static void
+method_call (GDBusConnection *connection, const gchar *sender, const gchar *path,
+             const gchar *interface, const gchar *method, GVariant *parameters,
+             GDBusMethodInvocation *invocation, gpointer data)
+{
+        Fixture *f = data;
+        Setup *call = g_new0 (Setup, 1);
+
+        g_assert_cmpstr (method, ==, "Setup");
+        g_assert_null (f->pending_setup);
+        g_variant_get (parameters, "(ub)", &call->sources, &call->signals);
+        if (++f->setup_count == f->reject_setup) {
+                g_async_queue_push (f->calls, call);
+                g_dbus_method_invocation_return_dbus_error (invocation,
+                        "org.freedesktop.ModemManager1.Error.Core.Failed", "Synthetic restore failure");
+                return;
+        }
+        if (f->hold_setup && f->delay_apply)
+                f->delayed = *call;
+        else {
+                f->enabled = call->sources;
+                f->signals = call->signals;
+        }
+        g_async_queue_push (f->calls, call);
+        emit_configuration (f);
+        if (f->hold_setup) {
+                f->hold_setup = FALSE;
+                f->pending_setup = g_object_ref (invocation);
+        } else if (f->fail_setup) {
+                f->fail_setup = FALSE;
+                /* A failure may follow a partial hardware state change. */
+                g_dbus_method_invocation_return_dbus_error (invocation,
+                        "org.freedesktop.ModemManager1.Error.Core.Failed", "Synthetic failure");
+        } else
+                g_dbus_method_invocation_return_value (invocation, NULL);
+}
+
+static gboolean
+release_setup (gpointer data)
+{
+        Fixture *f = data;
+        g_assert_nonnull (f->pending_setup);
+        if (f->delay_apply) {
+                f->enabled = f->delayed.sources;
+                f->signals = f->delayed.signals;
+                emit_configuration (f);
+        }
+        if (f->fail_reads_after_release)
+                g_atomic_int_set (&f->fail_reads, 1);
+        g_dbus_method_invocation_return_value (f->pending_setup, NULL);
+        g_clear_object (&f->pending_setup);
+        return G_SOURCE_REMOVE;
+}
+
+static gpointer
+serve (gpointer data)
+{
+        Fixture *f = data;
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (xml, &error);
+        const GDBusInterfaceVTable vtable = { .method_call = method_call, .get_property = get_property };
+        guint registration;
+
+        g_assert_no_error (error);
+        g_main_context_push_thread_default (f->context);
+        f->connection = g_dbus_connection_new_for_address_sync (bus_address,
+                G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+                NULL, NULL, &error);
+        g_assert_no_error (error);
+        registration = g_dbus_connection_register_object (f->connection, PATH,
+                info->interfaces[0], &vtable, f, NULL, &error);
+        g_assert_no_error (error);
+        g_async_queue_push (f->ready, f->connection);
+        g_main_loop_run (f->loop);
+        g_dbus_connection_unregister_object (f->connection, registration);
+        g_dbus_connection_close_sync (f->connection, NULL, &error);
+        g_assert_no_error (error);
+        g_object_unref (f->connection);
+        g_main_context_pop_thread_default (f->context);
+        return NULL;
+}
+
+static void
+constructed_for_test (GObject *object)
+{
+        GCLUE_MODEM_MANAGER (object)->priv->cancellable = g_cancellable_new ();
+}
+
+static void
+enabled_cb (GObject *object, GAsyncResult *result, gpointer data)
+{
+        Fixture *f = data;
+        g_autoptr(GError) error = NULL;
+        f->success = gclue_modem_enable_gps_finish (GCLUE_MODEM (object), result, &error);
+        f->done = TRUE;
+}
+
+static gboolean
+timeout_cb (gpointer data)
+{
+        g_error ("Timed out waiting for test D-Bus Setup");
+        return G_SOURCE_REMOVE;
+}
+
+static void
+fix_cb (GClueModem *modem, GClueLocation *location, gpointer data)
+{
+        Fixture *f = data;
+        g_assert_cmpfloat (gclue_location_get_accuracy (location), ==, 7.25);
+        f->fixes++;
+}
+
+static void
+dispatch_fix (Fixture *f, guint64 timestamp)
+{
+        GVariantBuilder dictionary, locations;
+        g_autoptr(GVariant) value = NULL;
+        g_variant_builder_init (&dictionary, G_VARIANT_TYPE_VARDICT);
+        g_variant_builder_add (&dictionary, "{sv}", "latitude", g_variant_new_double (0));
+        g_variant_builder_add (&dictionary, "{sv}", "longitude", g_variant_new_double (0));
+        g_variant_builder_add (&dictionary, "{sv}", "utc-time", g_variant_new_string ("120000.000"));
+        g_variant_builder_add (&dictionary, "{sv}", "x-fuxi-horizontal-radius-m", g_variant_new_double (7.25));
+        g_variant_builder_add (&dictionary, "{sv}", "x-fuxi-utc-ms", g_variant_new_uint64 (timestamp));
+        g_variant_builder_init (&locations, G_VARIANT_TYPE ("a{uv}"));
+        g_variant_builder_add (&locations, "{uv}", RAW, g_variant_builder_end (&dictionary));
+        value = g_variant_ref_sink (g_variant_builder_end (&locations));
+        g_dbus_proxy_set_cached_property (G_DBUS_PROXY (f->manager->priv->modem_location), "Location", value);
+        on_location_changed (G_OBJECT (f->manager->priv->modem_location), NULL, f->manager);
+}
+
+static void
+assert_setup (Fixture *f, guint sources, gboolean signals)
+{
+        Setup *call = g_async_queue_timeout_pop (f->calls, 5000000);
+        g_assert_nonnull (call);
+        g_assert_cmpuint (call->sources, ==, sources);
+        g_assert_cmpint (call->signals, ==, signals);
+        g_free (call);
+}
+
+static gboolean
+quit_server (gpointer data)
+{
+        g_main_loop_quit (data);
+        return G_SOURCE_REMOVE;
+}
+
+static void
+fixture_start (Fixture *f)
+{
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GDBusConnection) client = NULL;
+        GObjectClass *klass;
+        void (*constructed) (GObject *);
+
+        f->context = g_main_context_new ();
+        f->loop = g_main_loop_new (f->context, FALSE);
+        f->ready = g_async_queue_new ();
+        f->calls = g_async_queue_new_full (g_free);
+        f->thread = g_thread_new ("mock-mm", serve, f);
+        g_assert_nonnull (g_async_queue_timeout_pop (f->ready, 5000000));
+        client = g_dbus_connection_new_for_address_sync (bus_address,
+                G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+                NULL, NULL, &error);
+        g_assert_no_error (error);
+        klass = g_type_class_ref (GCLUE_TYPE_MODEM_MANAGER);
+        constructed = klass->constructed;
+        klass->constructed = constructed_for_test;
+        f->manager = g_object_new (GCLUE_TYPE_MODEM_MANAGER, NULL);
+        klass->constructed = constructed;
+        g_type_class_unref (klass);
+        f->manager->priv->mm_object = g_object_new (MM_TYPE_OBJECT, "g-object-path", PATH, NULL);
+        f->manager->priv->modem_location = g_initable_new (MM_TYPE_MODEM_LOCATION, NULL, &error,
+                "g-connection", client, "g-name", g_dbus_connection_get_unique_name (f->connection),
+                "g-object-path", PATH, "g-interface-name", IFACE, NULL);
+        g_assert_no_error (error);
+        g_signal_connect (f->manager, "fix-gps-raw", G_CALLBACK (fix_cb), f);
+}
+
+static void
+fixture_stop (Fixture *f)
+{
+        g_assert_cmpint (g_async_queue_length (f->calls), ==, 0);
+        g_object_unref (f->manager);
+        g_main_context_invoke (f->context, quit_server, f->loop);
+        g_thread_join (f->thread);
+        g_main_loop_unref (f->loop);
+        g_main_context_unref (f->context);
+        g_async_queue_unref (f->ready);
+        g_async_queue_unref (f->calls);
+}
+
+static void
+test_session (gconstpointer data)
+{
+        guint mode = GPOINTER_TO_UINT (data);
+        Fixture f = { .capabilities = RAW | CELL, .enabled = CELL };
+        Fixture restarted = { 0 };
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GCancellable) cancellable = g_cancellable_new ();
+        guint timeout;
+        guint64 timestamp;
+
+        if (mode == 1 || mode == 2 || mode == 11)
+                f.enabled |= RAW;
+        f.signals = mode == 1 || mode == 11;
+        f.fail_setup = mode == 4;
+        f.hold_setup = mode == 16 || mode == 17;
+        if (mode == 5)
+                f.capabilities |= NMEA;
+        if (mode == 9 || mode == 15 || mode == 18)
+                f.enabled = 0;
+        fixture_start (&f);
+        g_assert_true (gclue_modem_get_is_gps_available (GCLUE_MODEM (f.manager)));
+        timeout = g_timeout_add_seconds (5, timeout_cb, NULL);
+        if (mode == 18) {
+                enable_caps (f.manager, CELL, cancellable, enabled_cb, &f);
+                while (!f.done)
+                        g_main_context_iteration (NULL, TRUE);
+                g_assert_true (f.success);
+                assert_setup (&f, CELL, TRUE);
+                f.done = FALSE;
+        }
+        gclue_modem_enable_gps (GCLUE_MODEM (f.manager), cancellable, enabled_cb, &f);
+        if (mode == 16 || mode == 17) {
+                while (!g_async_queue_length (f.calls))
+                        g_main_context_iteration (NULL, TRUE);
+                g_assert_false (f.done);
+                if (mode == 16) {
+                        g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                        g_assert_no_error (error);
+                        gclue_modem_enable_gps (GCLUE_MODEM (f.manager), cancellable, enabled_cb, &restarted);
+                } else
+                        disconnect_modem_location (f.manager);
+                g_main_context_invoke (f.context, release_setup, &f);
+        }
+        if (mode == 3 || mode == 12 || mode == 13 || mode == 14) {
+                g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                g_assert_no_error (error);
+        }
+        if (mode == 12 || mode == 13 || mode == 14) {
+                gclue_modem_enable_gps (GCLUE_MODEM (f.manager), cancellable, enabled_cb, &restarted);
+                if (mode == 13)
+                        g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                if (mode == 14)
+                        g_cancellable_cancel (cancellable);
+        }
+        if (mode == 6)
+                g_cancellable_cancel (cancellable);
+        if (mode == 7)
+                disconnect_modem_location (f.manager);
+        while (!f.done)
+                g_main_context_iteration (NULL, TRUE);
+        g_source_remove (timeout);
+        if (mode != 7)
+                assert_setup (&f, (mode == 9 || mode == 15 ? 0 : CELL) | (mode == 5 ? NMEA : RAW), TRUE);
+        g_assert_cmpint (f.success, ==, mode != 3 && mode != 4 && mode != 6 && mode != 7 &&
+                         mode != 12 && mode != 13 && mode != 14 && mode != 16 && mode != 17);
+        if (f.success && mode != 5) {
+                timestamp = g_get_real_time () / 1000;
+                dispatch_fix (&f, timestamp - 86400000);
+                g_assert_cmpuint (f.fixes, ==, 0);
+                dispatch_fix (&f, timestamp);
+                dispatch_fix (&f, timestamp);
+                g_assert_cmpuint (f.fixes, ==, 1);
+                if (mode == 8) {
+                        g_assert_true (mm_modem_location_setup_sync (f.manager->priv->modem_location,
+                                CELL | RAW | MM_MODEM_LOCATION_SOURCE_CDMA_BS, TRUE, NULL, &error));
+                        g_assert_no_error (error);
+                        assert_setup (&f, CELL | RAW | MM_MODEM_LOCATION_SOURCE_CDMA_BS, TRUE);
+                }
+                if (mode == 9 || mode == 11 || mode == 15) {
+                        f.done = FALSE;
+                        timeout = g_timeout_add_seconds (5, timeout_cb, NULL);
+                        enable_caps (f.manager, CELL, cancellable, enabled_cb, &f);
+                        while (!f.done)
+                                g_main_context_iteration (NULL, TRUE);
+                        g_source_remove (timeout);
+                        g_assert_true (f.success);
+                        assert_setup (&f, CELL | RAW, TRUE);
+                }
+                if (mode == 15) {
+                        g_assert_true (clear_caps (f.manager, CELL, NULL, &error));
+                        g_assert_no_error (error);
+                        assert_setup (&f, RAW, TRUE);
+                }
+                g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                g_assert_no_error (error);
+                if (mode == 9 || mode == 18)
+                        g_assert_cmpuint (f.manager->priv->caps, ==, CELL);
+                else
+                        dispatch_fix (&f, timestamp + 1);
+                g_assert_cmpuint (f.fixes, ==, 1);
+        }
+        if (mode != 5 && mode != 7 && mode != 17) {
+                assert_setup (&f, (mode == 15 ? 0 : CELL) | ((mode == 1 || mode == 2 || mode == 11) ? RAW : 0) |
+                        (mode == 8 ? MM_MODEM_LOCATION_SOURCE_CDMA_BS : 0), mode == 1 || mode == 9 || mode == 11 || mode == 18);
+                if (mode != 12 && mode != 16)
+                        g_assert_cmpuint (f.manager->priv->raw_started_ms, ==, 0);
+                if (mode != 12 && mode != 16)
+                        g_assert_cmpuint (f.manager->priv->caps & RAW, ==, 0);
+        }
+        if (mode == 9 || mode == 18) {
+                g_assert_true (clear_caps (f.manager, CELL, NULL, &error));
+                g_assert_no_error (error);
+                assert_setup (&f, 0, FALSE);
+        }
+        if (mode == 12 || mode == 13 || mode == 14 || mode == 16) {
+                timeout = g_timeout_add_seconds (5, timeout_cb, NULL);
+                while (!restarted.done)
+                        g_main_context_iteration (NULL, TRUE);
+                g_source_remove (timeout);
+                g_assert_cmpint (restarted.success, ==, mode == 12 || mode == 16);
+                if (mode == 12 || mode == 16) {
+                        assert_setup (&f, CELL | RAW, TRUE);
+                        dispatch_fix (&f, g_get_real_time () / 1000);
+                        g_assert_cmpuint (f.fixes, ==, 1);
+                        g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                        g_assert_no_error (error);
+                        assert_setup (&f, CELL, FALSE);
+                }
+        }
+        if (mode == 10) {
+                f.done = FALSE;
+                timeout = g_timeout_add_seconds (5, timeout_cb, NULL);
+                gclue_modem_enable_gps (GCLUE_MODEM (f.manager), cancellable, enabled_cb, &f);
+                while (!f.done)
+                        g_main_context_iteration (NULL, TRUE);
+                g_source_remove (timeout);
+                g_assert_true (f.success);
+                assert_setup (&f, CELL | RAW, TRUE);
+                g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                g_assert_no_error (error);
+                assert_setup (&f, CELL, FALSE);
+        }
+        if (mode == 11) {
+                g_assert_true (clear_caps (f.manager, CELL, NULL, &error));
+                g_assert_no_error (error);
+                assert_setup (&f, CELL | RAW, TRUE);
+        }
+        fixture_stop (&f);
+}
+
+static void
+test_overlap (gconstpointer data)
+{
+        guint mode = GPOINTER_TO_UINT (data) & 0xff;
+        Fixture f = { .capabilities = RAW | CELL, .hold_setup = TRUE };
+        Fixture second = { 0 }, restarted = { 0 };
+        g_autoptr(GCancellable) cancellable = g_cancellable_new ();
+        g_autoptr(GError) error = NULL;
+        MMModemLocationSource enabled;
+        gboolean signals_enabled;
+        guint timeout;
+
+        f.delay_apply = (GPOINTER_TO_UINT (data) & 0x100) != 0;
+        fixture_start (&f);
+        timeout = g_timeout_add_seconds (5, timeout_cb, NULL);
+        if (mode == 0)
+                gclue_modem_enable_gps (GCLUE_MODEM (f.manager), NULL, enabled_cb, &f);
+        else
+                enable_caps (f.manager, CELL, NULL, enabled_cb, &f);
+        while (!g_async_queue_length (f.calls))
+                g_main_context_iteration (NULL, TRUE);
+        assert_setup (&f, mode == 0 ? RAW : CELL, TRUE);
+        if (mode == 0) {
+                enable_caps (f.manager, CELL, cancellable, enabled_cb, &second);
+                g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+        } else {
+                gclue_modem_enable_gps (GCLUE_MODEM (f.manager), cancellable, enabled_cb, &second);
+                g_assert_true (clear_caps (f.manager, CELL, NULL, &error));
+                if (mode == 2)
+                        g_cancellable_cancel (cancellable);
+                if (mode == 3)
+                        enable_caps (f.manager, CELL, NULL, enabled_cb, &restarted);
+                if (mode == 4)
+                        g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                if (mode == 5)
+                        disconnect_modem_location (f.manager);
+        }
+        g_assert_no_error (error);
+        g_main_context_invoke (f.context, release_setup, &f);
+        while (!f.done || !second.done || (mode == 3 && !restarted.done))
+                g_main_context_iteration (NULL, TRUE);
+        g_assert_false (f.success);
+        g_assert_cmpint (second.success, ==, mode < 2 || mode == 3);
+        if (mode == 5) {
+                g_source_remove (timeout);
+                fixture_stop (&f);
+                return;
+        }
+        assert_setup (&f, 0, FALSE);
+        if (mode < 2 || mode == 3) {
+                assert_setup (&f, mode == 0 ? CELL : RAW, TRUE);
+                if (mode == 3) {
+                        g_assert_true (restarted.success);
+                        assert_setup (&f, RAW | CELL, TRUE);
+                }
+                if (mode != 0) {
+                        dispatch_fix (&f, g_get_real_time () / 1000);
+                        g_assert_cmpuint (f.fixes, ==, 1);
+                        g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                        assert_setup (&f, mode == 3 ? CELL : 0, mode == 3);
+                }
+                if (mode == 0 || mode == 3) {
+                        g_assert_true (clear_caps (f.manager, CELL, NULL, &error));
+                        assert_setup (&f, 0, FALSE);
+                }
+        }
+        g_assert_no_error (error);
+        g_assert_true (get_location_state_sync (f.manager, &enabled, &signals_enabled, NULL, &error));
+        g_assert_no_error (error);
+        g_assert_cmpuint (enabled, ==, 0);
+        g_assert_false (signals_enabled);
+        g_assert_cmpuint (f.manager->priv->caps, ==, 0);
+        g_assert_cmpuint (f.manager->priv->raw_started_ms, ==, 0);
+        g_assert_null (f.manager->priv->setup_task);
+        g_assert_true (g_queue_is_empty (&f.manager->priv->setup_queue));
+        g_source_remove (timeout);
+        fixture_stop (&f);
+}
+
+static void
+test_failure (gconstpointer data)
+{
+        guint mode = GPOINTER_TO_UINT (data);
+        Fixture f = { .capabilities = RAW | CELL };
+        Fixture second = { 0 };
+        g_autoptr(GError) error = NULL;
+        MMModemLocationSource enabled;
+        gboolean signals_enabled;
+        guint timeout;
+
+        f.fail_setup = mode == 2;
+        f.hold_setup = mode == 3 || mode == 4 || mode == 6;
+        f.reject_setup = mode == 3 || mode == 5 || mode == 6 ? 2 : 0;
+        f.fail_reads_after_release = mode == 4;
+        fixture_start (&f);
+        timeout = g_timeout_add_seconds (5, timeout_cb, NULL);
+        if (mode == 0)
+                g_atomic_int_set (&f.fail_reads, 1);
+        if (mode == 2)
+                enable_caps (f.manager, CELL, NULL, enabled_cb, &f);
+        else
+                gclue_modem_enable_gps (GCLUE_MODEM (f.manager), NULL, enabled_cb, &f);
+        if (mode == 3 || mode == 4 || mode == 6) {
+                while (!g_async_queue_length (f.calls))
+                        g_main_context_iteration (NULL, TRUE);
+                assert_setup (&f, RAW, TRUE);
+                enable_caps (f.manager, CELL, NULL, enabled_cb, &second);
+                g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                g_test_expect_message (G_LOG_DOMAIN, G_LOG_LEVEL_WARNING, "*Failed to restore GPS RAW configuration*");
+                g_main_context_invoke (f.context, release_setup, &f);
+        }
+        while (!f.done || ((mode == 3 || mode == 4 || mode == 6) && !second.done))
+                g_main_context_iteration (NULL, TRUE);
+        g_assert_cmpint (f.success, ==, mode == 1 || mode == 5);
+        if (mode == 1) {
+                assert_setup (&f, RAW, TRUE);
+                g_atomic_int_set (&f.fail_reads, 1);
+                enable_caps (f.manager, CELL, NULL, enabled_cb, &second);
+                g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                while (!second.done)
+                        g_main_context_iteration (NULL, TRUE);
+                g_assert_false (second.success);
+                assert_setup (&f, 0, FALSE);
+        } else if (mode == 2) {
+                assert_setup (&f, CELL, TRUE);
+                assert_setup (&f, 0, FALSE);
+        } else if (mode >= 3) {
+                if (mode == 5) {
+                        assert_setup (&f, RAW, TRUE);
+                        g_assert_false (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                        g_assert_nonnull (error);
+                        g_clear_error (&error);
+                } else {
+                        g_test_assert_expected_messages ();
+                        g_assert_false (second.success);
+                }
+                if (mode != 4)
+                        assert_setup (&f, 0, FALSE);
+                g_assert_true (f.manager->priv->baseline_valid);
+                g_assert_true (f.manager->priv->clear_pending);
+                g_assert_true (get_location_state_sync (f.manager, &enabled, &signals_enabled, NULL, &error));
+                g_assert_no_error (error);
+                g_assert_cmpuint (enabled, ==, RAW);
+                g_assert_true (signals_enabled);
+                if (mode == 6)
+                        g_assert_true (clear_caps (f.manager, CELL, NULL, &error));
+                else
+                        g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+                assert_setup (&f, 0, FALSE);
+        }
+        g_assert_no_error (error);
+        g_assert_false (f.manager->priv->baseline_valid);
+        g_assert_false (f.manager->priv->clear_pending);
+        g_assert_cmpuint (f.manager->priv->caps, ==, 0);
+        g_assert_cmpuint (f.manager->priv->raw_started_ms, ==, 0);
+        g_assert_false (f.manager->priv->raw_setup_pending);
+        g_assert_null (f.manager->priv->setup_task);
+        g_assert_true (g_queue_is_empty (&f.manager->priv->setup_queue));
+        /* Recovery must allow a new complete session, with the original baseline. */
+        second.done = FALSE;
+        if (mode == 6)
+                gclue_modem_enable_gps (GCLUE_MODEM (f.manager), NULL, enabled_cb, &second);
+        else
+                enable_caps (f.manager, CELL, NULL, enabled_cb, &second);
+        while (!second.done)
+                g_main_context_iteration (NULL, TRUE);
+        g_assert_true (second.success);
+        assert_setup (&f, mode == 6 ? RAW : CELL, TRUE);
+        if (mode == 6) {
+                dispatch_fix (&f, g_get_real_time () / 1000);
+                g_assert_cmpuint (f.fixes, ==, 1);
+                g_assert_true (gclue_modem_disable_gps (GCLUE_MODEM (f.manager), NULL, &error));
+        } else
+                g_assert_true (clear_caps (f.manager, CELL, NULL, &error));
+        g_assert_no_error (error);
+        assert_setup (&f, 0, FALSE);
+        g_assert_true (get_location_state_sync (f.manager, &enabled, &signals_enabled, NULL, &error));
+        g_assert_no_error (error);
+        g_assert_cmpuint (enabled, ==, 0);
+        g_assert_false (signals_enabled);
+        g_source_remove (timeout);
+        fixture_stop (&f);
+}
+
+int
+main (int argc, char **argv)
+{
+        g_autoptr(GTestDBus) bus = NULL;
+        gint result;
+        g_test_init (&argc, &argv, NULL);
+        bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+        g_test_dbus_up (bus);
+        bus_address = g_test_dbus_get_bus_address (bus);
+        g_test_add_data_func ("/fuxi/modem/session", GUINT_TO_POINTER (0), test_session);
+        g_test_add_data_func ("/fuxi/modem/restore-raw-signals", GUINT_TO_POINTER (1), test_session);
+        g_test_add_data_func ("/fuxi/modem/restore-raw-no-signals", GUINT_TO_POINTER (2), test_session);
+        g_test_add_data_func ("/fuxi/modem/stop-during-setup", GUINT_TO_POINTER (3), test_session);
+        g_test_add_data_func ("/fuxi/modem/setup-failure", GUINT_TO_POINTER (4), test_session);
+        g_test_add_data_func ("/fuxi/modem/prefer-nmea", GUINT_TO_POINTER (5), test_session);
+        g_test_add_data_func ("/fuxi/modem/cancel-setup", GUINT_TO_POINTER (6), test_session);
+        g_test_add_data_func ("/fuxi/modem/disconnect-during-setup", GUINT_TO_POINTER (7), test_session);
+        g_test_add_data_func ("/fuxi/modem/preserve-other-source", GUINT_TO_POINTER (8), test_session);
+        g_test_add_data_func ("/fuxi/modem/keep-other-consumer-signals", GUINT_TO_POINTER (9), test_session);
+        g_test_add_data_func ("/fuxi/modem/immediate-restart", GUINT_TO_POINTER (10), test_session);
+        g_test_add_data_func ("/fuxi/modem/other-stop-preserves-raw", GUINT_TO_POINTER (11), test_session);
+        g_test_add_data_func ("/fuxi/modem/restart-during-setup", GUINT_TO_POINTER (12), test_session);
+        g_test_add_data_func ("/fuxi/modem/stop-queued-restart", GUINT_TO_POINTER (13), test_session);
+        g_test_add_data_func ("/fuxi/modem/cancel-queued-restart", GUINT_TO_POINTER (14), test_session);
+        g_test_add_data_func ("/fuxi/modem/other-consumer-stops-first", GUINT_TO_POINTER (15), test_session);
+        g_test_add_data_func ("/fuxi/modem/restart-during-held-setup", GUINT_TO_POINTER (16), test_session);
+        g_test_add_data_func ("/fuxi/modem/disconnect-during-held-setup", GUINT_TO_POINTER (17), test_session);
+        g_test_add_data_func ("/fuxi/modem/cell-starts-first", GUINT_TO_POINTER (18), test_session);
+        g_test_add_data_func ("/fuxi/overlap/raw-to-cell", GUINT_TO_POINTER (0), test_overlap);
+        g_test_add_data_func ("/fuxi/overlap/cell-to-raw", GUINT_TO_POINTER (1), test_overlap);
+        g_test_add_data_func ("/fuxi/overlap/cancel-queued-raw", GUINT_TO_POINTER (2), test_overlap);
+        g_test_add_data_func ("/fuxi/overlap/cell-restart", GUINT_TO_POINTER (3), test_overlap);
+        g_test_add_data_func ("/fuxi/overlap/stop-queued-raw", GUINT_TO_POINTER (4), test_overlap);
+        g_test_add_data_func ("/fuxi/overlap/disconnect-with-queue", GUINT_TO_POINTER (5), test_overlap);
+        g_test_add_data_func ("/fuxi/overlap/raw-to-cell-delayed-state", GUINT_TO_POINTER (0x100), test_overlap);
+        g_test_add_data_func ("/fuxi/overlap/cell-to-raw-delayed-state", GUINT_TO_POINTER (0x101), test_overlap);
+        g_test_add_data_func ("/fuxi/failure/initial-read", GUINT_TO_POINTER (0), test_failure);
+        g_test_add_data_func ("/fuxi/failure/read-with-deferred-stop", GUINT_TO_POINTER (1), test_failure);
+        g_test_add_data_func ("/fuxi/failure/partial-cell-setup", GUINT_TO_POINTER (2), test_failure);
+        g_test_add_data_func ("/fuxi/failure/deferred-restore-setup", GUINT_TO_POINTER (3), test_failure);
+        g_test_add_data_func ("/fuxi/failure/deferred-restore-read", GUINT_TO_POINTER (4), test_failure);
+        g_test_add_data_func ("/fuxi/failure/synchronous-restore", GUINT_TO_POINTER (5), test_failure);
+        g_test_add_data_func ("/fuxi/failure/restore-through-other-source", GUINT_TO_POINTER (6), test_failure);
+        result = g_test_run ();
+        g_test_dbus_down (bus);
+        return result;
+}
diff --git a/src/test-fuxi-raw.c b/src/test-fuxi-raw.c
new file mode 100644
index 0000000..fee0668
--- /dev/null
+++ b/src/test-fuxi-raw.c
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "gclue-fuxi-raw.h"
+
+#define NOW G_GUINT64_CONSTANT (1800000000123)
+
+static GVariant *
+fix_dictionary (const gchar *omit, GVariant *replacement)
+{
+        GVariantBuilder builder;
+        const gchar *keys[] = { "latitude", "longitude", "x-fuxi-horizontal-radius-m", "x-fuxi-utc-ms", "altitude" };
+        GVariant *values[] = { g_variant_new_double (0), g_variant_new_double (0),
+                               g_variant_new_double (7.25), g_variant_new_uint64 (NOW),
+                               g_variant_new_double (12.5) };
+
+        g_variant_builder_init (&builder, G_VARIANT_TYPE ("a{sv}"));
+        for (guint i = 0; i < G_N_ELEMENTS (keys); i++) {
+                if (g_strcmp0 (keys[i], omit) == 0) {
+                        g_variant_unref (g_variant_ref_sink (values[i]));
+                        if (replacement)
+                                g_variant_builder_add (&builder, "{sv}", keys[i], replacement);
+                } else
+                        g_variant_builder_add (&builder, "{sv}", keys[i], values[i]);
+        }
+        return g_variant_ref_sink (g_variant_builder_end (&builder));
+}
+
+static void
+test_valid (void)
+{
+        g_autoptr(GVariant) dictionary = fix_dictionary (NULL, NULL);
+        guint64 accepted = 0;
+        g_autoptr(GClueLocation) location = gclue_fuxi_raw_location (dictionary, NOW, NOW - 1000, 0, &accepted);
+
+        g_assert_nonnull (location);
+        g_assert_cmpuint (accepted, ==, NOW);
+        g_assert_cmpuint (gclue_location_get_timestamp (location), ==, NOW / 1000);
+        g_assert_cmpfloat (gclue_location_get_latitude (location), ==, 0);
+        g_assert_cmpfloat (gclue_location_get_longitude (location), ==, 0);
+        g_assert_cmpfloat (gclue_location_get_accuracy (location), ==, 7.25);
+        g_assert_cmpfloat (gclue_location_get_altitude (location), ==, 12.5);
+        g_assert_cmpfloat (gclue_location_get_speed (location), ==, GCLUE_LOCATION_SPEED_UNKNOWN);
+        g_assert_cmpfloat (gclue_location_get_heading (location), ==, GCLUE_LOCATION_HEADING_UNKNOWN);
+}
+
+static void
+test_invalid (void)
+{
+        const gchar *required[] = { "latitude", "longitude", "x-fuxi-horizontal-radius-m", "x-fuxi-utc-ms" };
+        const gdouble invalid[] = { NAN, INFINITY, -INFINITY };
+        guint64 accepted = 42;
+
+        for (guint i = 0; i < G_N_ELEMENTS (required); i++) {
+                g_autoptr(GVariant) missing = fix_dictionary (required[i], NULL);
+                g_autoptr(GVariant) wrong = fix_dictionary (required[i], g_variant_new_string ("invalid"));
+                g_assert_null (gclue_fuxi_raw_location (missing, NOW, NOW - 1000, 0, &accepted));
+                g_assert_null (gclue_fuxi_raw_location (wrong, NOW, NOW - 1000, 0, &accepted));
+        }
+        for (guint i = 0; i < 3; i++) {
+                for (guint j = 0; j < G_N_ELEMENTS (invalid); j++) {
+                        g_autoptr(GVariant) bad = fix_dictionary (required[i], g_variant_new_double (invalid[j]));
+                        g_assert_null (gclue_fuxi_raw_location (bad, NOW, NOW - 1000, 0, &accepted));
+                }
+        }
+        const gchar *bad_keys[] = { "latitude", "latitude", "longitude", "longitude", "x-fuxi-horizontal-radius-m", "x-fuxi-horizontal-radius-m" };
+        const gdouble bad_values[] = { 90.1, -90.1, 180.1, -180.1, 0, -1 };
+        for (guint i = 0; i < G_N_ELEMENTS (bad_values); i++) {
+                g_autoptr(GVariant) bad = fix_dictionary (bad_keys[i], g_variant_new_double (bad_values[i]));
+                g_assert_null (gclue_fuxi_raw_location (bad, NOW, NOW - 1000, 0, &accepted));
+        }
+        g_assert_cmpuint (accepted, ==, 42);
+}
+
+static void
+test_time (void)
+{
+        g_autoptr(GVariant) dictionary = fix_dictionary (NULL, NULL);
+        guint64 accepted = 0;
+        const guint64 invalid[] = { 0, NOW - 86400000, NOW - 30001, NOW + 5001, G_MAXUINT64 };
+
+        g_assert_null (gclue_fuxi_raw_location (dictionary, NOW, 0, 0, &accepted));
+        g_assert_null (gclue_fuxi_raw_location (dictionary, NOW, NOW + 1, 0, &accepted));
+        g_assert_null (gclue_fuxi_raw_location (dictionary, NOW, NOW - 1000, NOW, &accepted));
+        g_assert_null (gclue_fuxi_raw_location (dictionary, NOW, NOW - 1000, NOW + 1, &accepted));
+        for (guint i = 0; i < G_N_ELEMENTS (invalid); i++) {
+                g_autoptr(GVariant) bad = fix_dictionary ("x-fuxi-utc-ms", g_variant_new_uint64 (invalid[i]));
+                g_assert_null (gclue_fuxi_raw_location (bad, NOW, NOW - 172800000, 0, &accepted));
+        }
+        g_assert_cmpuint (accepted, ==, 0);
+}
+
+static void
+test_optional_altitude (void)
+{
+        guint64 accepted;
+        g_autoptr(GVariant) missing = fix_dictionary ("altitude", NULL);
+        g_autoptr(GVariant) bad = fix_dictionary ("altitude", g_variant_new_double (NAN));
+        g_autoptr(GClueLocation) a = gclue_fuxi_raw_location (missing, NOW, NOW - 1, 0, &accepted);
+        g_autoptr(GClueLocation) b = gclue_fuxi_raw_location (bad, NOW, NOW - 1, 0, &accepted);
+        g_assert_nonnull (a);
+        g_assert_nonnull (b);
+        g_assert_cmpfloat (gclue_location_get_altitude (a), ==, GCLUE_LOCATION_ALTITUDE_UNKNOWN);
+        g_assert_cmpfloat (gclue_location_get_altitude (b), ==, GCLUE_LOCATION_ALTITUDE_UNKNOWN);
+}
+
+int main (int argc, char **argv)
+{
+        g_test_init (&argc, &argv, NULL);
+        g_test_add_func ("/fuxi/raw/valid", test_valid);
+        g_test_add_func ("/fuxi/raw/invalid", test_invalid);
+        g_test_add_func ("/fuxi/raw/time", test_time);
+        g_test_add_func ("/fuxi/raw/altitude", test_optional_altitude);
+        return g_test_run ();
+}
