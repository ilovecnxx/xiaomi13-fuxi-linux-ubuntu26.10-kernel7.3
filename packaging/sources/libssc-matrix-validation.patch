+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef LIBSSC_MATRIX_PRIVATE_H
+#define LIBSSC_MATRIX_PRIVATE_H
+
+#include <math.h>
+#include <string.h>
+
+static inline void
+ssc_matrix_identity (float matrix[3][3])
+{
+	memset (matrix, 0, 9 * sizeof (float));
+	for (unsigned int row = 0; row < 3; row++)
+		matrix[row][row] = 1.0f;
+}
+
+static inline int
+ssc_matrix_accept (float output[3][3], const float candidate[3][3], int complete)
+{
+	const double tolerance = 0.001;
+	double determinant;
+
+	ssc_matrix_identity (output);
+	if (!complete)
+		return 0;
+	for (unsigned int row = 0; row < 3; row++)
+		for (unsigned int col = 0; col < 3; col++)
+			if (!isfinite (candidate[row][col]))
+				return 0;
+
+	/* A mounting rotation must preserve lengths and angles. */
+	for (unsigned int row = 0; row < 3; row++) {
+		for (unsigned int other = 0; other < 3; other++) {
+			double dot = 0;
+			for (unsigned int col = 0; col < 3; col++)
+				dot += (double) candidate[row][col] * candidate[other][col];
+			if (fabs (dot - (row == other ? 1.0 : 0.0)) > tolerance)
+				return 0;
+		}
+	}
+	determinant =
+		(double) candidate[0][0] * (candidate[1][1] * candidate[2][2] - candidate[1][2] * candidate[2][1]) -
+		(double) candidate[0][1] * (candidate[1][0] * candidate[2][2] - candidate[1][2] * candidate[2][0]) +
+		(double) candidate[0][2] * (candidate[1][0] * candidate[2][1] - candidate[1][1] * candidate[2][0]);
+	/* Reflections change handedness and cannot represent a physical rotation. */
+	if (fabs (determinant - 1.0) > tolerance)
+		return 0;
+	memcpy (output, candidate, 9 * sizeof (float));
+	return 1;
+}
+
+#endif
