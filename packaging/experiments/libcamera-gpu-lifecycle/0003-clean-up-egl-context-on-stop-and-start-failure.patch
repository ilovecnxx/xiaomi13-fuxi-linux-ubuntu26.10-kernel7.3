+/**
+ * \brief Release the context and surface owned by this helper
+ *
+ * Call on the rendering thread after deleting its GL objects. The display may
+ * be shared with other users of EGL, so it must not be terminated here.
+ */
+void eGL::releaseEGLContext()
+{
+	if (display_ == EGL_NO_DISPLAY)
+		return;
+
+	if (context_ != EGL_NO_CONTEXT && eglGetCurrentContext() == context_)
+		eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+
 	if (context_ != EGL_NO_CONTEXT)
-		eglDestroyContext(display_, context_);
+		eglDestroyContext(display_, std::exchange(context_, EGL_NO_CONTEXT));
 
 	if (surface_ != EGL_NO_SURFACE)
-		eglDestroySurface(display_, surface_);
+		eglDestroySurface(display_, std::exchange(surface_, EGL_NO_SURFACE));
+
+	display_ = EGL_NO_DISPLAY;
 }
 
