FROM docker.io/library/ubuntu:26.10@sha256:262df65c0ec6bf8d9dcc87454f4330a05fae4b97825f45854af3b136666584c2
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 TZ=UTC
# Signed APT metadata from a fixed snapshot pins transitive dependencies too.
RUN --mount=type=secret,id=host-ca,mode=0444 \
    rm -f /etc/apt/sources.list.d/ubuntu.sources && \
    printf 'deb http://snapshot.ubuntu.com/ubuntu/20261107T000000Z/ stonking main universe\ndeb http://snapshot.ubuntu.com/ubuntu/20261107T000000Z/ stonking-updates main universe\ndeb http://snapshot.ubuntu.com/ubuntu/20261107T000000Z/ stonking-security main universe\n' > /etc/apt/sources.list && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/host-ca -o APT::Update::Error-Mode=any -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/host-ca install -y --no-install-recommends ca-certificates build-essential gcc-aarch64-linux-gnu \
      binutils-aarch64-linux-gnu bison flex bc libssl-dev libelf-dev device-tree-compiler \
      python3 python3-dev python3-setuptools python3-yaml python3-jsonschema python3-pyelftools \
      python3-pip python3-venv git patch xz-utils zstd cpio rsync kmod fakeroot dpkg-dev \
      meson ninja-build pkg-config patchelf gettext xsltproc libglib2.0-dev libgudev-1.0-dev \
      libqmi-glib-dev libqrtr-glib-dev libqrtr-dev libmm-glib-dev libmbim-glib-dev \
      libpolkit-gobject-1-dev libsystemd-dev systemd-dev libdbus-1-dev gnupg && \
    dpkg-query -W -f='${binary:Package}=${Version}\n' > /build-environment.lock && \
    rm -rf /var/lib/apt/lists/*
COPY dtschema-amd64-py314.lock /dtschema.lock
COPY swig-amd64.lock /swig.lock
RUN --mount=type=secret,id=host-ca,mode=0444 \
    apt-get -o Acquire::https::CaInfo=/run/secrets/host-ca -o APT::Update::Error-Mode=any -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/host-ca install -y --no-install-recommends xxd swig python3-wheel python3-setuptools-scm && \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      apt-get -o Acquire::https::CaInfo=/run/secrets/host-ca install -y --no-install-recommends yamllint && \
      python3 -m venv --system-site-packages /opt/schema && \
      PIP_CERT=/run/secrets/host-ca /opt/schema/bin/pip install --require-hashes -r /swig.lock && \
      PATH="/opt/schema/bin:$PATH" PIP_CERT=/run/secrets/host-ca /opt/schema/bin/pip install --require-hashes --no-build-isolation -r /dtschema.lock; \
    fi && \
    dpkg-query -W -f='${binary:Package}=${Version}\n' > /build-environment.lock && \
    rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/schema/bin:${PATH}"
WORKDIR /src
