#!/usr/bin/env python3
"""Read-only interval measurements for fuxi CPU idle and peripheral power states."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import time


SERVICES = {"fuxi-sub2-msg.service", "fuxi-modem-keeper.service",
            "fuxi-auto-brightness.service", "hexagonrpcd.service", "iio-sensor-proxy.service"}


def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return None


def number(path):
    try:
        return int(read(path))
    except (ValueError, TypeError):
        return None


def power_conditions(sys):
    backlights = {}
    for path in sorted((sys / "class/backlight").glob("*")):
        backlights[path.name] = {field: number(path / field) for field in (
            "bl_power", "brightness", "actual_brightness", "max_brightness")}
    supplies = {}
    for path in sorted((sys / "class/power_supply").glob("*")):
        supply = {field: read(path / field) for field in ("type", "status")}
        for field, label in (("online", "online"), ("capacity", "capacity_percent"),
                             ("current_now", "current_now_ua"), ("voltage_now", "voltage_now_uv"),
                             ("charge_counter", "charge_counter_uah"), ("energy_now", "energy_now_uwh"),
                             ("temp", "temp_tenths_celsius")):
            supply[label] = number(path / field)
        supplies[path.name] = supply
    return {"backlights": backlights, "power_supplies": supplies}


def matching_power_endpoints(before, after):
    # Endpoint equality cannot exclude changes within the sampling window.
    if not before or not after:
        return None
    for category in ("backlights", "power_supplies"):
        if not before[category] or not after[category]:
            return None
        if before[category].keys() != after[category].keys():
            return False
    for name, start in before["backlights"].items():
        end = after["backlights"][name]
        for field in ("bl_power", "brightness", "max_brightness"):
            if start[field] is not None and end[field] is not None and start[field] != end[field]:
                return False
    for name, start in before["power_supplies"].items():
        end = after["power_supplies"][name]
        for field in ("type", "status", "online"):
            if start[field] is not None and end[field] is not None and start[field] != end[field]:
                return False
    for sample in (before, after):
        for backlight in sample["backlights"].values():
            if any(backlight[field] is None for field in ("bl_power", "brightness", "max_brightness")):
                return None
        for supply in sample["power_supplies"].values():
            if supply["type"] is None:
                return None
            required = "status" if supply["type"] == "Battery" else "online"
            if supply[required] is None:
                return None
    return True


def snapshot(sys=Path("/sys"), proc=Path("/proc")):
    cpu = sys / "devices/system/cpu"
    counters = read(proc / "stat")
    ticks = [int(x) for x in counters.splitlines()[0].split()[1:9]] if counters else []
    idle = {}
    for path in cpu.glob("cpu[0-9]*/cpuidle/state*"):
        idle[str(path.relative_to(cpu))] = {
            "name": read(path / "name"), "disabled": number(path / "disable"),
            "time_us": number(path / "time"), "entries": number(path / "usage")}
    sensors, services = {}, {}
    sensor_names = {name[:15]: name for name in ("hexagonrpcd-fuxi", "iio-sensor-proxy")}
    for path in proc.glob("[0-9]*"):
        name = read(path / "comm")
        cgroup = read(path / "cgroup") or ""
        units = {part for line in cgroup.splitlines() for part in line.split(":", 2)[-1].split("/")}
        selected = SERVICES & units
        if name not in sensor_names and not selected:
            continue
        stat = read(path / "stat")
        if stat:
            fields = stat.rsplit(")", 1)[1].split()
            counters = {"started": int(fields[19]), "ticks": int(fields[11]) + int(fields[12])}
            if name in sensor_names:
                sensors[path.name] = {"name": sensor_names[name], **counters}
            if selected:
                status_fields = dict(line.split(":", 1) for line in (read(path / "status") or "").splitlines()
                                     if ":" in line)
                switches = {}
                for key in ("voluntary_ctxt_switches", "nonvoluntary_ctxt_switches"):
                    value = status_fields.get(key, "").strip()
                    switches[key] = int(value) if value.isdecimal() else None
                services[path.name] = {"name": sorted(selected)[0], **counters, **switches}
    return {"monotonic": time.monotonic(), "cpu_ticks": ticks,
            "idle": idle, "sensors": sensors, "services": services,
            "power_conditions": power_conditions(sys)}


def interval(before, after, ticks_per_second):
    seconds = after["monotonic"] - before["monotonic"]
    if seconds <= 0 or ticks_per_second <= 0:
        raise ValueError("interval and tick rate must be positive")
    delta = [b - a for a, b in zip(before["cpu_ticks"], after["cpu_ticks"])]
    total = sum(delta)
    busy = total - sum(delta[3:5])
    residency = {}
    for key, end in after["idle"].items():
        start = before["idle"].get(key)
        if not start or None in (start["time_us"], end["time_us"]):
            continue
        elapsed_us = end["time_us"] - start["time_us"]
        if elapsed_us >= 0:
            residency[key] = {"name": end["name"], "disabled": end["disabled"],
                              "residency_percent": round(100 * elapsed_us / (seconds * 1e6), 2)}
    sensors = []
    for pid, end in after["sensors"].items():
        start = before["sensors"].get(pid)
        if (start and start["name"] == end["name"] and start.get("started") == end.get("started")
                and end["ticks"] >= start["ticks"]):
            sensors.append({"name": end["name"],
                            "cpu_percent_one_core": round(100 * (end["ticks"] - start["ticks"]) /
                                                          ticks_per_second / seconds, 2)})
    services = []
    for pid, end in after.get("services", {}).items():
        start = before.get("services", {}).get(pid)
        if (not start or start["name"] != end["name"] or start["started"] != end["started"]
                or end["ticks"] < start["ticks"]):
            continue
        measured = {"service": end["name"], "pid": int(pid),
                    "cpu_percent_one_core": round(100 * (end["ticks"] - start["ticks"]) /
                                                  ticks_per_second / seconds, 2)}
        # /proc/<pid>/status counts the main task, not every thread or hardware wakeup.
        for key, label in (("voluntary_ctxt_switches", "voluntary"),
                           ("nonvoluntary_ctxt_switches", "involuntary")):
            a, b = start.get(key), end.get(key)
            valid = a is not None and b is not None and b >= a
            measured[f"main_task_{label}_switches"] = b - a if valid else None
            measured[f"main_task_{label}_switches_per_second"] = round((b - a) / seconds, 3) if valid else None
        services.append(measured)
    same_processes = (
        {pid: (item["name"], item["started"]) for pid, item in before.get("services", {}).items()} ==
        {pid: (item["name"], item["started"]) for pid, item in after.get("services", {}).items()})
    return {"seconds": round(seconds, 3),
            "cpu_busy_percent_all_cores": round(100 * busy / total, 2) if total > 0 else None,
            "idle": residency, "sensor_processes": sensors, "service_processes": services,
            "service_process_set_unchanged": same_processes,
            "power_conditions": {"before": before.get("power_conditions"),
                                 "after": after.get("power_conditions")},
            "power_condition_endpoints_match": matching_power_endpoints(
                before.get("power_conditions"), after.get("power_conditions"))}


def command(*args):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=5)
        return result.stdout.strip() if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def status(sys=Path("/sys")):
    cpu = sys / "devices/system/cpu"
    policies = {}
    for path in sorted(cpu.glob("cpufreq/policy*")):
        policies[path.name] = {field: read(path / field) for field in (
            "related_cpus", "scaling_governor", "scaling_min_freq", "scaling_max_freq",
            "cpuinfo_max_freq", "scaling_cur_freq", "schedutil/rate_limit_us")}
    thermal = {}
    for path in (sys / "class/thermal").glob("thermal_zone*"):
        temp = number(path / "temp")
        if temp is not None and -40000 < temp < 120000:
            thermal[path.name] = {"type": read(path / "type"), "millicelsius": temp}
    ibs = sys / "kernel/debug/bluetooth/hci0/ibs"
    return {"kernel": os.uname().release, "cpu_policies": policies,
            "idle_governor": read(cpu / "cpuidle/current_governor_ro"),
            "thermal": thermal,
            "wifi_power_save": command("iw", "dev", "wlp1s0", "get", "power_save"),
            "wifi_runtime_control": read(sys / "bus/pci/devices/0000:01:00.0/power/control"),
            "bluetooth_ibs": {path.name: read(path) for path in sorted(ibs.glob("*")) if path.is_file()}}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--seconds", type=int, default=10, choices=range(1, 61), metavar="1..60")
    args = parser.parse_args()
    before = snapshot()
    time.sleep(args.seconds)
    after = snapshot()
    report = status()
    report["interval"] = interval(before, after, os.sysconf("SC_CLK_TCK"))
    print(json.dumps(report, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
