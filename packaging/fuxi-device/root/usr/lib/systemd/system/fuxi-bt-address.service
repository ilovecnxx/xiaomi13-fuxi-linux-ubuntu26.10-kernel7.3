[Unit]
Description=fuxi: set the WCN7850 Bluetooth public address (controller has none)
# QCA 固件要等 bluetoothd 第一次打开 hci0 才下载，下载完 hci0 才变成 "Unconfigured"；
# 所以排在 bluetoothd 之后：等到 Unconfigured → 设地址 → 重启一次 bluetoothd（10-28 实测）
After=fuxi-bt-init.service bluetooth.service
Requires=fuxi-bt-init.service
Wants=bluetooth.service
ConditionPathExists=/etc/fuxi/bt-address

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/fuxi-bt-address
TimeoutStartSec=130

[Install]
WantedBy=multi-user.target
