#!/bin/sh
# fuxi 内核条目管理（手机上运行，由 fuxi-device 包装到 /usr/sbin/）。条目在 /boot/fuxi/<条目>/{Image,<dtb>,initrd.img,cmdline}：
#   - shim7 仅作应急回滚，兼容布局见 scripts/legacy/fuxi-shim/init
#   - 主线 U-Boot：读本脚本生成的 /boot/extlinux/extlinux.conf（default 第一、fallback 第二、其余按名字），
#     和 /boot/extlinux/fallback.conf（默认=回退条目）。自动回退靠 fuxi-bootcount 的计数块：换默认条目时 arm，
#     U-Boot 每次启动未确认的默认条目 tries+1，到 2 改用 fallback.conf；fuxi-boot-ok.service 确认
# Debian 内核包（make bindeb-pkg）装/卸时由 /etc/kernel/post{inst,rm}.d/zz-fuxi 调用。
#
# 用法:
#   fuxi-kernel-install add <条目> <Image|Image.gz|vmlinuz> [<dtb>]（Image.gz 会解压）
#       装条目并设为默认；当前已确认的条目（本次启动、tries 已被清掉）成为回退。
#       dtb 省略时用 /usr/lib/linux-image-<条目>/qcom/$FUXI_DTB.dtb（deb 装的位置）。
#       cmdline 取 /etc/kernel/cmdline（标准位置，含 root=UUID=…），没有它才用 /etc/fuxi/cmdline（旧）。
#       必须有 /boot/initrd.img-<条目>（initramfs-tools 生成）。同名且内容一致时允许包重新配置，禁止覆盖不同内容。
#   fuxi-kernel-install initrd <条目> [<initrd>]   刷新条目里的 initrd（/etc/initramfs/post-update.d/zz-fuxi 调用，
#       即 update-initramfs -u 之后）；条目不存在就什么也不做。刷新的是默认条目 → 计数块 arm（新 initrd 也要确认）
#   fuxi-kernel-install remove [--force] <条目>     默认/回退条目要 --force
#   fuxi-kernel-install set-default <条目> | set-fallback <条目>
#   fuxi-kernel-install list
#   fuxi-kernel-install extlinux                   只重写 /boot/extlinux/extlinux.conf
# 配置 /etc/fuxi/kernel.conf（sh 语法，可选）：FUXI_DTB=<DTB 名，不带 .dtb>  FUXI_CMDLINE_FILE=<路径>
set -eu
B=/boot/fuxi
# 收敛后的单一板级 DTB（fuxi/consolidate-7.4）；老内核包里没有它 → 用老的日常 DTB 名
FUXI_DTB=sm8550-xiaomi-fuxi
FUXI_DTB_OLD=sm8550-xiaomi-fuxi-r120idle-mic-rupdclk-modem-audio-disp-usbc-dp
FUXI_CMDLINE_FILE=/etc/fuxi/cmdline
[ -s /etc/kernel/cmdline ] && FUXI_CMDLINE_FILE=/etc/kernel/cmdline
[ -f /etc/fuxi/kernel.conf ] && . /etc/fuxi/kernel.conf

die() { echo "fuxi-kernel-install: $*" >&2; exit 1; }
say() { echo "fuxi-kernel-install: $*"; }
check_name() {
  case "$1" in ''|.*|*/*|*[!A-Za-z0-9._+-]*) die "条目名不合法: '$1'" ;; esac
}
# 原子写一行
put() { printf '%s\n' "$2" > "$B/.$1.tmp" && mv -f "$B/.$1.tmp" "$B/$1"; }
get() { cat "$B/$1" 2>/dev/null || true; }
space_required() {
  avail=$(df -Pk "$B" | awk 'END {print $4}')
  [ "$avail" -ge "$1" ] || die "空间不足：需要 ${1} KiB，可用 ${avail} KiB"
}
verify_entry() {
  check_name "$1"
  vd=$B/$1
  [ -s "$vd/Image" ] && [ -s "$vd/cmdline" ] && [ -s "$vd/initrd.img" ] || die "条目 $1 不完整"
  [ -f "$vd/SHA256SUMS" ] || die "条目 $1 缺校验清单"
  (cd "$vd" && sha256sum -c --quiet SHA256SUMS) || die "条目 $1 校验失败"
  [ -n "$(find "$vd" -maxdepth 1 -name '*.dtb' -type f -print -quit)" ] || die "条目 $1 缺 DTB"
}
# Persist the old boot metadata before changing it. A killed process leaves a
# journal which the next invocation restores before doing any further work.
recover_transaction() {
  j=$B/.transaction
  [ -d "$j" ] || return 0
  if [ -f "$j/ready" ]; then
    for f in default fallback tries default.failed; do
      if [ -f "$j/$f" ]; then cp "$j/$f" "$B/.$f.restore"; mv -f "$B/.$f.restore" "$B/$f";
      else rm -f "$B/$f"; fi
    done
    mkdir -p /boot/extlinux
    for f in extlinux.conf fallback.conf; do
      if [ -f "$j/$f" ]; then cp "$j/$f" "/boot/extlinux/.$f.restore"; mv -f "/boot/extlinux/.$f.restore" "/boot/extlinux/$f";
      else rm -f "/boot/extlinux/$f"; fi
    done
    if [ -f "$j/entry" ]; then
      re=$(cat "$j/entry"); check_name "$re"
      for f in initrd.img SHA256SUMS; do
        cp "$j/entry-$f" "$B/$re/.$f.restore"
        mv -f "$B/$re/.$f.restore" "$B/$re/$f"
      done
      ln -f "$B/$re/initrd.img" "$B/$re/initrd"
    fi
    sync
    say "已恢复上次未完成操作的启动配置；启动计数可能仍待确认"
  fi
  rm -rf "$j"
  sync
}
begin_transaction() {
  j=$B/.transaction
  mkdir "$j"
  for f in default fallback tries default.failed; do
    [ ! -f "$B/$f" ] || cp "$B/$f" "$j/$f"
  done
  for f in extlinux.conf fallback.conf; do
    [ ! -f "/boot/extlinux/$f" ] || cp "/boot/extlinux/$f" "$j/$f"
  done
  if [ "$1" = initrd ] && [ -d "$B/$2" ]; then
    verify_entry "$2"
    space_required "$(( $(du -k "$B/$2/initrd.img" | awk '{print $1}') * 2 + 32768 ))"
    cp "$B/$2/initrd.img" "$j/entry-initrd.img"
    cp "$B/$2/SHA256SUMS" "$j/entry-SHA256SUMS"
    printf '%s\n' "$2" > "$j/entry"
  fi
  sync
  touch "$j/ready"
  sync
}
finish_transaction() {
  sync
  rm -rf "$B/.transaction"
  sync
}
# 当前 U-Boot / shim7 都在 cmdline 里传 fuxi.entry=<条目>。
running_entry() { tr ' ' '\n' < /proc/cmdline | sed -n 's/^fuxi\.entry=//p' | tail -1; }

# 按 /boot/fuxi 的条目重写 /boot/extlinux/extlinux.conf（路径用绝对路径，U-Boot sysboot 在 sda33 根上解析）
gen_extlinux() {
  def=$(get default); fb=$(get fallback)
  [ -n "$def" ] && [ -d "$B/$def" ] || { say "没有默认条目，不生成 extlinux.conf"; return 0; }
  x=/boot/extlinux
  mkdir -p "$x"
  ext_conf "$def" "$def" "$fb" > "$x/.extlinux.conf.tmp"
  if [ -n "$fb" ] && [ -f "$B/$fb/Image" ]; then
    ext_conf "$fb" "$def" "$fb" > "$x/.fallback.conf.tmp"
    mv -f "$x/.fallback.conf.tmp" "$x/fallback.conf"
  else
    rm -f "$x/fallback.conf"
  fi
  # Publish the rescue config before the default config that may need it.
  sync
  mv -f "$x/.extlinux.conf.tmp" "$x/extlinux.conf"
  sync
}
# ext_conf <本文件的默认 label> <默认条目> <回退条目>
ext_conf() {
  # 变量名都带 l 前缀：sh 没有局部变量，别覆盖调用者的 e/d/t（11-07：cmd_add 的 e 被改成最后一个条目）
  first=$1; def=$2; fb=$3; seen=
  {
    echo "# 由 fuxi-kernel-install 生成，别手改（改 /etc/kernel/cmdline 后重新 add，或 set-default）"
    echo "menu title fuxi Linux (default=$def fallback=${fb:--})"
    echo "timeout 30"
    echo "default $first"
    for le in "$def" "$fb" $(ls "$B"); do
      [ -n "$le" ] && [ -f "$B/$le/Image" ] && [ -s "$B/$le/cmdline" ] || continue
      case " $seen " in *" $le "*) continue ;; esac
      seen="$seen $le"
      ld=$(ls "$B/$le" | grep -m1 '\.dtb$' || true)
      [ -n "$ld" ] || continue
      lt=; [ "$le" = "$def" ] && lt=" (default)"; [ "$le" = "$fb" ] && lt=" (fallback)"
      echo
      echo "label $le"
      echo "	menu label Linux $le$lt"
      echo "	linux $B/$le/Image"
      echo "	fdt $B/$le/$ld"
      if [ -f "$B/$le/initrd.img" ]; then echo "	initrd $B/$le/initrd.img"; fi
      echo "	append $(head -1 "$B/$le/cmdline") fuxi.entry=$le fuxi.boot=extlinux"
    done
  }
}
# 默认条目换成了没在跑的条目 → 下次启动要确认（U-Boot 计数）
arm_bootcount() {
  [ "$1" != "$(running_entry)" ] || return 0
  [ -x /usr/sbin/fuxi-bootcount ] || die "缺少 fuxi-bootcount，拒绝切换默认内核"
  /usr/sbin/fuxi-bootcount arm || die "启动计数设置失败，拒绝切换默认内核"
}

cmd_add() {
  e=$1; img=$2; dtb=${3:-/usr/lib/linux-image-$1/qcom/$FUXI_DTB.dtb}
  [ $# -ge 3 ] || [ -f "$dtb" ] || dtb=/usr/lib/linux-image-$1/qcom/$FUXI_DTB_OLD.dtb
  check_name "$e"
  [ -f "$img" ] || die "没有内核镜像 $img"
  [ -f "$dtb" ] || die "没有 DTB $dtb"
  [ -s "$FUXI_CMDLINE_FILE" ] || die "没有 cmdline 文件 $FUXI_CMDLINE_FILE"
  rd=${FUXI_INITRD:-/boot/initrd.img-$e}
  [ -s "$rd" ] || die "缺少 initrd $rd"
  if [ -e "$B/$e" ]; then
    verify_entry "$e"
    same=0
    if [ "$(head -c 2 "$img" | od -An -tx1 | tr -d ' ')" = 1f8b ]; then
      if gzip -t "$img" && gzip -dc "$img" | cmp -s - "$B/$e/Image"; then same=1; fi
    elif cmp -s "$img" "$B/$e/Image"; then same=1; fi
    expected_cmdline=$(tr '\n' ' ' < "$FUXI_CMDLINE_FILE" | sed 's/ *$//')
    if [ "$same" = 1 ] && cmp -s "$dtb" "$B/$e/${dtb##*/}" &&
       cmp -s "$rd" "$B/$e/initrd.img" && [ "$expected_cmdline" = "$(cat "$B/$e/cmdline")" ]; then
      say "条目 $e 与输入一致，保留现有默认和回退（允许包重新配置）"
      return 0
    fi
    die "条目 $e 已存在且内容不同，使用唯一版本名，禁止覆盖"
  fi
  need=$(( ($(stat -c %s "$img") * 8 + $(stat -c %s "$dtb") + $(stat -c %s "$rd")) / 1024 + 32768 ))
  space_required "$need"
  fb=$(get fallback); [ -z "$fb" ] || verify_entry "$fb"
  mkdir -p "$B"
  t=$B/.$e.new
  rm -rf "$t"; mkdir "$t"
  # deb 的 vmlinuz 在 arm64 上是 Image.gz。shim 里的静态 kexec（经典 kexec_load，-c）不解压，
  # 报 "Bad arm64 image header"（11-07 实测）→ 安装时解压成 Image
  kn=Image
  if [ "$(head -c 2 "$img" | od -An -tx1 | tr -d ' ')" = 1f8b ]; then
    gzip -dc "$img" > "$t/Image"
  else
    cp "$img" "$t/Image"
  fi
  cp "$dtb" "$t/"
  # 硬链接 initrd：回滚镜像 shim7 只认 <条目>/initrd，没有它 root=UUID 解析不了会 panic
  if [ -f "$rd" ]; then cp "$rd" "$t/initrd.img"; ln -f "$t/initrd.img" "$t/initrd"; fi
  tr '\n' ' ' < "$FUXI_CMDLINE_FILE" | sed 's/ *$//' > "$t/cmdline"
  echo >> "$t/cmdline"
  (cd "$t" && sha256sum ./* > SHA256SUMS)
  sync
  mv "$t" "$B/$e"
  verify_entry "$e"
  cur=$(running_entry)
  confirmed=0
  if [ -x /usr/sbin/fuxi-bootcount ]; then
    bs=$(/usr/sbin/fuxi-bootcount show) || die "无法读取启动计数"
    case "$bs" in *pending=0*) confirmed=1 ;; esac
  fi
  if [ "$confirmed" = 1 ] && [ -n "$cur" ] && [ "$cur" != "$e" ] && [ -d "$B/$cur" ]; then
    verify_entry "$cur"
    put fallback "$cur"
  fi
  arm_bootcount "$e"
  put default "$e"
  rm -f "$B/tries"
  [ "$(get default.failed)" != "$e" ] || rm -f "$B/default.failed"
  sync
  gen_extlinux
  say "已装 $e（$kn + ${dtb##*/}），默认=$e 回退=$(get fallback)"
}

cmd_initrd() {
  e=$1; rd=${2:-/boot/initrd.img-$1}
  check_name "$e"
  [ -d "$B/$e" ] || return 0
  [ -f "$rd" ] || die "没有 initrd $rd"
  space_required "$(( $(stat -c %s "$rd") / 1024 + 32768 ))"
  if [ "$e" = "$(get default)" ]; then
    [ -x /usr/sbin/fuxi-bootcount ] || die "缺少启动计数工具"
    /usr/sbin/fuxi-bootcount arm || die "启动计数设置失败"
  fi
  cp "$rd" "$B/$e/.initrd.img.tmp"
  sync
  mv -f "$B/$e/.initrd.img.tmp" "$B/$e/initrd.img"
  ln -f "$B/$e/initrd.img" "$B/$e/initrd"  # 给 shim7 回滚用，见 cmd_add
  (cd "$B/$e" && sha256sum ./Image ./*.dtb ./cmdline ./initrd.img > .SHA256SUMS.tmp && mv -f .SHA256SUMS.tmp SHA256SUMS)
  sync
  gen_extlinux
  say "已刷新 $e 的 initrd"
}

cmd_remove() {
  force=0
  [ "${1:-}" = --force ] && { force=1; shift; }
  e=${1:?}
  check_name "$e"
  [ -d "$B/$e" ] || { say "没有条目 $e"; return 0; }
  if [ "$force" = 0 ]; then
    [ "$e" != "$(get default)" ] || die "$e 是默认条目，先 set-default 别的（或 --force）"
    [ "$e" != "$(get fallback)" ] || die "$e 是回退条目，先 set-fallback 别的（或 --force）"
    [ "$e" != "$(running_entry)" ] || die "$e 是正在运行的条目（或 --force）"
  fi
  rm -rf "$B/$e"
  sync
  gen_extlinux
  say "已删 $e"
}

cmd_set() {
  check_name "$2"
  verify_entry "$2"
  [ "$1" != default ] || arm_bootcount "$2"
  put "$1" "$2"
  if [ "$1" = default ]; then
    rm -f "$B/tries"
    [ "$(get default.failed)" != "$2" ] || rm -f "$B/default.failed"
  fi
  sync
  gen_extlinux
  say "$1=$2"
}

cmd_list() {
  def=$(get default); fb=$(get fallback); run=$(running_entry)
  for d in "$B"/*/; do
    [ -d "$d" ] || continue
    e=$(basename "$d")
    m=
    [ "$e" = "$def" ] && m="$m default"
    [ "$e" = "$fb" ] && m="$m fallback"
    [ "$e" = "$run" ] && m="$m running"
    k=$(ls "$d" | grep -m1 -E '^Image(\.gz)?$' || true)
    printf '%-24s %-10s %s\n' "$e" "${k:--}" "${m# }"
  done
  [ -e "$B/tries" ] && echo "tries=$(get tries)（默认条目还没确认）"
  [ -e "$B/default.failed" ] && echo "default.failed=$(get default.failed)"
  return 0
}

[ "$(id -u)" = 0 ] || die "要 root"
mkdir -p "$B"
if ! [ "$B/.install.lock" -ef /proc/self/fd/9 ]; then
  exec 9>"$B/.install.lock"
fi
flock -w 30 9 || die "另一个内核维护操作正在运行"
recover_transaction
case "${1:-}" in
  add|initrd|set-default|set-fallback|extlinux)
    [ "${1:-}" = extlinux ] || check_name "${2:-}"
    space_required 32768
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    trap 'rc=$?; if [ "$rc" != 0 ]; then recover_transaction; fi' EXIT
    begin_transaction "$1" "${2:-}"
    ;;
esac
case "${1:-}" in
  add) shift; [ $# -ge 2 ] || die "用法: add <条目> <Image> [<dtb>]"; cmd_add "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  initrd) shift; [ $# -ge 1 ] || die "用法: initrd <条目> [<initrd>]"; cmd_initrd "$@" ;;
  set-default) cmd_set default "${2:?}" ;;
  set-fallback) cmd_set fallback "${2:?}" ;;
  list|'') cmd_list ;;
  verify) verify_entry "${2:?}"; say "条目 $2 校验通过" ;;
  extlinux) gen_extlinux; say "已重写 /boot/extlinux/extlinux.conf" ;;
  *) die "未知命令 $1（add/remove/initrd/set-default/set-fallback/list/extlinux）" ;;
esac
finish_transaction
