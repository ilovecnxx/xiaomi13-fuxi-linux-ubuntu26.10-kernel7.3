#!/bin/sh
# 切换图形会话：fuxi-session phosh | plasma | denial
# 停会话后要清掉残留的 kwin_wayland / plasmashell / deniald：它们不随 service 退出，
# 会继续占着 wayland-0 和 DRM，导致新会话黑屏（2026-11-04、2026-11-07）。
set -e
stop_plasma() {
  systemctl stop fuxi-autorotate.service 2>/dev/null || true
  systemctl stop plasmamobile.service 2>/dev/null || true
  pkill -u fuxi -x kwin_wayland 2>/dev/null || true
  pkill -u fuxi -x plasmashell 2>/dev/null || true
}
stop_denial() {
  systemctl stop denial.service 2>/dev/null || true
  pkill -u fuxi -x deniald 2>/dev/null || true
}
case "${1:-}" in
  plasma|plasmamobile)
    systemctl stop phosh.service 2>/dev/null || true
    stop_plasma
    stop_denial
    sleep 1
    systemctl start plasmamobile.service
    systemctl start fuxi-autorotate.service 2>/dev/null || true
    ;;
  denial)
    systemctl stop phosh.service 2>/dev/null || true
    stop_plasma
    stop_denial
    sleep 1
    systemctl start denial.service
    ;;
  phosh)
    stop_plasma
    stop_denial
    sleep 1
    systemctl start phosh.service
    ;;
  *) echo "用法: fuxi-session phosh|plasma|denial" >&2; exit 2 ;;
esac
