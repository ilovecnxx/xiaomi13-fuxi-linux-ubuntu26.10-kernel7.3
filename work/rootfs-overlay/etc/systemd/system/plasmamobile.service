[Unit]
Description=KDE Plasma Mobile session
Conflicts=phosh.service getty@tty7.service
After=systemd-user-sessions.service dbus.socket
Wants=dbus.socket
ConditionPathExists=/dev/tty0

[Service]
User=1000
PAMName=login
WorkingDirectory=~
Environment=LANG=C.UTF-8
Environment=XDG_CURRENT_DESKTOP=KDE
Environment=XDG_SESSION_DESKTOP=plasma-mobile
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/lib/aarch64-linux-gnu/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasmamobile
TimeoutStartSec=60
Restart=on-failure
RestartSec=3
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7

[Install]
WantedBy=graphical.target
