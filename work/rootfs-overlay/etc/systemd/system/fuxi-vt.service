[Unit]
Description=Fuxi: make tty7 the active VT before the graphical session
# 没有这一步，开机时活跃 VT 是 tty1，KWin 拿不到 DRM master，
# 会话起来却是黑屏（2026-11-04）。
Before=plasmamobile.service phosh.service
After=systemd-vconsole-setup.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/chvt 7

[Install]
# 只给 Plasma 用：phosh.service.d/20-fuxi-session.conf 的 ExecStartPre 自己 chvt 7，
# 提前切到空 tty7 只会让 Phosh 开机多黑 5 s（2026-11-06）。
WantedBy=plasmamobile.service
