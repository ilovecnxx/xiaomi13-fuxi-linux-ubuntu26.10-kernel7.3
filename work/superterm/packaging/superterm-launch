#!/bin/bash
# SuperTerm desktop launcher: opens the native window in the current graphical session.
set -euo pipefail
APP_DIR="${SUPERTERM_DIR:-$HOME/.local/share/superterm}"
export PYTHONPATH="$APP_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
exec python3 -m superterm.main "$@"
