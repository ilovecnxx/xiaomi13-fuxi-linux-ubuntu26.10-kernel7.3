+/*
+ * fuxi diagnostics (read-only): GET-type queries only, results via debugfs.
+ * Reading "diag" queries USB props 0-12 (0x32) and selected Xiaomi props (0x50).
+ */
+static int qcom_battmgr_raw_req(struct qcom_battmgr *battmgr, u32 opcode,
+				u32 prop, u32 val, u32 *value, u32 *result)
+{
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	battmgr->raw_opcode = opcode;
+	battmgr->raw_prop = prop;
+	battmgr->raw_len = 0;
+	WRITE_ONCE(battmgr->raw_pending, true);
+	ret = qcom_battmgr_request_property(battmgr, opcode, prop, val);
+	WRITE_ONCE(battmgr->raw_pending, false);
+	*value = battmgr->raw_value;
+	*result = battmgr->raw_result;
+	mutex_unlock(&battmgr->lock);
+
+	return ret;
+}
