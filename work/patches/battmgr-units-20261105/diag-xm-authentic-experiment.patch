+static const struct {
+	u32 id;
+	const char *name;
+} qcom_battmgr_xm_diag_props[] = {
+	{ 0, "RESISTANCE_ID" }, { 2, "CONNECTOR_TEMP" }, { 3, "AUTHENTIC" },
+	{ 4, "BATT_ADAPT_POWER_MATCH" }, { 5, "CHIP_OK" }, { 7, "REAL_TYPE" },
+	{ 12, "VERIFY_PROCESS" }, { 21, "CURRENT_STATE" }, { 22, "ADAPTER_ID" },
+	{ 23, "ADAPTER_SVID" }, { 24, "PD_VERIFED" }, { 25, "PDO2" },
+	{ 26, "UVDM_STATE" }, { 27, "BQ2597X_CHIP_OK" }, { 32, "BQ2597X_BUS_VOLTAGE" },
+	{ 41, "CC_ORIENTATION" }, { 42, "INPUT_SUSPEND" }, { 43, "FASTCHGMODE" },
+	{ 49, "QUICK_CHARGE_TYPE" }, { 50, "APDO_MAX" }, { 51, "POWER_MAX" },
+};
+
+static void qcom_battmgr_diag_one(struct seq_file *s, struct qcom_battmgr *battmgr,
+				  u32 opcode, u32 prop, const char *name)
+{
+	u32 value = 0, result = 0;
+	int ret = qcom_battmgr_raw_req(battmgr, opcode, prop, 0, &value, &result);
+
+	if (ret)
+		seq_printf(s, "%#x %2u %-24s err %d\n", opcode, prop, name, ret);
+	else
+		seq_printf(s, "%#x %2u %-24s %u (%#x) res %u len %zu\n", opcode, prop,
+			   name, value, value, result, battmgr->raw_len);
+}
+
+static int qcom_battmgr_diag_show(struct seq_file *s, void *unused)
+{
+	static const char * const usb_names[] = {
+		"ONLINE", "VOLT_NOW", "VOLT_MAX", "CURR_NOW", "CURR_MAX",
+		"INPUT_CURR_LIMIT", "TYPE", "ADAP_TYPE", "MOISTURE_DET_EN",
+		"MOISTURE_DET_STS", "TEMP", "REAL_TYPE", "TYPEC_COMPLIANT",
+	};
+	struct qcom_battmgr *battmgr = s->private;
+	int i;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	for (i = 0; i < ARRAY_SIZE(usb_names); i++)
+		qcom_battmgr_diag_one(s, battmgr, BATTMGR_USB_PROPERTY_GET, i,
+				      usb_names[i]);
+	for (i = 0; i < ARRAY_SIZE(qcom_battmgr_xm_diag_props); i++)
+		qcom_battmgr_diag_one(s, battmgr, BATTMGR_XM_UNSOLICITED,
+				      qcom_battmgr_xm_diag_props[i].id,
+				      qcom_battmgr_xm_diag_props[i].name);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(qcom_battmgr_diag);
