diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 941fff0e7..0f0f196f1 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -589,6 +589,9 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 		val->intval = battmgr->status.current_now;
 		break;
 	case POWER_SUPPLY_PROP_POWER_NOW:
+		/* Xiaomi firmware reports a constant 10 W placeholder here */
+		if (battmgr->shifted_props)
+			return -ENODATA;
 		val->intval = battmgr->status.power_now;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
@@ -649,9 +652,16 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 		val->intval = battmgr->status.soh_percent;
 		break;
 	case POWER_SUPPLY_PROP_TIME_TO_EMPTY_AVG:
+		/* 65535 and -1 mean "unknown" on Xiaomi firmware */
+		if (battmgr->shifted_props &&
+		    battmgr->status.discharge_time >= U16_MAX)
+			return -ENODATA;
 		val->intval = battmgr->status.discharge_time;
 		break;
 	case POWER_SUPPLY_PROP_TIME_TO_FULL_AVG:
+		if (battmgr->shifted_props &&
+		    battmgr->status.charge_time >= U16_MAX)
+			return -ENODATA;
 		val->intval = battmgr->status.charge_time;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
@@ -1174,6 +1184,16 @@ static int qcom_battmgr_wls_get_property(struct power_supply *psy,
 		val->intval = battmgr->wireless.voltage_max;
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		/* Xiaomi firmware mirrors the USB input current when no pad is present */
+		if (battmgr->shifted_props) {
+			ret = qcom_battmgr_wls_sm8350_update(battmgr, POWER_SUPPLY_PROP_ONLINE);
+			if (ret < 0)
+				return ret;
+			if (!battmgr->wireless.online) {
+				val->intval = 0;
+				break;
+			}
+		}
 		val->intval = battmgr->wireless.current_now;
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_MAX:
@@ -1479,24 +1499,38 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 			break;
 		case BATT_CHG_COUNTER:
 			battmgr->info.charge_count = le32_to_cpu(resp->intval.value);
+			/* Xiaomi firmware reports mAh */
+			if (battmgr->shifted_props)
+				battmgr->info.charge_count *= 1000;
 			break;
 		case BATT_CYCLE_COUNT:
 			battmgr->info.cycle_count = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_CHG_FULL_DESIGN:
 			battmgr->info.design_capacity = le32_to_cpu(resp->intval.value);
+			/* accept mAh as well as uAh from Xiaomi firmware */
+			if (battmgr->shifted_props && battmgr->info.design_capacity < 100000)
+				battmgr->info.design_capacity *= 1000;
 			break;
 		case BATT_CHG_FULL:
 			battmgr->info.last_full_capacity = le32_to_cpu(resp->intval.value);
+			if (battmgr->shifted_props && battmgr->info.last_full_capacity < 100000)
+				battmgr->info.last_full_capacity *= 1000;
 			break;
 		case BATT_MODEL_NAME:
 			strscpy(battmgr->info.model_number, resp->strval.model, BATTMGR_STRING_LEN);
 			break;
 		case BATT_TTF_AVG:
 			battmgr->status.charge_time = le32_to_cpu(resp->intval.value);
+			/* Xiaomi firmware reports minutes */
+			if (battmgr->shifted_props && battmgr->status.charge_time < U16_MAX)
+				battmgr->status.charge_time *= 60;
 			break;
 		case BATT_TTE_AVG:
 			battmgr->status.discharge_time = le32_to_cpu(resp->intval.value);
+			/* also minutes: 825 at 1142 mAh / 74 mA ≈ 15 h */
+			if (battmgr->shifted_props && battmgr->status.discharge_time < U16_MAX)
+				battmgr->status.discharge_time *= 60;
 			break;
 		case BATT_RESISTANCE:
 			battmgr->status.resistance = le32_to_cpu(resp->intval.value);
@@ -1702,6 +1736,8 @@ static int qcom_battmgr_probe(struct auxiliary_device *adev,
 	if (of_machine_is_compatible("xiaomi,fuxi")) {
 		battmgr->shifted_props = true;
 		battmgr->variant = QCOM_BATTMGR_SM8350;
+		/* capacities are charge based (uAh), never energy */
+		battmgr->unit = QCOM_BATTMGR_UNIT_mAh;
 	}
 
 	ret = qcom_battmgr_charge_control_thresholds_init(battmgr);
