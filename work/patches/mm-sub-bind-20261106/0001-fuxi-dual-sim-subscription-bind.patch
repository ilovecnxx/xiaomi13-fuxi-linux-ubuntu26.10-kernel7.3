 /* All Call Status indications */
 
+/* fuxi dual-SIM: calls on the secondary subscription use index qmi_id + 100.
+ * Each subscription only reports its own calls, but MM wants the full list, so
+ * keep the live calls of each subscription and report the union. */
+static MMCallInfo *
+fuxi_call_info_copy (const MMCallInfo *src)
+{
+    MMCallInfo *dst;
+
+    dst = g_slice_new0 (MMCallInfo);
+    dst->index = src->index;
+    dst->direction = src->direction;
+    dst->state = src->state;
+    dst->number = g_strdup (src->number);
+    return dst;
+}
+
+static GList *
+fuxi_call_info_list_append_copies (GList *list,
+                                   GList *src,
+                                   gboolean live_only)
+{
+    for (; src; src = g_list_next (src)) {
+        MMCallInfo *ci = src->data;
+
+        if (live_only && ci->state == MM_CALL_STATE_TERMINATED)
+            continue;
+        list = g_list_append (list, fuxi_call_info_copy (ci));
+    }
+    return list;
+}
