 static void
+allocate_client_done (GTask *task)
+{
+    MMPortQmi             *self;
+    AllocateClientContext *ctx;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+
+    /* Move the service info to our internal list */
+    self->priv->services = g_list_prepend (self->priv->services, ctx->info);
+    ctx->info = NULL;
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+bind_subscription_wds_ready (QmiClientWds *client,
+                             GAsyncResult *res,
+                             GTask        *task)
+{
+    g_autoptr(QmiMessageWdsBindSubscriptionOutput) output = NULL;
+    g_autoptr(GError)                              error = NULL;
+
+    output = qmi_client_wds_bind_subscription_finish (client, res, &error);
+    if (output && qmi_message_wds_bind_subscription_output_get_result (output, &error))
+        mm_obj_info (g_task_get_source_object (task), "WDS client %u bound to subscription",
+                     qmi_client_get_cid (QMI_CLIENT (client)));
+    else
+        mm_obj_warn (g_task_get_source_object (task), "couldn't bind WDS client %u to subscription: %s",
+                     qmi_client_get_cid (QMI_CLIENT (client)), error->message);
+    allocate_client_done (task);
+}
+
+static void
+bind_subscription_raw_ready (QmiDevice    *device,
+                             GAsyncResult *res,
+                             GTask        *task)
+{
+    AllocateClientContext *ctx;
+    g_autoptr(QmiMessage)  response = NULL;
+    g_autoptr(GError)      error = NULL;
+    guint16                result = 1;
+    guint16                qmi_error = 0;
+
+    ctx = g_task_get_task_data (task);
+    response = qmi_device_command_full_finish (device, res, &error);
+    if (response) {
+        gsize    tlv;
+        gsize    offset = 0;
+        guint16  len = 0;
+
+        tlv = qmi_message_tlv_read_init (response, 0x02, &len, &error);
+        if (!error &&
+            qmi_message_tlv_read_guint16 (response, tlv, &offset, QMI_ENDIAN_LITTLE, &result, &error))
+            qmi_message_tlv_read_guint16 (response, tlv, &offset, QMI_ENDIAN_LITTLE, &qmi_error, &error);
+    }
+
+    if (error)
+        mm_obj_warn (g_task_get_source_object (task), "couldn't bind %s client %u to subscription: %s",
+                     qmi_service_get_string (ctx->info->service),
+                     qmi_client_get_cid (ctx->info->client), error->message);
+    else if (result)
+        mm_obj_warn (g_task_get_source_object (task), "couldn't bind %s client %u to subscription: QMI error 0x%04x",
+                     qmi_service_get_string (ctx->info->service),
+                     qmi_client_get_cid (ctx->info->client), qmi_error);
+    else
+        mm_obj_info (g_task_get_source_object (task), "%s client %u bound to subscription",
+                     qmi_service_get_string (ctx->info->service),
+                     qmi_client_get_cid (ctx->info->client));
+    allocate_client_done (task);
+}
+
+/* fuxi: returns TRUE if a bind request was sent (completion via allocate_client_done) */
+static gboolean
+bind_subscription (MMPortQmi *self,
+                   GTask     *task)
+{
+    AllocateClientContext *ctx;
+    gboolean               secondary;
+    guint16                msg_id;
+
+    ctx = g_task_get_task_data (task);
+    if (!g_file_test (MM_PORT_QMI_SUB_BIND_FILE, G_FILE_TEST_EXISTS))
+        return FALSE;
+
+    secondary = (ctx->info->service == QMI_SERVICE_VOICE && ctx->info->flag == MM_PORT_QMI_FLAG_SUB2);
+
+    switch (ctx->info->service) {
+    case QMI_SERVICE_WDS: {
+        g_autoptr(QmiMessageWdsBindSubscriptionInput) input = NULL;
+
+        input = qmi_message_wds_bind_subscription_input_new ();
+        qmi_message_wds_bind_subscription_input_set_subscription_id (input, QMI_SUBSCRIPTION_TYPE_PRIMARY, NULL);
+        qmi_client_wds_bind_subscription (QMI_CLIENT_WDS (ctx->info->client), input, 10, NULL,
+                                          (GAsyncReadyCallback) bind_subscription_wds_ready, task);
+        return TRUE;
+    }
+    case QMI_SERVICE_VOICE:
+        msg_id = 0x0044;
+        break;
+    case QMI_SERVICE_WMS:
+        msg_id = 0x004C;
+        break;
+    default:
+        return FALSE;
+    }
+
+    {
+        g_autoptr(QmiMessage)        message = NULL;
+        g_autoptr(QmiMessageContext) context = NULL;
+        gsize                        init;
+
+        /* No libqmi API for these: TLV 0x01 u8 subscription (0 primary, 1 secondary) */
+        message = qmi_message_new (ctx->info->service,
+                                   qmi_client_get_cid (ctx->info->client),
+                                   qmi_client_get_next_transaction_id (ctx->info->client),
+                                   msg_id);
+        init = qmi_message_tlv_write_init (message, 0x01, NULL);
+        qmi_message_tlv_write_guint8 (message, secondary ? 1 : 0, NULL);
+        qmi_message_tlv_write_complete (message, init, NULL);
+        context = qmi_message_context_new ();
+        mm_obj_dbg (self, "binding %s client %u to %s subscription",
+                    qmi_service_get_string (ctx->info->service),
+                    qmi_client_get_cid (ctx->info->client),
+                    secondary ? "secondary" : "primary");
+        qmi_device_command_full (self->priv->qmi_device, message, context, 10, NULL,
+                                 (GAsyncReadyCallback) bind_subscription_raw_ready, task);
+    }
+    return TRUE;
+}
