+/*
+ * Runtime refresh-rate switch, prototype: send the same three vendor commands
+ * that xiaomi_fuxi_on() uses, without a full panel power cycle, so the screen
+ * stays lit.  Reached through /sys/kernel/debug/panel-xiaomi-fuxi/rate.
+ * The CRTC timing is *not* touched here: whether the host frame pacing follows
+ * the panel's new rate is exactly what this prototype is meant to find out.
+ */
+static int xiaomi_fuxi_set_rate(struct xiaomi_fuxi_panel *ctx, unsigned int hz)
+{
+	const struct xiaomi_fuxi_rate *rate = NULL;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(xiaomi_fuxi_rates); i++)
+		if (xiaomi_fuxi_rates[i].hz == hz)
+			rate = &xiaomi_fuxi_rates[i];
+	if (!rate)
+		return -EINVAL;
+	if (!ctx->panel.prepared)
+		return -ENODEV;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0x60, rate->reg60);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x30);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xbd, rate->regbd);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x16);
+	mipi_dsi_dcs_write_var_seq_multi(&dsi_ctx, 0xf2, 0x01, rate->regf2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	ctx->rate_hz = hz;
+	return 0;
+}
+
+static ssize_t xiaomi_fuxi_rate_read(struct file *file, char __user *ubuf,
+				     size_t len, loff_t *ppos)
+{
+	struct xiaomi_fuxi_panel *ctx = file->private_data;
+	char buf[16];
+	int n = scnprintf(buf, sizeof(buf), "%u\n", ctx->rate_hz);
+
+	return simple_read_from_buffer(ubuf, len, ppos, buf, n);
+}
+
+static ssize_t xiaomi_fuxi_rate_write(struct file *file,
+				      const char __user *ubuf,
+				      size_t len, loff_t *ppos)
+{
+	struct xiaomi_fuxi_panel *ctx = file->private_data;
+	char buf[8];
+	unsigned int hz;
+	int ret;
+
+	if (!len || len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+	if (kstrtouint(buf, 10, &hz))
+		return -EINVAL;
+
+	ret = xiaomi_fuxi_set_rate(ctx, hz);
+	return ret ? ret : len;
+}
+
+static const struct file_operations xiaomi_fuxi_rate_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = xiaomi_fuxi_rate_read,
+	.write = xiaomi_fuxi_rate_write,
+	.llseek = default_llseek,
+};
+
+static void xiaomi_fuxi_debugfs_remove(void *dir)
+{
+	debugfs_remove_recursive(dir);
+}
+
 static int xiaomi_fuxi_off(struct xiaomi_fuxi_panel *ctx)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
@@ -478,6 +564,15 @@ static int xiaomi_fuxi_probe(struct mipi_dsi_device *dsi)
