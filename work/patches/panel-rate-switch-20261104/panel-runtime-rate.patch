+	if (ctx->debugfs) {
+		debugfs_create_file("rate", 0600, ctx->debugfs, ctx,
+				    &xiaomi_fuxi_rate_fops);
+		devm_add_action_or_reset(dev, xiaomi_fuxi_debugfs_remove,
+					 ctx->debugfs);
+	}
+
 	return devm_mipi_dsi_attach(dev, dsi);
 }
 
