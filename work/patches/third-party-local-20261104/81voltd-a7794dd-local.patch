+	conn->pdh = 0;
+	in = qmi_message_wds_stop_network_input_new();
+	qmi_message_wds_stop_network_input_set_packet_data_handle(in, pdh, NULL);
+	qmi_client_wds_stop_network(conn->wds, in, WDS_TIMEOUT, NULL,
+				    wds_stop_ready, g_object_ref(conn));
+	qmi_message_wds_stop_network_input_unref(in);
