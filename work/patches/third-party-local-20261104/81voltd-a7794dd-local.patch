+
+static void wds_release_client(QVDConnection *conn)
+{
+	if (conn->wds == NULL)
+		return;
+
+	if (conn->wds_ind_sig)
+		g_signal_handler_disconnect(conn->wds, conn->wds_ind_sig);
+	conn->wds_ind_sig = 0;
+	qmi_device_release_client(conn->qmi, QMI_CLIENT(conn->wds),
+				  QMI_DEVICE_RELEASE_CLIENT_FLAGS_RELEASE_CID,
+				  WDS_TIMEOUT, NULL, NULL, NULL);
+	g_clear_object(&conn->wds);
+}
+
+static void wds_report_error(QVDConnection *conn, GError *err, guint sig)
+{
+	g_printerr("WDS sub %u: %s\n", conn->wds_sub, err->message);
+	g_signal_emit(conn, conn_signals[sig], 0, err);
+}
+
+static void wds_set_addr(QVDConnection *conn, gchar *addr)
+{
+	if (g_strcmp0(addr, conn->addr)) {
+		g_signal_emit(conn, conn_signals[ADDR_CHANGED], 0, conn->ip_type, addr);
+		g_free(conn->addr);
+		conn->addr = addr;
+	} else {
+		g_free(addr);
+	}
+}
+
+/*
+ * The PDN is wrong when the modem reports a different APN than requested
+ * (early boot can land the IMS request on the internet PDN). A matching APN
+ * is trusted even with IMCN unset: some networks (China Unicom) do not signal
+ * IMCN for their IMS PDN. IMCN only decides when no APN is reported.
+ */
+static gboolean wds_wrong_pdn(QVDConnection *conn, const gchar *apn,
+			      gboolean has_imcn, gboolean imcn)
+{
+	if (conn->wds_apn != NULL && conn->wds_apn[0] && apn != NULL && apn[0])
+		return g_ascii_strcasecmp(apn, conn->wds_apn) != 0;
+
+	return has_imcn && !imcn;
+}
+
+static gboolean wds_retry_fire(gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+
+	conn->wds_retry_src = 0;
+	if (conn->requested) {
+		g_info("WDS sub %u: retrying start network (attempt %u)\n",
+		       conn->wds_sub, conn->wds_retry_n + 1);
+		wds_start(conn);
+	}
+	return G_SOURCE_REMOVE;
+}
+
+static void wds_retry_later(QVDConnection *conn)
+{
+	guint delay = WDS_RETRY_FIRST_S << MIN(conn->wds_retry_n, 3);
+
+	delay = MIN(delay, WDS_RETRY_MAX_S);
+	conn->wds_retry_n++;
+	g_printerr("WDS sub %u: wrong PDN (not apn %s), stopping it, retry in %u s\n",
+		   conn->wds_sub, conn->wds_apn, delay);
+
+	/* Stop keeps the client because the connection is still requested. */
+	wds_stop(conn);
+	g_clear_handle_id(&conn->wds_retry_src, g_source_remove);
+	conn->wds_retry_src = g_timeout_add_seconds_full(G_PRIORITY_DEFAULT, delay,
+							  wds_retry_fire,
+							  g_object_ref(conn),
+							  g_object_unref);
+}
+
+/*
+ * A reply that arrives for a client or device dropped by
+ * qvd_connection_detach_qmi() belongs to a dead attempt: ignore it so it does
+ * not clobber the state of the new one. Drops the callback's reference.
+ */
+static gboolean wds_stale(QVDConnection *conn, GObject *src)
+{
+	if (src != NULL && (src == G_OBJECT(conn->wds) || src == G_OBJECT(conn->qmi)))
+		return FALSE;
+
+	g_info("WDS sub %u: ignoring reply from a dropped QMI client\n", conn->wds_sub);
+	g_object_unref(conn);
+	return TRUE;
+}
+
+static void wds_settings_ready(GObject *obj, GAsyncResult *res, gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+	QmiMessageWdsGetCurrentSettingsOutput *out;
+	GError *err = NULL;
+	GArray *a6 = NULL;
+	guint32 a4 = 0;
+	guint8 plen = 0;
+	gchar *addr = NULL;
+	const gchar *apn = NULL;
+	gboolean has_apn, has_imcn;
+	gint8 imcn = 0;
+
+	if (wds_stale(conn, obj))
+		return;
+
+	out = qmi_client_wds_get_current_settings_finish(QMI_CLIENT_WDS(obj), res, &err);
+	if (out == NULL || !qmi_message_wds_get_current_settings_output_get_result(out, &err)) {
+		wds_report_error(conn, err, CONNECT_ERR);
+		g_clear_error(&err);
+		goto out;
+	}
+
+	if (conn->ip_type == MM_BEARER_IP_FAMILY_IPV6
+	 && qmi_message_wds_get_current_settings_output_get_ipv6_address(out, &a6, &plen, NULL)
+	 && a6 != NULL && a6->len == 8) {
+		GInetAddress *ia;
+		guint8 b[16];
+		guint i;
+
+		for (i = 0; i < 8; i++) {
+			guint16 w = g_array_index(a6, guint16, i);
+
+			b[2 * i] = w >> 8;
+			b[2 * i + 1] = w & 0xff;
+		}
+		ia = g_inet_address_new_from_bytes(b, G_SOCKET_FAMILY_IPV6);
+		addr = g_inet_address_to_string(ia);
+		g_object_unref(ia);
+	} else if (conn->ip_type == MM_BEARER_IP_FAMILY_IPV4
+		&& qmi_message_wds_get_current_settings_output_get_ipv4_address(out, &a4, NULL)) {
+		addr = g_strdup_printf("%u.%u.%u.%u", a4 >> 24, (a4 >> 16) & 0xff,
+				       (a4 >> 8) & 0xff, a4 & 0xff);
+	}
+
+	has_apn = qmi_message_wds_get_current_settings_output_get_apn_name(out, &apn, NULL);
+	has_imcn = qmi_message_wds_get_current_settings_output_get_imcn_flag(out, &imcn, NULL);
+	{
+		GArray *pd = NULL, *ps = NULL;
+		guint npd = 0, nps = 0;
+
+		if (qmi_message_wds_get_current_settings_output_get_pcscf_domain_name_list(out, &pd, NULL) && pd)
+			npd = pd->len;
+		if (qmi_message_wds_get_current_settings_output_get_pcscf_server_address_list(out, &ps, NULL) && ps)
+			nps = ps->len;
+		g_info("WDS sub %u: connected, pdh 0x%08x, addr %s, apn %s, imcn %s, pcscf v4 %u domains %u\n",
+		       conn->wds_sub, conn->pdh, addr ? addr : "(none)",
+		       has_apn && apn ? apn : "?", has_imcn ? (imcn ? "1" : "0") : "?",
+		       nps, npd);
+	}
+
+	if (wds_wrong_pdn(conn, has_apn ? apn : NULL, has_imcn, imcn)) {
+		g_free(addr);
+		wds_retry_later(conn);
+		goto out;
+	}
+	conn->wds_retry_n = 0;
+	if (addr != NULL)
+		wds_set_addr(conn, addr);
+
+out:
+	if (out != NULL)
+		qmi_message_wds_get_current_settings_output_unref(out);
+	g_object_unref(conn);
+}
+
+static void wds_query_settings(QVDConnection *conn)
+{
+	QmiMessageWdsGetCurrentSettingsInput *in;
+
+	in = qmi_message_wds_get_current_settings_input_new();
+	qmi_message_wds_get_current_settings_input_set_requested_settings(in,
+		QMI_WDS_REQUESTED_SETTINGS_IP_ADDRESS | QMI_WDS_REQUESTED_SETTINGS_IP_FAMILY
+		| QMI_WDS_REQUESTED_SETTINGS_APN_NAME | QMI_WDS_REQUESTED_SETTINGS_IMCN_FLAG
+		| QMI_WDS_REQUESTED_SETTINGS_PCSCF_SERVER_ADDRESS_LIST
+		| QMI_WDS_REQUESTED_SETTINGS_PCSCF_DOMAIN_NAME_LIST,
+		NULL);
+	qmi_client_wds_get_current_settings(conn->wds, in, WDS_TIMEOUT, NULL,
+					    wds_settings_ready, g_object_ref(conn));
+	qmi_message_wds_get_current_settings_input_unref(in);
+}
+
+static void wds_on_packet_status(QmiClientWds *client,
+				 QmiIndicationWdsPacketServiceStatusOutput *out,
+				 gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+	QmiWdsConnectionStatus st;
+	gboolean reconf;
+
+	if (!qmi_indication_wds_packet_service_status_output_get_connection_status(out, &st, &reconf, NULL))
+		return;
+
+	g_info("WDS sub %u: packet service status %s\n", conn->wds_sub,
+	       qmi_wds_connection_status_get_string(st));
+
+	if (st == QMI_WDS_CONNECTION_STATUS_DISCONNECTED) {
+		/*
+		 * Report the loss and wait: the IMS stack in the modem asks for a
+		 * new connection itself, as it does for the ModemManager bearer.
+		 */
+		conn->pdh = 0;
+		wds_set_addr(conn, NULL);
+	} else if (st == QMI_WDS_CONNECTION_STATUS_CONNECTED && reconf && conn->pdh) {
+		wds_query_settings(conn);
+	}
+}
+
+static void wds_start_ready(GObject *obj, GAsyncResult *res, gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+	QmiMessageWdsStartNetworkOutput *out;
+	GError *err = NULL;
+
+	if (wds_stale(conn, obj))
+		return;
+
+	conn->wds_busy = FALSE;
+	out = qmi_client_wds_start_network_finish(QMI_CLIENT_WDS(obj), res, &err);
+	if (out == NULL || !qmi_message_wds_start_network_output_get_result(out, &err)) {
+		QmiWdsVerboseCallEndReasonType vt;
+		gint16 vr;
+
+		if (out != NULL
+		 && qmi_message_wds_start_network_output_get_verbose_call_end_reason(out, &vt, &vr, NULL))
+			g_printerr("WDS sub %u: call end reason: %s\n", conn->wds_sub,
+				   qmi_wds_verbose_call_end_reason_get_string(vt, vr));
+		wds_report_error(conn, err, CONNECT_ERR);
+		g_clear_error(&err);
+		goto out;
+	}
+
+	qmi_message_wds_start_network_output_get_packet_data_handle(out, &conn->pdh, NULL);
+	if (!conn->requested) {
+		/* Stop arrived while we were connecting. */
+		wds_stop(conn);
+		goto out;
+	}
+	wds_query_settings(conn);
+
+out:
+	if (out != NULL)
+		qmi_message_wds_start_network_output_unref(out);
+	/* Stopped before it ever connected: nothing to tear down but the client. */
+	if (!conn->requested && conn->pdh == 0)
+		wds_release_client(conn);
+	g_object_unref(conn);
+}
+
+static void wds_start_network(QVDConnection *conn)
+{
+	QmiMessageWdsStartNetworkInput *in;
+
+	in = qmi_message_wds_start_network_input_new();
+	if (conn->wds_apn != NULL && conn->wds_apn[0])
+		qmi_message_wds_start_network_input_set_apn(in, conn->wds_apn, NULL);
+	/* The modem's profile is IPv4v6 but rejects IPv6 + profile with
+	 * PDN_IPV6_CALL_DISALLOWED; the APN alone works, so the profile is only a
+	 * fallback. */
+	if (conn->wds_profile != 0xffff && (conn->wds_apn == NULL || !conn->wds_apn[0]))
+		qmi_message_wds_start_network_input_set_profile_index_3gpp(in, conn->wds_profile, NULL);
+	qmi_message_wds_start_network_input_set_ip_family_preference(in,
+		conn->ip_type == MM_BEARER_IP_FAMILY_IPV6 ? QMI_WDS_IP_FAMILY_IPV6 : QMI_WDS_IP_FAMILY_IPV4,
+		NULL);
+
+	g_info("WDS sub %u: start network apn %s profile %u\n", conn->wds_sub,
+	       conn->wds_apn ? conn->wds_apn : "", conn->wds_profile);
+	qmi_client_wds_start_network(conn->wds, in, WDS_TIMEOUT * 2, NULL,
+				     wds_start_ready, g_object_ref(conn));
+	qmi_message_wds_start_network_input_unref(in);
+}
+
+static void wds_ip_family_ready(GObject *obj, GAsyncResult *res, gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+	QmiMessageWdsSetIpFamilyOutput *out;
+	GError *err = NULL;
+
+	if (wds_stale(conn, obj))
+		return;
+
+	out = qmi_client_wds_set_ip_family_finish(QMI_CLIENT_WDS(obj), res, &err);
+	if (out == NULL || !qmi_message_wds_set_ip_family_output_get_result(out, &err)) {
+		/* Not fatal: start network also carries the IP family preference. */
+		g_info("WDS sub %u: set ip family: %s\n", conn->wds_sub, err->message);
+		g_clear_error(&err);
+	}
+	if (out != NULL)
+		qmi_message_wds_set_ip_family_output_unref(out);
+
+	wds_start_network(conn);
+	g_object_unref(conn);
+}
+
+static void wds_bind_ready(GObject *obj, GAsyncResult *res, gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+	QmiMessageWdsBindSubscriptionOutput *out;
+	QmiMessageWdsSetIpFamilyInput *in;
+	GError *err = NULL;
+
+	if (wds_stale(conn, obj))
+		return;
+
+	out = qmi_client_wds_bind_subscription_finish(QMI_CLIENT_WDS(obj), res, &err);
+	if (out == NULL || !qmi_message_wds_bind_subscription_output_get_result(out, &err)) {
+		conn->wds_busy = FALSE;
+		wds_report_error(conn, err, CONNECT_ERR);
+		g_clear_error(&err);
+		/* Drop the client so the next attempt binds a fresh one. */
+		wds_release_client(conn);
+		goto out;
+	}
+
+	g_info("WDS sub %u: client bound\n", conn->wds_sub);
+	conn->wds_ind_sig = g_signal_connect(conn->wds, "packet-service-status",
+					     G_CALLBACK(wds_on_packet_status), conn);
+
+	in = qmi_message_wds_set_ip_family_input_new();
+	qmi_message_wds_set_ip_family_input_set_preference(in,
+		conn->ip_type == MM_BEARER_IP_FAMILY_IPV6 ? QMI_WDS_IP_FAMILY_IPV6 : QMI_WDS_IP_FAMILY_IPV4,
+		NULL);
+	qmi_client_wds_set_ip_family(conn->wds, in, WDS_TIMEOUT, NULL,
+				     wds_ip_family_ready, g_object_ref(conn));
+	qmi_message_wds_set_ip_family_input_unref(in);
+
+out:
+	if (out != NULL)
+		qmi_message_wds_bind_subscription_output_unref(out);
+	g_object_unref(conn);
+}
+
+static void wds_mux_ready(GObject *obj, GAsyncResult *res, gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+	QmiMessageWdsBindMuxDataPortOutput *out;
+	QmiMessageWdsBindSubscriptionInput *in;
+	GError *err = NULL;
+
+	if (wds_stale(conn, obj))
+		return;
+
+	out = qmi_client_wds_bind_mux_data_port_finish(QMI_CLIENT_WDS(obj), res, &err);
+	if (out == NULL || !qmi_message_wds_bind_mux_data_port_output_get_result(out, &err)) {
+		conn->wds_busy = FALSE;
+		wds_report_error(conn, err, CONNECT_ERR);
+		g_clear_error(&err);
+		wds_release_client(conn);
+		goto out;
+	}
+
+	/* Bind Mux Data Port resets the client's subscription to the default
+	 * one, so the subscription must be bound after it. */
+	in = qmi_message_wds_bind_subscription_input_new();
+	qmi_message_wds_bind_subscription_input_set_subscription_id(in,
+		(QmiSubscriptionType) conn->wds_sub, NULL);
+	qmi_client_wds_bind_subscription(conn->wds, in, WDS_TIMEOUT, NULL,
+					 wds_bind_ready, g_object_ref(conn));
+	qmi_message_wds_bind_subscription_input_unref(in);
+
+out:
+	if (out != NULL)
+		qmi_message_wds_bind_mux_data_port_output_unref(out);
+	g_object_unref(conn);
+}
+
+static void wds_alloc_ready(GObject *obj, GAsyncResult *res, gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+	QmiMessageWdsBindMuxDataPortInput *in;
+	GError *err = NULL;
+	QmiClient *client;
+
+	if (wds_stale(conn, obj))
+		return;
+
+	client = qmi_device_allocate_client_finish(QMI_DEVICE(obj), res, &err);
+	if (client == NULL) {
+		conn->wds_busy = FALSE;
+		wds_report_error(conn, err, CONNECT_ERR);
+		g_clear_error(&err);
+		g_object_unref(conn);
+		return;
+	}
+
+	conn->wds = QMI_CLIENT_WDS(client);
+
+	/* IPA is the embedded endpoint, interface 1 (as in ModemManager). */
+	in = qmi_message_wds_bind_mux_data_port_input_new();
+	qmi_message_wds_bind_mux_data_port_input_set_endpoint_info(in,
+		QMI_DATA_ENDPOINT_TYPE_EMBEDDED, 1, NULL);
+	qmi_message_wds_bind_mux_data_port_input_set_mux_id(in,
+		WDS_MUX_ID_BASE + conn->wds_sub, NULL);
+	qmi_client_wds_bind_mux_data_port(conn->wds, in, WDS_TIMEOUT, NULL,
+					  wds_mux_ready, conn);
+	qmi_message_wds_bind_mux_data_port_input_unref(in);
+}
+
+static void wds_start(QVDConnection *conn)
+{
+	/* The QMI device may still be opening; attach_qmi() retries. */
+	if (conn->qmi == NULL || conn->wds_busy || conn->pdh != 0)
+		return;
+
+	/* busy covers allocate → mux → bind → set ip family → start network */
+	conn->wds_busy = TRUE;
+	if (conn->wds == NULL)
+		qmi_device_allocate_client(conn->qmi, QMI_SERVICE_WDS, QMI_CID_NONE,
