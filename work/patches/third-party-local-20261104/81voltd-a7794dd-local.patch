+	if (wds_stale(conn, obj))
+		return;
+
+	out = qmi_client_wds_stop_network_finish(QMI_CLIENT_WDS(obj), res, &err);
+	if (out == NULL || !qmi_message_wds_stop_network_output_get_result(out, &err)) {
+		if (!g_error_matches(err, QMI_PROTOCOL_ERROR, QMI_PROTOCOL_ERROR_NO_EFFECT))
+			wds_report_error(conn, err, DISCONNECT_ERR);
+		g_clear_error(&err);
+	} else {
+		g_info("WDS sub %u: network stopped\n", conn->wds_sub);
