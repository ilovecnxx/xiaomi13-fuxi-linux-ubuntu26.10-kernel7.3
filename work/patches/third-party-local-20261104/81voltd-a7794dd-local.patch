+/*
+ * The QMI device died (qmi-proxy went down with ModemManager): the client,
+ * its CID and the PDN behind it are gone with it, so drop them without
+ * talking to the device. The connection stays requested and comes back up
+ * when attach_qmi() hands it a new device.
+ */
+void qvd_connection_detach_qmi(QVDConnection *conn)
+{
+	g_assert(conn->is_wds);
+
+	g_printerr("WDS sub %u: QMI device lost, forgetting client\n", conn->wds_sub);
+	g_clear_handle_id(&conn->wds_retry_src, g_source_remove);
+	conn->wds_retry_n = 0;
+	if (conn->wds != NULL && conn->wds_ind_sig)
+		g_signal_handler_disconnect(conn->wds, conn->wds_ind_sig);
+	conn->wds_ind_sig = 0;
+	g_clear_object(&conn->wds);
+	g_clear_object(&conn->qmi);
+	conn->pdh = 0;
+	conn->wds_busy = FALSE;
+	wds_set_addr(conn, NULL);
+}
+
+void qvd_connection_attach_qmi(QVDConnection *conn, QmiDevice *qmi)
+{
+	g_assert(conn->is_wds);
+
+	/* A stale device left over from a dead proxy: start over on the new one. */
+	if (conn->qmi != NULL && conn->qmi != qmi)
+		qvd_connection_detach_qmi(conn);
+
+	if (conn->qmi == NULL)
+		conn->qmi = g_object_ref(qmi);
+
+	if (conn->requested)
+		wds_start(conn);
 }
