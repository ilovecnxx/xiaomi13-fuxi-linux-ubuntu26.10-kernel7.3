+/* fuxi: Android-style bars. QMI NR5G quality above is MIN(rsrp, snr, rsrq) and LTE uses
+ * wideband RSSI, which gives ~45-50% even at RSRP -65 dBm; use the serving cell RSRP
+ * instead (-125 dBm -> 0%, -75 dBm -> 100%), the higher of LTE / NR5G. */
+#define FUXI_RSRP_Q_MIN -125
+#define FUXI_RSRP_Q_MAX -75
+
+static gboolean
+fuxi_rsrp_quality (MMBroadbandModemQmi *self,
+                   gint16               lte_rsrp,
+                   gint16               nr5g_rsrp,
+                   guint8              *out_quality)
+{
+    gint16 best = G_MININT16;
+
+    if (lte_rsrp <= RSRP_MAX && lte_rsrp >= RSRP_MIN)
+        best = MAX (best, lte_rsrp);
+    if (nr5g_rsrp <= RSRP_MAX && nr5g_rsrp >= RSRP_MIN)
+        best = MAX (best, nr5g_rsrp);
+    if (best == G_MININT16)
+        return FALSE;
+    *out_quality = (guint8) ((CLAMP (best, FUXI_RSRP_Q_MIN, FUXI_RSRP_Q_MAX) - FUXI_RSRP_Q_MIN) * 100 /
+                             (FUXI_RSRP_Q_MAX - FUXI_RSRP_Q_MIN));
+    mm_obj_dbg (self, "fuxi: RSRP (LTE %d, 5G %d) dBm --> %u%%", lte_rsrp, nr5g_rsrp, *out_quality);
+    return TRUE;
+}
