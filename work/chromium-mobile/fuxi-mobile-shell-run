#!/bin/bash
# 启动 fuxi mobile Chromium 外壳：先探测当前图形会话的 Wayland socket。
# Phosh 用 wayland-0，Denial 用 wayland-1（2026-11-07）；phoc 被 SIGKILL 后残留的
# wayland-0 是死 socket，必须跳过，否则 Chromium 会：
#   Failed to connect to Wayland display -> Failed to initialize Wayland platform。
set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/1000/bus}"
export DISPLAY="${DISPLAY:-:0}"

wayland_ok() {
  local d="${1:-}" dir="${XDG_RUNTIME_DIR:-/run/user/1000}"
  [ -n "$d" ] && [ -S "$dir/$d" ] || return 1
  command -v ss >/dev/null 2>&1 || return 0
  ss -xl 2>/dev/null | grep -qF "$dir/$d"
}
find_wayland_display() {
  local dir="${XDG_RUNTIME_DIR:-/run/user/1000}" cand
  for cand in "$dir"/wayland-*; do
    case "$cand" in *.lock) continue ;; esac
    [ -S "$cand" ] || continue
    if command -v ss >/dev/null 2>&1; then
      ss -xl 2>/dev/null | grep -qF "$cand" || continue
    fi
    printf '%s\n' "$(basename "$cand")"
    return 0
  done
  return 1
}
if ! wayland_ok "${WAYLAND_DISPLAY:-}"; then
  WAYLAND_DISPLAY="$(find_wayland_display || true)"
fi
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export FUXI_FORCE_LIGHT="${FUXI_FORCE_LIGHT:-1}"
export FUXI_HOME="${FUXI_HOME:-https://www.example.com}"
exec /usr/bin/python3 -u /opt/chromium/mobile/fuxi-mobile-shell.py
