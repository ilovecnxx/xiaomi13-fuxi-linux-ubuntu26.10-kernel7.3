# fuxi 的 U-Boot 默认环境（取代 board/qualcomm/qcom-phone.env），scripts/fuxi-build-uboot.sh 用。
# 原则：U-Boot 里不做写盘操作（无 UMS、无 fastboot flash、无 capsule、无 saveenv），唯一例外是下面受保护的启动计数块。
# 根分区 sda33 = LUN0 第 33 分区；U-Boot 分区号是十六进制 → scsi 0:21
bootdelay=0
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
setenv stdout serial,vidconsole,usbacm; \
setenv stderr serial,vidconsole,usbacm; \
echo Enabled U-Boot console serial gadget

# 开机：自动 sysboot /boot/extlinux/extlinux.conf（fuxi-kernel-install 生成；菜单 3 s，音量键选条目）。
# 开机时按住音量下 → U-Boot 菜单；extlinux 失败 → 停在错误信息（按键继续）→ U-Boot 菜单。
# 手动兜底：菜单里 booti 固定条目（不依赖 extlinux.conf；cmdline 写在这里，和 /etc/kernel/cmdline 一致，root 用分区 PARTUUID）
# deb3 起内核要 initramfs-tools initrd：initrd 最后 load，${filesize} 就是它的大小
fuxi_root=scsi 0:21
fuxi_entry=7.4.0-rc1-fuxi-deb3
fuxi_dtb=sm8550-xiaomi-fuxi.dtb
fuxi_args=root=PARTUUID=7f2e6802-83d9-47e7-9011-8bc643debd36 ro rootwait loglevel=7 log_buf_len=2M arm-smmu.disable_bypass=0 fbcon=font:TER16x32 console=tty0 fuxi.fb=0xB8000000,1080,2400,1080,32 g_cdc.idVendor=0x0525 g_cdc.idProduct=0xa4a7 g_cdc.dev_addr=02:f0:c5:13:00:02 g_cdc.host_addr=02:f0:c5:13:00:01 panel_xiaomi_fuxi.refresh=120 fw_devlink.sync_state=timeout deferred_probe_timeout=30 panic=10
boot_fuxi=scsi scan; \
setenv bootargs "${fuxi_args} fuxi.entry=${fuxi_entry} fuxi.uboot=1 fuxi.boot=manual"; \
load ${fuxi_root} ${kernel_addr_r} /boot/fuxi/${fuxi_entry}/Image && \
load ${fuxi_root} ${fdt_addr_r} /boot/fuxi/${fuxi_entry}/${fuxi_dtb} && \
load ${fuxi_root} ${ramdisk_addr_r} /boot/fuxi/${fuxi_entry}/initrd.img && \
booti ${kernel_addr_r} ${ramdisk_addr_r}:${filesize} ${fdt_addr_r}; pause
# 标准引导：/boot/extlinux/extlinux.conf（由 fuxi-kernel-install 生成）
boot_ext=scsi scan; sysboot ${fuxi_root} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf; pause
boot_fb=sysboot ${fuxi_root} any ${pxefile_addr_r} /boot/extlinux/fallback.conf

# 启动计数（自动回退）。U-Boot 唯一的写盘操作：原地改写 /boot/fuxi/bootcount 的那一个 4 KiB 数据块
# （格式见 scripts/fuxi-boot/fuxi-bootcount）。写之前必须全部满足：分区 0:21 的 PARTUUID 对、文件经 ext4 读出 4096 字节、
# 魔数 FXBC、块号在分区内、按块号裸读的内容和文件内容逐字节相同；写后读回比较。pending=0（已确认）时不写。
fuxi_partuuid=7f2e6802-83d9-47e7-9011-8bc643debd36
bc_limit=2
bc_load=setenv bc_ok 0; setenv bc_pend 0; setenv bc_tries 0; \
setexpr bc_a ${kernel_addr_r} + 0; setexpr bc_b ${bc_a} + 1000; setexpr bc_c ${bc_a} + 2000; \
part uuid scsi 0:21 bc_uuid && test "${bc_uuid}" = "${fuxi_partuuid}" && \
load ${fuxi_root} ${bc_a} /boot/fuxi/bootcount && test "${filesize}" = "1000" && \
setexpr.l bc_m *${bc_a} && test "${bc_m}" = "43425846" && \
setexpr bc_t ${bc_a} + 4 && setexpr.l bc_off *${bc_t} && \
part start scsi 0 0x21 bc_ps && part size scsi 0 0x21 bc_psz && \
test 0x${bc_off} -gt 0 && test 0x${bc_off} -lt 0x${bc_psz} && \
setexpr bc_lba ${bc_ps} + ${bc_off} && scsi dev 0 && scsi read ${bc_b} ${bc_lba} 1 && \
cmp.b ${bc_a} ${bc_b} 1000 && \
setexpr bc_t ${bc_a} + 8 && setexpr.b bc_pend *${bc_t} && \
setexpr bc_t ${bc_a} + 9 && setexpr.b bc_tries *${bc_t} && setenv bc_ok 1; \
echo "bootcount: ok=${bc_ok} pending=${bc_pend} tries=${bc_tries}"
bc_bump=setexpr bc_n ${bc_tries} + 1; setexpr bc_t ${bc_b} + 9; mw.b ${bc_t} ${bc_n}; \
scsi write ${bc_b} ${bc_lba} 1 && scsi read ${bc_c} ${bc_lba} 1 && cmp.b ${bc_b} ${bc_c} 1000 && \
echo "bootcount: tries -> ${bc_n}"

boot_auto=scsi scan; run bc_load; \
if test "${bc_ok}" = 1 && test "${bc_pend}" != 0; then \
if test 0x${bc_tries} -ge ${bc_limit}; then \
echo "default entry not confirmed after ${bc_tries} boots -> fallback.conf"; run boot_fb; \
else run bc_bump; fi; \
fi; \
sysboot ${fuxi_root} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf; \
echo "extlinux.conf failed -> fallback.conf"; run boot_fb; \
echo "fallback.conf failed too"; pause; run menucmd

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootcmd=run boot_auto

bootmenu_0=Boot extlinux.conf=run boot_ext
bootmenu_1=Boot ${fuxi_entry} (booti, no extlinux)=run boot_fuxi
bootmenu_2=UFS read-only probe=scsi scan; part list scsi 0; ls ${fuxi_root} /boot; pause
bootmenu_8=Boot fallback.conf=scsi scan; run boot_fb; pause
bootmenu_9=Show boot count (read-only)=scsi scan; run bc_load; pause
bootmenu_3=Reset (-> Android)=reset
bootmenu_4=Power off=poweroff
bootmenu_5=Board info=bdinfo; pause
bootmenu_6=Dump environment=printenv; pause
bootmenu_7=Enable serial console gadget=run serial_gadget

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
