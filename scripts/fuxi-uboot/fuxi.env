# fuxi 的 U-Boot 默认环境（取代 board/qualcomm/qcom-phone.env），scripts/fuxi-build-uboot.sh 用。
# 原则：U-Boot 里不做任何写盘操作（无 UMS、无 fastboot flash、无 capsule、无 saveenv）。
# 根分区 sda33 = LUN0 第 33 分区；U-Boot 分区号是十六进制 → scsi 0:21
bootdelay=0
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
setenv stdout serial,vidconsole,usbacm; \
setenv stderr serial,vidconsole,usbacm; \
echo Enabled U-Boot console serial gadget

# 开机：自动 sysboot /boot/extlinux/extlinux.conf（fuxi-kernel-install 生成；菜单 3 s，音量键选条目）。
# 开机时按住音量下 → U-Boot 菜单；extlinux 失败 → 停在错误信息（按键继续）→ U-Boot 菜单。
# 手动兜底：菜单里 booti 固定条目（不依赖 extlinux.conf；cmdline 写在这里）
fuxi_root=scsi 0:21
fuxi_entry=7.4.0-rc1-fuxi-deb2
fuxi_dtb=sm8550-xiaomi-fuxi-r120idle-mic-rupdclk-modem-audio-disp-usbc-dp.dtb
fuxi_args=loglevel=7 log_buf_len=2M arm-smmu.disable_bypass=0 fbcon=font:TER16x32 console=tty0 fuxi.fb=0xB8000000,1080,2400,1080,32 g_cdc.idVendor=0x0525 g_cdc.idProduct=0xa4a7 g_cdc.dev_addr=02:f0:c5:13:00:02 g_cdc.host_addr=02:f0:c5:13:00:01 panel_xiaomi_fuxi.refresh=120 fw_devlink.sync_state=timeout deferred_probe_timeout=30 panic=10
boot_fuxi=scsi scan; \
setenv bootargs "${fuxi_args} fuxi.entry=${fuxi_entry} fuxi.uboot=1"; \
load ${fuxi_root} ${kernel_addr_r} /boot/fuxi/${fuxi_entry}/Image && \
load ${fuxi_root} ${fdt_addr_r} /boot/fuxi/${fuxi_entry}/${fuxi_dtb} && \
booti ${kernel_addr_r} - ${fdt_addr_r}; pause
# 标准引导：/boot/extlinux/extlinux.conf（由 fuxi-kernel-install 生成）
boot_ext=scsi scan; sysboot ${fuxi_root} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf; pause
boot_auto=scsi scan; sysboot ${fuxi_root} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf; \
echo "extlinux 引导失败"; pause; run menucmd

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootcmd=run boot_auto

bootmenu_0=Boot extlinux.conf=run boot_ext
bootmenu_1=Boot ${fuxi_entry} (booti, no extlinux)=run boot_fuxi
bootmenu_2=UFS read-only probe=scsi scan; part list scsi 0; ls ${fuxi_root} /boot; pause
bootmenu_3=Reset (-> Android)=reset
bootmenu_4=Power off=poweroff
bootmenu_5=Board info=bdinfo; pause
bootmenu_6=Dump environment=printenv; pause
bootmenu_7=Enable serial console gadget=run serial_gadget

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
