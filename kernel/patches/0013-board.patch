diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-sleep.dtsi b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-sleep.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..6affd25a42334658b74f32c7d1c3c7c4ee5c33da
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-sleep.dtsi
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13 (fuxi)：省电测试片段——去掉 cpuidle.off=1（让 CPU 进 PSCI 深度空闲/集群断电），
+ * 配合 FUXI_PM=1 + 变体配置里的 SUSPEND（s2idle）。其余启动参数与主 DTS 相同（长度保持一致）。
+ * 风险：M2 阶段为排除问题才关掉 cpuidle；如果空闲时卡死/重启，长按电源回 Android，日志看 pstore。
+ */
+
+/ {
+	chosen {
+		bootargs = "loglevel=7 log_buf_len=2M panic=0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused arm-smmu.disable_bypass=0 fbcon=font:TER16x32 console=tty0 fuxi.fb=0xB8000000,1080,2400,1080,32 rdinit=/init g_cdc.idVendor=0x0525 g_cdc.idProduct=0xa4a7 g_cdc.dev_addr=02:f0:c5:13:00:02 g_cdc.host_addr=02:f0:c5:13:00:01                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              ";
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi.dts b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi.dts
new file mode 100644
index 0000000000000000000000000000000000000000..6c05b3700273b9ce6451806d3d844d1dac183bc4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi.dts
@@ -0,0 +1,1413 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Xiaomi 13 (fuxi) board DTS.
+ *
+ * Consolidated from sm8550-xiaomi-fuxi-min.dts plus the disp, audio, audio2,
+ * modem and usbc fragments and the DisplayPort controller (USB-C DP alt mode);
+ * compiles to the same tree as the daily
+ * sm8550-xiaomi-fuxi-r120idle-mic-rupdclk-modem-audio-disp-usbc-dp.dtb
+ * except that /chosen/bootargs is gone: the kernel command line now comes
+ * from the bootloader (U-Boot extlinux).  Camera and system-sleep bits stay in
+ * sm8550-xiaomi-fuxi-{camera,sleep}.dtsi as optional overlays-by-include.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8550.dtsi"
+#include "pm8010.dtsi"
+#include "pm8550.dtsi"
+#include "pm8550b.dtsi"
+#define PMK8550VE_SID 5
+#include "pm8550ve.dtsi"
+#include "pm8550vs.dtsi"
+#include "pmk8550.dtsi"
+#include "pmr735d_a.dtsi"
+
+
+/ {
+	model = "Xiaomi 13 (fuxi) minimal";
+	compatible = "xiaomi,fuxi", "qcom,sm8550";
+	chassis-type = "handset";
+
+	/* ABL 按这两项从 boot 镜像里挑 DTB（值取自厂商 fuxi DTB）；没有它们 ABL 报 Load Error */
+	qcom,msm-id = <519 0x20000>, <536 0x20000>;
+	qcom,board-id = <0x10008 0>;
+
+	/* 音量上：PM8550 GPIO6，低有效（厂商 DTB gpio_keys/vol_up；与 sm8550-qrd 相同） */
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&volume_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * 电池/充电：ADSP 上的 battmgr 经 pmic_glink 暴露电量与充电状态。
+	 * 暂不接 USB-C connector（不编 UCSI），USB 保持固定 peripheral，免得 ADSP 切换角色断开 USB 网络。
+	 */
+	pmic-glink {
+		compatible = "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
+	aliases {
+		serial1 = &uart14;
+	};
+
+	/*
+	 * WiFi/蓝牙：WCN7850（Kiwi）。引脚与 sm8550-qrd 完全相同（厂商 DTB cnss/bt_kiwi：
+	 * wlan-en GPIO80、bt-en GPIO81、sw-ctrl GPIO82；PCIe0 perst GPIO94、wake GPIO96），
+	 * 供电对应关系同 QRD（只是 fuxi DTS 里的标签名不同）。
+	 */
+	wcn7850-pmu {
+		compatible = "qcom,wcn7850-pmu";
+
+		pinctrl-0 = <&wlan_en>, <&bt_default>, <&pmk8550_sleep_clk>;
+		pinctrl-names = "default";
+
+		wlan-enable-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+
+		vdd-supply = <&vreg_s5g_0p8>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		vddaon-supply = <&vreg_s2g_0p8>;
+		vdddig-supply = <&vreg_s4e_0p9>;
+		vddrfa1p2-supply = <&vreg_s4g_1p3>;
+		vddrfa1p8-supply = <&vreg_s6g_1p8>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
