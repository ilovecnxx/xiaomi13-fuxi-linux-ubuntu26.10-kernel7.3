+ * fuxi 只有一颗 PM8010（USID 0xc）、一颗 PMR735D（0xa）：0xb/0xd 不存在（cmd-db 里也没有
+ * PMIC "n" 的资源），probe 会报 spmi 通道错误并打调用栈。pmr735d_b.dtsi 不包含；pm8010.dtsi
+ * 里的第二颗关掉，连同它的温度区。
+ */
+&pm8010_n {
+	status = "disabled";
+};
+
+/ {
+	thermal-zones {
+		/delete-node/ pm8010-n-thermal;
+	};
+};
+
+/*
+ * ===== USB-C: dwc3 dual-role (OTG) + USB3 through the QMP USB4/DP combo PHY =====
+ * Role and orientation come from pmic_glink (ADSP); see the USB-C section below.
+ */
+&usb_1 {
+	dr_mode = "otg";
+	phys = <&usb_1_hsphy>, <&usb_dp_qmpphy QMP_USB43DP_USB3_PHY>;
+	phy-names = "usb2-phy", "usb3-phy";
+	status = "okay";
+};
+
+&usb_1_hsphy {
+	vdd-supply = <&vreg_l1e_0p88>;
+	vdda12-supply = <&vreg_l3e_1p2>;
+
+	phys = <&pm8550b_eusb2_repeater>;
+
+	status = "okay";
+};
+
+/* repeater 在 PM8550B 上（SPMI 总线），供电同 sm8550-qrd */
+&pm8550b_eusb2_repeater {
+	vdd18-supply = <&vreg_l15b_1p8>;
+	vdd3-supply = <&vreg_l5b_3p1>;
+};
+
+&usb_dp_qmpphy {
+	vdda-phy-supply = <&vreg_l3f_0p91>;
+	vdda-pll-supply = <&vreg_l3e_1p2>;
+
+	status = "okay";
+};
+
+/*
+ * ===== UFS（M3）=====
+ * 与 Android 实时 DTB（work/device-info/fuxi-live.dts，ufshc@1d84000）逐项核对过：
+ * vcc=pm_humu_l17(l17b 2.504V)/1.3A、vccq=pm_v6g_l1(l1g)/1.2A、reset GPIO 210；
+ * PHY vdda-phy=l1d、vdda-pll=l3e。与 sm8550-mtp 相同。
+ */
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
+	vcc-supply = <&vreg_l17b_2p5>;
+	vcc-max-microamp = <1300000>;
+	vccq-supply = <&vreg_l1g_1p2>;
+	vccq-max-microamp = <1200000>;
+	vdd-hba-supply = <&vreg_l3g_1p2>;
+
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l1d_0p88>;
+	vdda-pll-supply = <&vreg_l3e_1p2>;
+
+	status = "okay";
+};
+
+/* 电源键与音量下（PMK8550 PON 的 resin），同 sm8550-qrd */
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+
+	status = "okay";
+};
+
+&pm8550_gpios {
+	volume_up_n: volume-up-n-state {
+		pins = "gpio6";
+		function = "normal";
+		power-source = <1>;
+		bias-pull-up;
+		input-enable;
+	};
+};
+
+/*
+ * 触摸屏：ST FTM5（SPI，QUP0 SE4 = spi4，GPIO44-47），驱动 drivers/input/touchscreen/st-ftm5.c。
+ * 取自厂商 DTB spi@a90000/fts@0："st,spi"、12 MHz、irq GPIO25 低电平、reset GPIO24（拉低复位）、
+ * vdd = l12b（pm_humu_l12）、avdd = l6m（pm8010m_l6）。坐标是 1/10 像素（1080x2400 屏）。
+ */
+&gpi_dma1 {
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&spi4 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "st,ftm5";
+		reg = <0>;
+		spi-max-frequency = <12000000>;
+
+		interrupts-extended = <&tlmm 25 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+
+		vdd-supply = <&vreg_l12b_1p8>;
+		avdd-supply = <&vreg_l6m_3p2>;
+
+		pinctrl-0 = <&ts_default>;
+		pinctrl-names = "default";
+
+		touchscreen-size-x = <10800>;
+		touchscreen-size-y = <24000>;
+	};
+};
+
+&pcie0 {
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+
+	status = "okay";
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l1e_0p88>;
+	vdda-pll-supply = <&vreg_l3e_1p2>;
+
+	status = "okay";
+};
+
+&pcie0_port0 {
+	reset-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
+
+	wifi@0 {
+		compatible = "pci17cb,1107";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+	};
+};
+
+/* QUP2（0x8c0000，主线叫 qupv3_id_1）：uart14 蓝牙、i2c8 扬声器功放都在它下面 */
+&qupv3_id_1 {
+	status = "okay";
+};
+
+&uart14 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn7850-bt";
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+
+		max-speed = <3200000>;
+	};
+};
+
+&pmk8550_gpios {
+	pmk8550_sleep_clk: sleep-clk-state {
+		pins = "gpio3";
+		function = "func1";
+		input-disable;
+		output-enable;
+		bias-disable;
+		power-source = <0>;
+	};
+};
+
+&xo_board {
+	clock-frequency = <76800000>;
+};
+
+&sleep_clk {
+	clock-frequency = <32000>;
+};
+
+/*
+ * GPIO 32-39 归 TrustZone（厂商 kalama DTB: qcom,gpios-reserved = <32..39>）。
+ * 缺这一行时 TLMM probe 读这些引脚的寄存器触发 XPU 违规：黑屏 + 整机卡死 + 看门狗复位。
+ */
+&tlmm {
+	gpio-reserved-ranges = <32 8>;
+
+	bt_default: bt-default-state {
+		bt-en-pins {
+			pins = "gpio81";
+			function = "gpio";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		sw-ctrl-pins {
+			pins = "gpio82";
+			function = "gpio";
+			bias-pull-down;
+		};
+	};
+
+	wlan_en: wlan-en-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+
+	/* 厂商 mi_ts_active：GPIO24（reset）、GPIO25（irq），上拉、8 mA */
+	ts_default: ts-default-state {
+		pins = "gpio24", "gpio25";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+};
+
+/*
+ * ADSP：固件从 Android 的 /vendor/firmware_mnt/image 复制（adsp.mdt + .bNN、adsp_dtb.mdt + .bNN），
+ * 放在 Ubuntu 的 /lib/firmware/qcom/sm8550/xiaomi/fuxi/。initramfs 阶段 probe 时找不到固件，
+ * 由 Ubuntu 里的 fuxi-remoteproc.service 在根文件系统挂好后启动。
+ */
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8550/xiaomi/fuxi/adsp.mdt",
+			"qcom/sm8550/xiaomi/fuxi/adsp_dtb.mdt";
+	status = "okay";
+};
+
+/* 运行中 DTB 里比 sm8550.dtsi 大的两段（Xiaomi 固件更大） */
+&adspslpi_mem {
+	reg = <0x0 0x9ea00000 0x0 0x4680000>;
+};
+
+&hwfence_shbuf {
+	reg = <0x0 0xe6440000 0x0 0x2dd000>;
+};
+
+/* ======== Display: MSM DPU + DSI0 + panel-xiaomi-fuxi ======== */
+
+/ {
+	/* 面板三路电源都是 GPIO 控制的负载开关（厂商 display_panel_vddio/vci/vddd），开机时已打开 */
+	panel_vddio_1p8: regulator-panel-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddio_1p8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 126 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	panel_vci_3p0: regulator-panel-vci {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vci_3p0";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		gpio = <&tlmm 127 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	panel_vddd_1p5: regulator-panel-vddd {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vddd_1p5";
+		regulator-min-microvolt = <1500000>;
+		regulator-max-microvolt = <1500000>;
+		gpio = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+};
+
+&dispcc {
+	status = "okay";
+};
+
+/*
+ * 原生显示变体只让 MSM DPU/DSI 作为 DRM 输出。保留启动 framebuffer 的保留内存与
+ * fuxi 早期 console，但不注册第二张 simpledrm 卡，避免桌面选中旧 bootloader 输出。
+ */
+&framebuffer0 {
+	status = "disabled";
+};
+
+&mdss {
+	memory-region = <&cont_splash_mem>;
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l3e_1p2>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "xiaomi,fuxi-m3-38-0c-0a";
+		reg = <0>;
+
+		pinctrl-0 = <&sde_dsi_active>, <&sde_te>;
+		pinctrl-1 = <&sde_dsi_suspend>, <&sde_te>;
+		pinctrl-names = "default", "sleep";
+
+		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&panel_vddio_1p8>;
+		vddd-supply = <&panel_vddd_1p5>;
+		vci-supply = <&panel_vci_3p0>;
+
+		port {
+			panel0_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel0_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l1e_0p88>;
+	status = "okay";
+};
+
+&tlmm {
+	sde_dsi_active: sde-dsi-active-state {
+		pins = "gpio133";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	sde_dsi_suspend: sde-dsi-suspend-state {
+		pins = "gpio133";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	/* 厂商 sde_te_active：GPIO86 mdp_vsync */
+	sde_te: sde-te-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+/*
+ * GPU：Adreno 740。a740_sqe.fw、gmu_gen70200.bin 放 /lib/firmware/qcom/；签名的 zap shader 取自 Android
+ * /vendor/firmware（a740_zap.mdt + .bNN），放 /lib/firmware/qcom/sm8550/xiaomi/fuxi/。
+ * 固件在第一次打开 GPU 时才加载（那时根文件系统已挂好）。
+ */
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8550/xiaomi/fuxi/a740_zap.mdt";
+};
+
+/* ======== Audio: 2x CS35L41 speakers on SECONDARY_MI2S ======== */
+
+/ {
+	/*
+	 * 上扬声器兼听筒：厂商在 T 功放上挂了 rcv_gpio_high/low（GPIO68），通话听筒模式拉高。
+	 * 用 simple-audio-mux 把 GPIO68 暴露成 ALSA 控件 "RCV MUX"（Speaker/Earpiece），由 UCM 切换。
+	 */
+	rcv_switch: audio-mux-rcv {
+		compatible = "simple-audio-mux";
+		mux-gpios = <&tlmm 68 GPIO_ACTIVE_HIGH>;
+		state-labels = "Speaker", "Earpiece";
+		sound-name-prefix = "RCV";
+		pinctrl-0 = <&rcv_switch_default>;
+		pinctrl-names = "default";
+	};
+
+	sound: sound {
+		compatible = "xiaomi,fuxi-sndcard";
+		model = "Xiaomi-13";
+		pinctrl-0 = <&i2s1_default>;
+		pinctrl-names = "default";
+		aux-devs = <&rcv_switch>;
+
+		speaker-dai-link {
+			link-name = "Secondary MI2S Playback";
+
+			codec {
+				sound-dai = <&spk_amp_t 0>, <&spk_amp_b 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+};
+
+&gpi_dma2 {
+	status = "okay";
+};
+
+&i2c8 {
+	clock-frequency = <400000>;
+	/*
+	 * fuxi 的 QUP2 SE0 走 GPIO0/1（"mirb" 那组），不是 sm8550.dtsi 默认的 GPIO56/57（mira）；
+	 * GPIO57 在本机是长焦相机的 AVDD 开关（厂商 camera_tele_avdd_ldo）。厂商 qupv3_se8_i2c_*_active。
+	 */
+	pinctrl-0 = <&qup_i2c8_mirb_data_clk>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	spk_amp_b: speaker-amp@40 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x40>;
+		interrupts-extended = <&tlmm 99 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 183 GPIO_ACTIVE_HIGH>;	/* 驱动置 1 = 解除复位 */
+		pinctrl-0 = <&spk_amp_b_default>;
+		pinctrl-names = "default";
+		sound-name-prefix = "B";
+		/* DSP 固件名 cirrus/cs35l41-dsp1-spk-prot-xiaomi-fuxi-B.{wmfw,bin}（打开 "B DSP1 Preload Switch" 才加载） */
+		cirrus,subsystem-id = "xiaomi-fuxi";
+		#sound-dai-cells = <1>;
+
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+
+	spk_amp_t: speaker-amp@42 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x42>;
+		interrupts-extended = <&tlmm 98 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 182 GPIO_ACTIVE_HIGH>;	/* 驱动置 1 = 解除复位 */
+		pinctrl-0 = <&spk_amp_t_default>;
+		pinctrl-names = "default";
+		sound-name-prefix = "T";
+		cirrus,subsystem-id = "xiaomi-fuxi";
+		#sound-dai-cells = <1>;
+
+		cirrus,boost-peak-milliamp = <4000>;
+		cirrus,boost-ind-nanohenry = <1000>;
+		cirrus,boost-cap-microfarad = <15>;
+		cirrus,asp-sdout-hiz = <3>;
+		cirrus,gpio2-src-select = <4>;
+		cirrus,gpio2-output-enable;
+	};
+};
+
+&q6apmbedai {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	dai@12 {
+		reg = <SECONDARY_MI2S_RX>;
+		clocks = <&q6prmcc LPASS_CLK_ID_SEC_MI2S_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "bclk";
+	};
+};
+
+&tlmm {
+	qup_i2c8_mirb_data_clk: qup-i2c8-mirb-data-clk-state {
+		sda-pins {
+			pins = "gpio0";
+			function = "qup2_se0_l0_mirb";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		scl-pins {
+			pins = "gpio1";
+			function = "qup2_se0_l1_mirb";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	/* 厂商 tdm1_*_active：i2s1_* 功能、8 mA、无上下拉 */
+	i2s1_default: i2s1-default-state {
+		sck-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data0-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	/* 厂商 rcv_gpio_low（默认扬声器模式） */
+	rcv_switch_default: rcv-switch-default-state {
+		pins = "gpio68";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	/* 厂商 cirrus_reset_default_0 / cirrus_irq_default_0 */
+	spk_amp_b_default: spk-amp-b-default-state {
+		reset-pins {
+			pins = "gpio183";
+			function = "gpio";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		irq-pins {
+			pins = "gpio99";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	spk_amp_t_default: spk-amp-t-default-state {
+		reset-pins {
+			pins = "gpio182";
+			function = "gpio";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		irq-pins {
+			pins = "gpio98";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+};
+
+/* ======== Audio: WCD9385 codec (analog mics, USB-C headset) ======== */
+
+/ {
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9385-codec";
+
+		pinctrl-0 = <&wcd_default>;
+		pinctrl-names = "default";
+
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		reset-gpios = <&tlmm 108 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&vreg_l15b_1p8>;
+		vdd-rxtx-supply = <&vreg_l15b_1p8>;
+		vdd-io-supply = <&vreg_l15b_1p8>;
+		vdd-mic-bias-supply = <&vreg_bob1>;
+
+		#sound-dai-cells = <1>;
+	};
+};
+
+&sound {
+	/* 厂商 qcom,audio-routing 里与 WCD 模拟麦克风/耳机相关的部分 */
+	audio-routing = "IN1_HPHL", "HPHL_OUT",
+			"IN2_HPHR", "HPHR_OUT",
+			"AMIC1", "MIC BIAS1",
+			"AMIC2", "MIC BIAS2",
+			"AMIC3", "MIC BIAS3",
+			"AMIC4", "MIC BIAS3",
+			"AMIC5", "MIC BIAS4",
+			"TX SWR_INPUT0", "ADC1_OUTPUT",
+			"TX SWR_INPUT1", "ADC2_OUTPUT",
+			"TX SWR_INPUT0", "ADC3_OUTPUT",
+			"TX SWR_INPUT1", "ADC4_OUTPUT";
+
+	wcd-playback-dai-link {
+		link-name = "WCD Playback";
+
+		cpu {
+			sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+		};
+
+		codec {
+			sound-dai = <&wcd938x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+
+	wcd-capture-dai-link {
+		link-name = "WCD Capture";
+
+		cpu {
+			sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+		};
+
+		codec {
+			sound-dai = <&wcd938x 1>, <&swr2 0>, <&lpass_txmacro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+};
+
+&swr1 {
+	status = "okay";
+
+	/* WCD9385 RX */
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	/* WCD9385 TX */
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <2 2 3 4>;
+	};
+};
+
+&tlmm {
+	/* 厂商 wcd938x_reset_active：GPIO108 */
+	wcd_default: wcd-reset-n-active-state {
+		pins = "gpio108";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-low;
+	};
+};
+
+/* ======== Modem: IPA + MPSS ======== */
+
+/*
+ * 厂商 DTB 的 ipa_smmu_ap（SID 0x4a0）用 qcom,additional-mapping 直通映射 IMEM 0x146a8000/0x2000，
+ * sm8550.dtsi 的 modem-tables@8000 对应 0x14688000。modem11 实测 IPA 访问 iova 0x146a9080 触发
+ * SMMU context fault（SID 0x4a0），随后基带报 IPA_IRQ_STTS 0x1（BAD_SNOC_ACCESS）。按厂商地址映射。
+ */
+&{/soc@0/sram@14680000} {
+	ipa_modem_tables_fuxi: modem-tables@28000 {
+		reg = <0x28000 0x2000>;
+	};
+};
+
+&ipa {
+	firmware-name = "qcom/sm8550/xiaomi/fuxi/ipa_fws.mdt";
+	sram = <&ipa_modem_tables_fuxi>;
+	status = "okay";
+};
+
+&remoteproc_mpss {
+	firmware-name = "qcom/sm8550/xiaomi/fuxi/modem.mdt",
+			"qcom/sm8550/xiaomi/fuxi/modem_dtb.mdt";
+	status = "okay";
+};
+
+/* ======== USB-C: pmic_glink connector, FSA4480, DP alt mode ======== */
+
+/ {
+	pmic-glink {
+		orientation-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_dp_qmpphy_out>;
+					};
+				};
+
+				port@2 {
+					reg = <2>;
+
+					pmic_glink_sbu: endpoint {
+						remote-endpoint = <&fsa4480_sbu_mux>;
+					};
+				};
+			};
+		};
+	};
+};
+
+/* Parent QUP of i2c_hub_2; stock: qcom,qupv3_i2c_geni_se@9c0000 / i2c@988000 / fsa4480@42. */
+&i2c_master_hub_0 {
+	status = "okay";
+};
+
+&i2c_hub_2 {
+	status = "okay";
+
+	typec-mux@42 {
+		compatible = "fcs,fsa4480";
+		reg = <0x42>;
+
+		vcc-supply = <&vreg_bob1>;
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			fsa4480_sbu_mux: endpoint {
+				remote-endpoint = <&pmic_glink_sbu>;
+			};
+		};
+	};
+};
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&pmic_glink_hs_in>;
+};
+
+&usb_dp_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in>;
+};
+
+&mdss_dp0 {
+	status = "okay";
+};
