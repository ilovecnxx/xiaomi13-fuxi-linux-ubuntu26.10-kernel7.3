+/*
+ * fuxi OTG experiment: write "<prop> <value>" to send BC_XM_SET (0x51).
+ * e.g. echo 6 0 > /sys/kernel/debug/qcom_battmgr/xm_set
+ */
+static ssize_t qcom_battmgr_xm_set_write(struct file *file, const char __user *ubuf,
+					 size_t count, loff_t *ppos)
+{
+	struct qcom_battmgr *battmgr = file->private_data;
+	char buf[32];
+	u32 prop, value, reply = 0, result = 0;
+	int ret;
+
+	if (count == 0 || count >= sizeof(buf))
+		return -EINVAL;
+
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	if (sscanf(buf, "%u %u", &prop, &value) != 2)
+		return -EINVAL;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	ret = qcom_battmgr_raw_req(battmgr, BATTMGR_XM_PROPERTY_SET, prop, value,
+				   &reply, &result);
+	dev_info(battmgr->dev,
+		 "xm_set prop %u value %u: ret %d reply %u result %u len %zu\n",
+		 prop, value, ret, reply, result, battmgr->raw_len);
+
+	return ret ? ret : count;
+}
