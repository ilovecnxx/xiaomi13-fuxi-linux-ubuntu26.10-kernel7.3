+/*
+ * fuxi: Xiaomi's stock firmware programs a dedicated host-mode tuning
+ * sequence (param-override-seq-host in fuxi-live.dts).  The mainline
+ * defaults leave the USB2 host link unreliable with some devices
+ * (EPROTO, "Device not responding to setup address", uas host reset).
+ * Values are ordered from EUSB2_TUNE_USB2_CROSSOVER (0x50) upwards.
+ */
+static const u8 fuxi_host_tune_vals[EUSB2_TUNE_TBL_NUM] = {
+	0x00,	/* EUSB2_TUNE_USB2_CROSSOVER */
+	0x0f,	/* EUSB2_TUNE_IUSB2 */
+	0x04,	/* EUSB2_TUNE_RES_FSDIF */
+	0x07,	/* EUSB2_TUNE_HSDISC */
+	0x02,	/* EUSB2_TUNE_SQUELCH_U */
+	0x03,	/* EUSB2_TUNE_USB2_SLEW */
+	0x00,	/* EUSB2_TUNE_USB2_EQU */
+	0x07,	/* EUSB2_TUNE_USB2_PREEM */
+	0x02,	/* EUSB2_TUNE_USB2_HS_COMP_CUR */
+	0x03,	/* EUSB2_TUNE_EUSB_SLEW */
+	0x03,	/* EUSB2_TUNE_EUSB_EQU */
+	0x02,	/* EUSB2_TUNE_EUSB_HS_COMP_CUR */
+};
+
+static void eusb2_repeater_write_tune(struct eusb2_repeater *rptr,
+				      const u8 *vals)
+{
+	int i;
+
+	for (i = 0; i < EUSB2_TUNE_TBL_NUM; i++)
+		regmap_write(rptr->regmap,
+			     EUSB2_TUNE_USB2_CROSSOVER + i, vals[i]);
+}
+
+static void eusb2_repeater_save_tune(struct eusb2_repeater *rptr)
+{
+	unsigned int val;
+	int i;
+
+	for (i = 0; i < EUSB2_TUNE_TBL_NUM; i++) {
+		if (regmap_read(rptr->regmap,
+				EUSB2_TUNE_USB2_CROSSOVER + i, &val))
+			return;
+		rptr->init_tune_vals[i] = val;
+	}
+	rptr->tune_saved = true;
+}
+
 static int eusb2_repeater_init(struct phy *phy)
 {
 	struct eusb2_repeater *rptr = phy_get_drvdata(phy);
@@ -187,6 +237,8 @@ static int eusb2_repeater_init(struct phy *phy)
