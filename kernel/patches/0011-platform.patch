 		regmap_write(regmap, EUSB2_FORCE_VAL_5, V_CLK_19P2M_EN);
+		/* fuxi: apply the stock host tuning sequence */
+		eusb2_repeater_write_tune(rptr, fuxi_host_tune_vals);
 		break;
 	case PHY_MODE_USB_DEVICE:
 		/*
@@ -216,6 +270,9 @@ static int eusb2_repeater_set_mode(struct phy *phy,
 		 */
 		regmap_write(regmap, EUSB2_FORCE_EN_5, 0);
 		regmap_write(regmap, EUSB2_FORCE_VAL_5, 0);
+		/* fuxi: restore the tuning we captured at init time */
+		if (rptr->tune_saved)
+			eusb2_repeater_write_tune(rptr, rptr->init_tune_vals);
 		break;
 	default:
 		return -EINVAL;
