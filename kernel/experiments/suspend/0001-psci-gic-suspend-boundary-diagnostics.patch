diff --git a/drivers/firmware/psci/Kconfig b/drivers/firmware/psci/Kconfig
index 97944168b5e66aea1e38a7eb2d4ced8348fce64b..5ac604f87c40e4604affaa304ee244d53935d7be 100644
--- a/drivers/firmware/psci/Kconfig
+++ b/drivers/firmware/psci/Kconfig
@@ -2,6 +2,15 @@
 config ARM_PSCI_FW
 	bool
 
+config ARM_PSCI_SYSTEM_SUSPEND_DIAG
+	bool "PSCI system suspend boundary diagnostics"
+	depends on ARM_PSCI_FW && ARM64 && ARM_GIC_V3 && SUSPEND && PM_DEBUG
+	help
+	  Snapshot non-secure GIC pending/enabled state and the architectural
+	  counter around SYSTEM_SUSPEND. Report after device resume whether
+	  firmware returned directly or execution used the CPU resume entry.
+	  This is a diagnostic aid, not a wakeup source attribution mechanism.
+
 config ARM_PSCI_CHECKER
 	bool "ARM PSCI checker"
 	depends on ARM_PSCI_FW && HOTPLUG_CPU && CPU_IDLE && !TORTURE_TEST
diff --git a/drivers/firmware/psci/psci.c b/drivers/firmware/psci/psci.c
index e73bae6cb23a3bfa6441503f667b0ffdfcd72536..232f16dba4073aef8e6d1ad54e9a8d2025ab027c 100644
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -20,6 +20,10 @@
 #include <linux/slab.h>
 #include <linux/suspend.h>
 
+#ifdef CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG
+#include <linux/irqchip/arm-gic-v3-suspend.h>
+#endif
+
 #include <uapi/linux/psci.h>
 
 #include <asm/cpuidle.h>
@@ -527,6 +531,45 @@ int psci_cpu_suspend_enter(u32 state)
 }
 #endif
 
+#ifdef CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG
+static struct {
+	struct gic_v3_suspend_snapshot before;
+	struct gic_v3_suspend_snapshot after;
+	int raw_ret;
+	int cpu_ret;
+	bool firmware_returned;
+	bool sampled;
+} psci_suspend_diag;
+
+static void psci_suspend_diag_dump(const char *phase,
+				   struct gic_v3_suspend_snapshot *snapshot)
+{
+	unsigned int i;
+
+	pr_info("suspend-diag %s counter=%llu hppir=%u pmr=%#x intids=%u\n",
+		phase, snapshot->counter, snapshot->hppir, snapshot->pmr,
+		snapshot->nr_intids);
+	for (i = 0; i * 32 < snapshot->nr_intids; i++) {
+		if (snapshot->pending[i])
+			pr_info("suspend-diag %s base=%u pending=%#010x enabled=%#010x\n",
+				phase, i * 32, snapshot->pending[i], snapshot->enabled[i]);
+	}
+}
+
+static void psci_system_suspend_finish(void)
+{
+	if (!psci_suspend_diag.sampled)
+		return;
+
+	pr_info("suspend-diag cpu_ret=%d firmware_returned=%u raw_ret=%d counter_hz=%lu\n",
+		psci_suspend_diag.cpu_ret, psci_suspend_diag.firmware_returned,
+		psci_suspend_diag.raw_ret, (unsigned long)read_sysreg(cntfrq_el0));
+	psci_suspend_diag_dump("before", &psci_suspend_diag.before);
+	psci_suspend_diag_dump("after", &psci_suspend_diag.after);
+	psci_suspend_diag.sampled = false;
+}
+#endif
+
 static int psci_system_suspend(unsigned long unused)
 {
 	int err;
@@ -534,6 +577,10 @@ static int psci_system_suspend(unsigned long unused)
 
 	err = invoke_psci_fn(PSCI_FN_NATIVE(1_0, SYSTEM_SUSPEND),
 			      pa_cpu_resume, 0, 0);
+#ifdef CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG
+	psci_suspend_diag.raw_ret = err;
+	psci_suspend_diag.firmware_returned = true;
+#endif
 	return psci_to_linux_errno(err);
 }
 
@@ -541,13 +588,25 @@ static int psci_system_suspend_enter(suspend_state_t state)
 {
 	pm_set_resume_via_firmware();
 
+#ifdef CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG
+	gic_v3_suspend_snapshot(&psci_suspend_diag.before);
+	psci_suspend_diag.cpu_ret = cpu_suspend(0, psci_system_suspend);
+	gic_v3_suspend_snapshot(&psci_suspend_diag.after);
+	psci_suspend_diag.sampled = true;
+	return psci_suspend_diag.cpu_ret;
+#else
 	return cpu_suspend(0, psci_system_suspend);
+#endif
 }
 
 static int psci_system_suspend_begin(suspend_state_t state)
 {
 	pm_set_suspend_via_firmware();
 
+#ifdef CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG
+	memset(&psci_suspend_diag, 0, sizeof(psci_suspend_diag));
+#endif
+
 	return 0;
 }
 
@@ -555,6 +614,9 @@ static const struct platform_suspend_ops psci_suspend_ops = {
 	.valid          = suspend_valid_only_mem,
 	.enter          = psci_system_suspend_enter,
 	.begin          = psci_system_suspend_begin,
+#ifdef CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG
+	.finish         = psci_system_suspend_finish,
+#endif
 };
 
 static void __init psci_init_system_reset2(void)
diff --git a/drivers/irqchip/irq-gic-v3.c b/drivers/irqchip/irq-gic-v3.c
index 94873646d46fbd6693bdb6b9f8650c6428d297f3..28e0f8b908db24513e6ac2cd79137acbf4b152c8 100644
--- a/drivers/irqchip/irq-gic-v3.c
+++ b/drivers/irqchip/irq-gic-v3.c
@@ -25,6 +25,7 @@
 #include <linux/irqchip.h>
 #include <linux/irqchip/arm-gic-common.h>
 #include <linux/irqchip/arm-gic-v3.h>
+#include <linux/irqchip/arm-gic-v3-suspend.h>
 #include <linux/irqchip/arm-gic-v3-prio.h>
 #include <linux/bitfield.h>
 #include <linux/bits.h>
@@ -241,6 +242,31 @@ static DEFINE_PER_CPU(bool, has_rss);
 #define gic_data_rdist_rd_base()	(gic_data_rdist()->rd_base)
 #define gic_data_rdist_sgi_base()	(gic_data_rdist_rd_base() + SZ_64K)
 
+#ifdef CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG
+void gic_v3_suspend_snapshot(struct gic_v3_suspend_snapshot *state)
+{
+	void __iomem *base;
+	unsigned int i;
+
+	/* Read-only: do not acknowledge an IRQ or change its masking state. */
+	state->counter = read_sysreg(cntpct_el0);
+	if (!gic_data.dist_base)
+		return;
+	base = gic_data_rdist_sgi_base();
+	state->hppir = read_sysreg_s(SYS_ICC_HPPIR1_EL1);
+	state->pmr = gic_read_pmr();
+	state->nr_intids = GIC_LINE_NR;
+	state->pending[0] = readl_relaxed(base + GICR_ISPENDR0);
+	state->enabled[0] = readl_relaxed(base + GICR_ISENABLER0);
+	for (i = 1; i * 32 < state->nr_intids; i++) {
+		state->pending[i] = readl_relaxed(gic_data.dist_base +
+						GICD_ISPENDR + i * 4);
+		state->enabled[i] = readl_relaxed(gic_data.dist_base +
+						GICD_ISENABLER + i * 4);
+	}
+}
+#endif
+
 /* Our default, arbitrary priority value. Linux only uses one anyway. */
 #define DEFAULT_PMR_VALUE	0xf0
 
diff --git a/include/linux/irqchip/arm-gic-v3-suspend.h b/include/linux/irqchip/arm-gic-v3-suspend.h
new file mode 100644
index 0000000000000000000000000000000000000000..dc45db6bb7837a7722d014a0c303f19b6677a79b
--- /dev/null
+++ b/include/linux/irqchip/arm-gic-v3-suspend.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_IRQCHIP_ARM_GIC_V3_SUSPEND_H
+#define __LINUX_IRQCHIP_ARM_GIC_V3_SUSPEND_H
+
+#include <linux/types.h>
+
+/* SGIs/PPIs and the standard SPI range; extended SPIs/LPIs are not sampled. */
+#define GIC_V3_SUSPEND_WORDS 32
+
+struct gic_v3_suspend_snapshot {
+	u64 counter;
+	u32 hppir;
+	u32 pmr;
+	u32 nr_intids;
+	u32 pending[GIC_V3_SUSPEND_WORDS];
+	u32 enabled[GIC_V3_SUSPEND_WORDS];
+};
+
+void gic_v3_suspend_snapshot(struct gic_v3_suspend_snapshot *state);
+
+#endif
