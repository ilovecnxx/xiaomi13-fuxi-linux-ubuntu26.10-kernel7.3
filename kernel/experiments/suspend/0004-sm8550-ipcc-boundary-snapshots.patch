diff --git a/drivers/mailbox/qcom-ipcc.c b/drivers/mailbox/qcom-ipcc.c
index bb54295e0..531343901 100644
--- a/drivers/mailbox/qcom-ipcc.c
+++ b/drivers/mailbox/qcom-ipcc.c
@@ -9,9 +9,12 @@
 #include <linux/irqdomain.h>
 #include <linux/mailbox_controller.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/soc/qcom/ipcc-suspend.h>
 #include <linux/spinlock.h>
 
+#include <clocksource/arm_arch_timer.h>
 #include <dt-bindings/mailbox/qcom-ipcc.h>
 
 /* IPCC Register offsets */
@@ -61,6 +64,35 @@ struct qcom_ipcc {
 	int irq;
 };
 
+#if defined(CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG) && IS_BUILTIN(CONFIG_QCOM_IPCC)
+static DEFINE_RAW_SPINLOCK(ipcc_suspend_lock);
+static struct qcom_ipcc *ipcc_suspend_diag;
+
+void qcom_ipcc_suspend_snapshot(struct qcom_ipcc_suspend_snapshot *state)
+{
+	unsigned long flags;
+	struct qcom_ipcc *ipcc;
+
+	memset(state, 0, sizeof(*state));
+	/* Serialize descriptor removal with these non-sleeping MMIO reads. */
+	raw_spin_lock_irqsave(&ipcc_suspend_lock, flags);
+	ipcc = ipcc_suspend_diag;
+	if (ipcc) {
+		state->counter_begin = arch_timer_read_cntpct_el0();
+		state->irq = ipcc->irq;
+		state->config = readl(ipcc->base + IPCC_REG_CONFIG);
+		/* Firmware may have changed CONFIG while Linux was suspended. */
+		if (!(state->config & IPCC_CLEAR_ON_RECV_RD)) {
+			state->recv_id = readl(ipcc->base + IPCC_REG_RECV_ID);
+			state->recv_valid = true;
+		}
+		state->counter_end = arch_timer_read_cntpct_el0();
+		state->valid = true;
+	}
+	raw_spin_unlock_irqrestore(&ipcc_suspend_lock, flags);
+}
+#endif
+
 static inline struct qcom_ipcc *to_qcom_ipcc(struct mbox_controller *mbox)
 {
 	return container_of(mbox, struct qcom_ipcc, mbox);
@@ -333,6 +365,14 @@ static int qcom_ipcc_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, ipcc);
 
+#if defined(CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG) && IS_BUILTIN(CONFIG_QCOM_IPCC)
+	if (of_machine_is_compatible("qcom,sm8550")) {
+		guard(raw_spinlock_irqsave)(&ipcc_suspend_lock);
+		if (!ipcc_suspend_diag)
+			ipcc_suspend_diag = ipcc;
+	}
+#endif
+
 	return 0;
 
 err_mbox:
@@ -345,6 +385,14 @@ static void qcom_ipcc_remove(struct platform_device *pdev)
 {
 	struct qcom_ipcc *ipcc = platform_get_drvdata(pdev);
 
+#if defined(CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG) && IS_BUILTIN(CONFIG_QCOM_IPCC)
+	{
+		guard(raw_spinlock_irqsave)(&ipcc_suspend_lock);
+		if (ipcc_suspend_diag == ipcc)
+			ipcc_suspend_diag = NULL;
+	}
+#endif
+
 	irq_domain_remove(ipcc->irq_domain);
 }
 
diff --git a/include/linux/soc/qcom/ipcc-suspend.h b/include/linux/soc/qcom/ipcc-suspend.h
new file mode 100644
index 000000000..b7bc8f671
--- /dev/null
+++ b/include/linux/soc/qcom/ipcc-suspend.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_QCOM_IPCC_SUSPEND_H
+#define __LINUX_SOC_QCOM_IPCC_SUSPEND_H
+
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct qcom_ipcc_suspend_snapshot {
+	u64 counter_begin;
+	u64 counter_end;
+	u32 config;
+	u32 recv_id;
+	int irq;
+	bool valid;
+	bool recv_valid;
+};
+
+#if defined(CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG) && IS_BUILTIN(CONFIG_QCOM_IPCC)
+void qcom_ipcc_suspend_snapshot(struct qcom_ipcc_suspend_snapshot *state);
+#else
+static inline void qcom_ipcc_suspend_snapshot(struct qcom_ipcc_suspend_snapshot *state)
+{
+	state->valid = false;
+}
+#endif
+
+#endif
