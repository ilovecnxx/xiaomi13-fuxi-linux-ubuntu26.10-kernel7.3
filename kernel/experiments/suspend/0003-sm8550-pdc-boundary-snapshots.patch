--- /dev/null
+++ b/include/linux/irqchip/qcom-pdc-suspend.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_IRQCHIP_QCOM_PDC_SUSPEND_H
+#define __LINUX_IRQCHIP_QCOM_PDC_SUSPEND_H
+
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+#define QCOM_PDC_SUSPEND_MAX_IRQS 256
+
+struct qcom_pdc_suspend_snapshot {
+	u64 counter_begin;
+	u64 counter_end;
+	bool valid;
+	u8 mode;
+	u32 version;
+	u32 gpio_status_mask;
+	u32 num_spis;
+	u32 nr_pins;
+	u32 mapped[QCOM_PDC_SUSPEND_MAX_IRQS / 32];
+	u32 enabled[QCOM_PDC_SUSPEND_MAX_IRQS / 32];
+	u32 parent_intid[QCOM_PDC_SUSPEND_MAX_IRQS];
+	u32 cfg[QCOM_PDC_SUSPEND_MAX_IRQS];
+};
+
+#if defined(CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG) && IS_BUILTIN(CONFIG_QCOM_PDC)
+void qcom_pdc_suspend_snapshot(struct qcom_pdc_suspend_snapshot *state);
+#else
+static inline void qcom_pdc_suspend_snapshot(struct qcom_pdc_suspend_snapshot *state)
+{
+	state->valid = false;
+}
+#endif
+
+#endif
