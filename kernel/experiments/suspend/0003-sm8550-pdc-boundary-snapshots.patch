+#include <asm/arch_timer.h>
+#endif
+
 #define PDC_MAX_IRQS			256
 #define IRQ_ENABLE_BANK_MAX		BITS_TO_BYTES(PDC_MAX_IRQS)
 #define IRQ_ENABLE_BANK_INDEX_MASK	GENMASK(31, 5)
@@ -202,6 +207,59 @@ static u32 pdc_reg_read(int reg, u32 i)
 	return readl_relaxed(pdc->base + reg + i * sizeof(u32));
 }
 
+#if defined(CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG) && IS_BUILTIN(CONFIG_QCOM_PDC)
+/* Published only after successful SM8550 probe; this irqchip is not removed. */
+static struct pdc_desc *pdc_suspend_diag;
+static unsigned int pdc_suspend_nr_pins;
+
+void qcom_pdc_suspend_snapshot(struct qcom_pdc_suspend_snapshot *state)
+{
+	/* Pair with probe's release so descriptor and pin bounds are initialized. */
+	struct pdc_desc *desc = smp_load_acquire(&pdc_suspend_diag);
+	unsigned int r, pin, end, bank;
+	u32 cfg, enabled;
+
+	memset(state, 0, sizeof(*state));
+	if (!desc)
+		return;
+
+	state->counter_begin = arch_timer_read_cntpct_el0();
+	state->version = desc->version;
+	state->mode = desc->mode;
+	state->num_spis = desc->num_spis;
+	if (desc->version >= PDC_VERSION_3_0 && desc->mode == PDC_SECONDARY_MODE)
+		state->gpio_status_mask = BIT(desc->cfg_fields->gpio_irq_sts);
+
+	/* Only read mapped pins. No acknowledge, clear, mask or secure access. */
+	for (r = 0; r < desc->region_cnt; r++) {
+		const struct pdc_pin_region *region = &desc->region[r];
+
+		if (region->pin_base >= pdc_suspend_nr_pins ||
+		    region->cnt > pdc_suspend_nr_pins - region->pin_base)
+			return;
+		end = region->pin_base + region->cnt;
+		for (pin = region->pin_base; pin < end; pin++) {
+			bank = pin / 32;
+			cfg = readl(desc->base + desc->regs->irq_cfg_reg + pin * sizeof(u32));
+			if (desc->version >= PDC_VERSION_3_2)
+				enabled = cfg & BIT(desc->cfg_fields->irq_enable);
+			else
+				enabled = readl(desc->base + desc->regs->irq_en_reg +
+						bank * sizeof(u32)) & BIT(pin % 32);
+			state->mapped[bank] |= BIT(pin % 32);
+			if (enabled)
+				state->enabled[bank] |= BIT(pin % 32);
+			state->cfg[pin] = cfg;
+			/* DT parent SPI numbers exclude the first 32 GIC INTIDs. */
+			state->parent_intid[pin] = pin_to_hwirq(region, pin) + 32;
+		}
+		state->nr_pins = max(state->nr_pins, end);
+	}
+	state->counter_end = arch_timer_read_cntpct_el0();
+	state->valid = true;
+}
+#endif /* CONFIG_ARM_PSCI_SYSTEM_SUSPEND_DIAG && CONFIG_QCOM_PDC=y */
