+static void psci_suspend_diag_dump_pdc(const char *phase,
+				     const struct qcom_pdc_suspend_snapshot *snapshot,
+				     const struct qcom_pdc_suspend_snapshot *other)
+{
+	unsigned int i;
+	bool enabled, changed, latched;
+
+	pr_info("suspend-diag pdc %s valid=%u version=%#x mode=%u gpio_status_mask=%#x num_spis=%u\n",
+		phase, snapshot->valid, snapshot->version, snapshot->mode,
+		snapshot->gpio_status_mask, snapshot->num_spis);
+	if (!snapshot->valid)
+		return;
+
+	pr_info("suspend-diag pdc %s counter_begin=%llu counter_end=%llu\n",
+		phase, snapshot->counter_begin, snapshot->counter_end);
+	for (i = 0; i < snapshot->nr_pins; i++) {
+		if (!(snapshot->mapped[i / 32] & BIT(i % 32)))
+			continue;
+		enabled = snapshot->enabled[i / 32] & BIT(i % 32);
+		changed = other->valid &&
+			(snapshot->cfg[i] != other->cfg[i] ||
+			 ((snapshot->enabled[i / 32] ^ other->enabled[i / 32]) & BIT(i % 32)));
+		latched = i >= snapshot->num_spis &&
+			(snapshot->cfg[i] & snapshot->gpio_status_mask);
+		if (enabled || changed || latched)
+			pr_info("suspend-diag pdc %s pin=%u intid=%u cfg=%#x enabled=%u changed=%u latched=%u\n",
+				phase, i, snapshot->parent_intid[i], snapshot->cfg[i],
+				enabled, changed, latched);
+	}
+}
