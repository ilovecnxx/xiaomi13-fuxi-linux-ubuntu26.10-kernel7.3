+	if (of_device_is_compatible(node, "qcom,sm8550-pdc")) {
+		pdc_suspend_nr_pins = min_t(unsigned int, QCOM_PDC_SUSPEND_MAX_IRQS,
+					   pdc->num_spis + FIELD_GET(GENMASK(15, 8), irq_param));
+		/* Publish the descriptor and bounds together to the suspend reader. */
+		smp_store_release(&pdc_suspend_diag, pdc);
+	}
+#endif
+
 	return 0;
 }
 
diff --git a/include/linux/irqchip/qcom-pdc-suspend.h b/include/linux/irqchip/qcom-pdc-suspend.h
