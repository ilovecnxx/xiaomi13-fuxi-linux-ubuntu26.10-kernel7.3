diff --git a/drivers/soc/qcom/trace-pmic-glink.h b/drivers/soc/qcom/trace-pmic-glink.h
new file mode 100644
index 0000000000000000000000000000000000000000..729d1b7c7bf0a3fac3773b7a24c195511f63a804
--- /dev/null
+++ b/drivers/soc/qcom/trace-pmic-glink.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM pmic_glink
+
+#if !defined(_TRACE_PMIC_GLINK_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_PMIC_GLINK_H
+
+#include <linux/soc/qcom/pmic_glink.h>
+#include <linux/tracepoint.h>
+#include <linux/unaligned.h>
+
+DECLARE_EVENT_CLASS(pmic_glink_message,
+	TP_PROTO(const char *dev, const void *data, size_t len, int ret),
+	TP_ARGS(dev, data, len, ret),
+	TP_STRUCT__entry(
+		__string(dev, dev)
+		__field(size_t, len)
+		__field(bool, header_valid)
+		__field(u32, owner)
+		__field(u32, type)
+		__field(u32, opcode)
+		__field(int, ret)
+	),
+	TP_fast_assign(
+		const struct pmic_glink_hdr *hdr = data;
+
+		__assign_str(dev);
+		__entry->len = len;
+		__entry->header_valid = len >= sizeof(*hdr);
+		__entry->owner = __entry->header_valid ? get_unaligned_le32(&hdr->owner) : 0;
+		__entry->type = __entry->header_valid ? get_unaligned_le32(&hdr->type) : 0;
+		__entry->opcode = __entry->header_valid ? get_unaligned_le32(&hdr->opcode) : 0;
+		__entry->ret = ret;
+	),
+	TP_printk("dev=%s len=%zu header_valid=%u owner=%u type=%u opcode=0x%x ret=%d",
+		  __get_str(dev), __entry->len, __entry->header_valid,
+		  __entry->owner, __entry->type, __entry->opcode, __entry->ret)
+);
+
+DEFINE_EVENT(pmic_glink_message, pmic_glink_tx,
+	TP_PROTO(const char *dev, const void *data, size_t len, int ret),
+	TP_ARGS(dev, data, len, ret)
+);
+
+DEFINE_EVENT(pmic_glink_message, pmic_glink_tx_done,
+	TP_PROTO(const char *dev, const void *data, size_t len, int ret),
+	TP_ARGS(dev, data, len, ret)
+);
+
+DEFINE_EVENT(pmic_glink_message, pmic_glink_rx,
+	TP_PROTO(const char *dev, const void *data, size_t len, int ret),
+	TP_ARGS(dev, data, len, ret)
+);
+
+#endif
+
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH .
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE trace-pmic-glink
+
+#include <trace/define_trace.h>
