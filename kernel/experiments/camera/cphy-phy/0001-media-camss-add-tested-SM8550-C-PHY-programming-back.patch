From cd664341a4bf475c5e9a52665ba254b039c0cb13 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sun, 15 Nov 2026 21:30:56 +0800
Subject: [PATCH] media: camss: add tested SM8550 C-PHY programming backend

Keep endpoint and stream integration gated pending verified IMX800 rate,
settle and RX clock semantics. Preserve vendor PHY 2.1.2 programming
order with explicit validation and 64-bit rate bins.

ARM64 CAMSS W=1 and 68 QEMU KASAN KUnit cases pass; no device deployment.
---
 drivers/media/platform/qcom/camss/Kconfig     |  10 +
 drivers/media/platform/qcom/camss/Makefile    |   1 +
 .../qcom/camss/camss-csiphy-3ph-2-1-2-test.c  | 252 ++++++++++++++++++
 .../qcom/camss/camss-csiphy-3ph-2-1-2.c       | 250 +++++++++++++++++
 .../media/platform/qcom/camss/camss-csiphy.h  |   4 +
 5 files changed, 517 insertions(+)
 create mode 100644 drivers/media/platform/qcom/camss/camss-csiphy-3ph-2-1-2-test.c
 create mode 100644 drivers/media/platform/qcom/camss/camss-csiphy-3ph-2-1-2.c

diff --git a/drivers/media/platform/qcom/camss/Kconfig b/drivers/media/platform/qcom/camss/Kconfig
index 3077ab691..5c346cb76 100644
--- a/drivers/media/platform/qcom/camss/Kconfig
+++ b/drivers/media/platform/qcom/camss/Kconfig
@@ -30,3 +30,13 @@ config VIDEO_QCOM_CAMSS_CSID_KUNIT_TEST
 	  Use a counted parent and a test device with the real runtime PM core.
 	  Check failed parent acquisition, disabled PM, and failed resume.
 	  These tests do not access camera hardware or prove hardware recovery.
+
+config VIDEO_QCOM_CAMSS_CSIPHY_KUNIT_TEST
+	bool "KUnit tests for CAMSS C-PHY programming" if !KUNIT_ALL_TESTS
+	depends on KUNIT=y && VIDEO_QCOM_CAMSS=y
+	default KUNIT_ALL_TESTS
+	help
+	  Exercise SM8550 PHY 2.1.2 C-PHY register programming, input validation,
+	  rate boundaries and stop/reconfigure using memory-backed registers.
+	  Check that rejected configurations leave the registers unchanged.
+	  These tests do not validate electrical timing or sensor modes.
diff --git a/drivers/media/platform/qcom/camss/Makefile b/drivers/media/platform/qcom/camss/Makefile
index 27898b3cc..b8091786a 100644
--- a/drivers/media/platform/qcom/camss/Makefile
+++ b/drivers/media/platform/qcom/camss/Makefile
@@ -13,6 +13,7 @@ qcom-camss-objs += \
 		camss-csiphy.o \
 		camss-csiphy-2ph-1-0.o \
 		camss-csiphy-3ph-1-0.o \
+		camss-csiphy-3ph-2-1-2.o \
 		camss-format.o \
 		camss-ispif.o \
