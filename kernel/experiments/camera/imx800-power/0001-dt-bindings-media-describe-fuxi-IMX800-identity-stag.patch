From 1837763dc6975d6889cfea33b9977362938ed5f0 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sun, 15 Nov 2026 22:55:45 +0800
Subject: [PATCH 1/2] dt-bindings: media: describe fuxi IMX800 identity stage

Describe the board-specific supplies, reset and 19.2 MHz clock needed for
an isolated IMX800 identity check. This experimental binding provides no
CSI endpoint or capture interface and is not a generic sensor pinout.

---
 .../media/i2c/xiaomi,fuxi-imx800.yaml         | 94 +++++++++++++++++++
 1 file changed, 94 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/xiaomi,fuxi-imx800.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/xiaomi,fuxi-imx800.yaml b/Documentation/devicetree/bindings/media/i2c/xiaomi,fuxi-imx800.yaml
new file mode 100644
index 000000000..10ab40404
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/xiaomi,fuxi-imx800.yaml
@@ -0,0 +1,94 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/xiaomi,fuxi-imx800.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi fuxi IMX800 module power and identity bring-up
+
+maintainers:
+  - Codex <codex@localhost>
+
+description: |
+  Experimental board-specific power and identity stage for the Xiaomi 13
+  IMX800 rear module. Supply names follow the verified fuxi module sequence;
+  they do not describe a generic IMX800 sensor pinout. The module is powered
+  down after the identity check. No CSI output or V4L2 capture is provided.
+
+properties:
+  compatible:
+    const: xiaomi,fuxi-imx800
+
+  reg:
+    const: 0x10
+
+  clocks:
+    description: Module input clock, fixed at 19.2 MHz
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  reset-gpios:
+    description: Active-low module reset
+    maxItems: 1
+
+  bob2-supply:
+    description: Parent supply with a 3.104 V consumer voltage request
+
+  vaf-supply:
+    description: Module actuator supply (3.104 V)
+
+  custom2-supply:
+    description: Module secondary supply (3.104 V)
+
+  vana-supply:
+    description: Module analog GPIO-controlled supply (2.8 V)
+
+  custom1-supply:
+    description: Module secondary GPIO-controlled supply (1.8 V)
+
+  vdig-supply:
+    description: Sensor digital supply (1.104 V)
+
+  vio-supply:
+    description: Sensor IO supply (1.8 V)
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - bob2-supply
+  - vaf-supply
+  - custom2-supply
+  - vana-supply
+  - custom1-supply
+  - vdig-supply
+  - vio-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera-sensor@10 {
+            compatible = "xiaomi,fuxi-imx800";
+            reg = <0x10>;
+            clocks = <&cam_mclk2>;
+            reset-gpios = <&tlmm 118 GPIO_ACTIVE_LOW>;
+            bob2-supply = <&bob2>;
+            vaf-supply = <&vaf>;
+            custom2-supply = <&custom2>;
+            vana-supply = <&vana>;
+            custom1-supply = <&custom1>;
+            vdig-supply = <&vdig>;
+            vio-supply = <&vio>;
+        };
+    };
+...
