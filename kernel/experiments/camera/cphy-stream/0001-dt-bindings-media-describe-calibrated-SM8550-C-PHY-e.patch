 1 file changed, 87 insertions(+), 152 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml b/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
index 391931b59..ab72305b9 100644
--- a/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
+++ b/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
@@ -12,6 +12,72 @@ maintainers:
 description:
   The CAMSS IP is a CSI decoder and ISP present on Qualcomm platforms.
 
+$defs:
+  csi-endpoint:
+    $ref: video-interfaces.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      clock-lanes:
+        maxItems: 1
+
+      data-lanes:
+        minItems: 1
+        maxItems: 4
+
+      bus-type:
+        enum: [1, 4]
+
+      qcom,cphy-settle-count:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        minimum: 1
+        maximum: 65535
+        description:
+          Calibrated PHY 2.1.2 C-PHY settle counter with a 400 MHz timer.
+          This is a hardware counter, not a duration in nanoseconds. It is
+          valid only for the single frequency in link-frequencies. The
+          receiver rejects a transmitter using a different link frequency.
+
+    required:
+      - data-lanes
+
+    allOf:
+      - if:
+          properties:
+            bus-type:
+              const: 1
+          required:
+            - bus-type
+        then:
+          properties:
+            clock-lanes: false
+            clock-noncontinuous: false
+            lane-polarities: false
+            data-lanes:
+              minItems: 1
+              maxItems: 3
+              items:
+                maximum: 2
+            line-orders:
+              minItems: 1
+              maxItems: 3
+              items:
+                const: 0
+            link-frequencies:
+              minItems: 1
+              maxItems: 1
+              items:
+                minimum: 1
+                maximum: 2992500000
+          required:
+            - qcom,cphy-settle-count
+            - link-frequencies
+        else:
+          properties:
+            qcom,cphy-settle-count: false
+          required:
+            - clock-lanes
+
 properties:
   compatible:
     const: qcom,sm8550-camss
