@@ -230,6 +246,7 @@ static void cphy_clock_rates_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, clk_get_rate(ctx->clocks[1].clk), 400000000UL);
 	KUNIT_EXPECT_EQ(test, ctx->csiphy.timer_clk_rate, 400000000U);
