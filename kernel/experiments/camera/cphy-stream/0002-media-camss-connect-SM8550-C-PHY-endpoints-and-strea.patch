diff --git a/drivers/media/platform/qcom/camss/camss-endpoint-test.c b/drivers/media/platform/qcom/camss/camss-endpoint-test.c
new file mode 100644
index 000000000..7b05693f3
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-endpoint-test.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Use real software-node properties and the V4L2 endpoint parser. */
+#include <kunit/test.h>
+
+static const struct camss_resources endpoint_resources = {
+	.version = CAMSS_8550,
+	.csiphy_num = 8,
+};
+
+static const struct camss_resources endpoint_other_resources = {
+	.version = CAMSS_7280,
+	.csiphy_num = 5,
+};
+
+static void endpoint_device_cleanup(void *data)
+{
+	root_device_unregister(data);
+}
+
+static int endpoint_test_init(struct kunit *test)
+{
+	struct camss *camss;
+	int ret;
+
+	camss = kunit_kzalloc(test, sizeof(*camss), GFP_KERNEL);
+	if (!camss)
+		return -ENOMEM;
+	camss->dev = root_device_register("camss-endpoint-test");
+	if (IS_ERR(camss->dev))
+		return PTR_ERR(camss->dev);
+	ret = kunit_add_action_or_reset(test, endpoint_device_cleanup, camss->dev);
+	if (ret)
+		return ret;
+	camss->res = &endpoint_resources;
+	camss->legacy_phy = true;
+	test->priv = camss;
+	return 0;
+}
+
+static int endpoint_parse(struct kunit *test, const struct property_entry *props,
+			  const char *port_name, struct camss_async_subdev *csd)
+{
+	struct software_node port = { .name = port_name };
+	struct software_node ep = { .name = "endpoint", .parent = &port,
+				    .properties = props };
+	const struct software_node *group[] = { &port, &ep, NULL };
+	int ret;
+
+	ret = software_node_register_node_group(group);
+	if (ret)
+		return ret;
+	ret = camss_parse_endpoint_node(test->priv, software_node_fwnode(&ep), csd);
+	software_node_unregister_node_group(group);
+	return ret;
+}
+
+static void endpoint_cphy_valid_test(struct kunit *test)
+{
+	u32 lanes[] = { 2, 0, 1 };
+	u32 orders[] = { 0, 0, 0 };
+	struct property_entry props[] = {
+		PROPERTY_ENTRY_U32("bus-type", V4L2_FWNODE_BUS_TYPE_CSI2_CPHY),
+		PROPERTY_ENTRY_U32_ARRAY("data-lanes", lanes),
+		PROPERTY_ENTRY_U32_ARRAY("line-orders", orders),
+		PROPERTY_ENTRY_U32("qcom,cphy-settle-count", 30),
+		PROPERTY_ENTRY_U64("link-frequencies", 1449597917),
+		{}
+	};
+	struct camss_async_subdev csd = {};
+	unsigned int i;
+
+	KUNIT_ASSERT_EQ(test, endpoint_parse(test, props, "port@2", &csd), 0);
+	KUNIT_EXPECT_EQ(test, csd.interface.csiphy_id, 2);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.bus_type, V4L2_MBUS_CSI2_CPHY);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.cphy_link_freq, 1449597917ULL);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.cphy_settle_count, 30U);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.num_data, 3);
+	for (i = 0; i < ARRAY_SIZE(lanes); i++) {
+		KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.data[i].pos, lanes[i]);
+		KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.data[i].pol, 0);
+	}
+	/* The optional line order defaults to ABC; one remapped trio is valid. */
+	props[1] = (struct property_entry)PROPERTY_ENTRY_U32("data-lanes", 2);
+	props[2] = (struct property_entry)PROPERTY_ENTRY_BOOL("unused");
+	KUNIT_ASSERT_EQ(test, endpoint_parse(test, props, "port@0", &csd), 0);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.num_data, 1);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.data[0].pos, 2);
+}
+
+static const char * const endpoint_bad_cases[] = {
+	"duplicate-trio", "trio-out-of-range", "huge-trio", "too-many-trios",
+	"missing-trios", "clock-lane", "polarities", "noncontinuous-clock",
+	"line-order", "line-order-count", "missing-settle", "zero-settle",
+	"large-settle", "missing-frequency", "multiple-frequencies", "zero-frequency",
+	"large-frequency", "wrong-soc", "generic-phy", "invalid-port", "dphy-settle",
+};
+
+static void endpoint_bad_desc(const char * const *name, char *desc)
+{
+	strscpy(desc, *name, KUNIT_PARAM_DESC_SIZE);
+}
+
+KUNIT_ARRAY_PARAM(endpoint_bad, endpoint_bad_cases, endpoint_bad_desc);
+
+static void endpoint_invalid_test(struct kunit *test)
+{
+	struct camss *camss = test->priv;
+	const char *name = *(const char * const *)test->param_value;
+	u32 lanes[] = { 0, 1, 2, 3 };
+	u32 orders[] = { 0, 0, 0 };
+	u64 rates[] = { 1449597917, 1500000000 };
+	struct property_entry props[] = {
+		PROPERTY_ENTRY_U32("bus-type", V4L2_FWNODE_BUS_TYPE_CSI2_CPHY),
+		PROPERTY_ENTRY_U32_ARRAY_LEN("data-lanes", lanes, 3),
+		PROPERTY_ENTRY_U32("qcom,cphy-settle-count", 30),
+		PROPERTY_ENTRY_U64("link-frequencies", 1449597917),
+		PROPERTY_ENTRY_U32_ARRAY("line-orders", orders),
+		PROPERTY_ENTRY_BOOL("unused"),
+		{}
+	};
+	struct camss_async_subdev csd, before;
+	const char *port = "port@2";
+	int expected = -EINVAL;
+
+	memset(&csd, 0xa5, sizeof(csd));
+	memcpy(&before, &csd, sizeof(csd));
+	if (!strcmp(name, "duplicate-trio")) {
+		lanes[2] = 1;
+	} else if (!strcmp(name, "trio-out-of-range")) {
+		lanes[2] = 3;
+	} else if (!strcmp(name, "huge-trio")) {
+		lanes[0] = U32_MAX;
+	} else if (!strcmp(name, "too-many-trios")) {
+		props[1] = (struct property_entry)PROPERTY_ENTRY_U32_ARRAY("data-lanes", lanes);
+	} else if (!strcmp(name, "missing-trios")) {
+		props[1].name = "absent-trios";
+	} else if (!strcmp(name, "clock-lane")) {
+		props[5] = (struct property_entry)PROPERTY_ENTRY_U32("clock-lanes", 4);
+	} else if (!strcmp(name, "polarities")) {
+		props[5] = (struct property_entry)PROPERTY_ENTRY_U32("lane-polarities", 0);
+	} else if (!strcmp(name, "noncontinuous-clock")) {
+		props[5] = (struct property_entry)PROPERTY_ENTRY_BOOL("clock-noncontinuous");
+	} else if (!strcmp(name, "line-order")) {
+		orders[2] = 1;
+		expected = -EOPNOTSUPP;
+	} else if (!strcmp(name, "line-order-count")) {
+		props[4] = (struct property_entry)PROPERTY_ENTRY_U32("line-orders", 0);
+	} else if (!strcmp(name, "missing-settle")) {
+		props[2].name = "absent-settle";
+	} else if (!strcmp(name, "zero-settle")) {
+		props[2] = (struct property_entry)PROPERTY_ENTRY_U32("qcom,cphy-settle-count", 0);
+		expected = -ERANGE;
+	} else if (!strcmp(name, "large-settle")) {
+		props[2] = (struct property_entry)
+			PROPERTY_ENTRY_U32("qcom,cphy-settle-count", 65536);
+		expected = -ERANGE;
+	} else if (!strcmp(name, "missing-frequency")) {
+		props[3].name = "absent-frequency";
+	} else if (!strcmp(name, "multiple-frequencies")) {
+		props[3] = (struct property_entry)
+			PROPERTY_ENTRY_U64_ARRAY("link-frequencies", rates);
+	} else if (!strcmp(name, "zero-frequency")) {
+		props[3] = (struct property_entry)PROPERTY_ENTRY_U64("link-frequencies", 0);
+		expected = -ERANGE;
+	} else if (!strcmp(name, "large-frequency")) {
+		props[3] = (struct property_entry)PROPERTY_ENTRY_U64("link-frequencies", U64_MAX);
+		expected = -ERANGE;
+	} else if (!strcmp(name, "wrong-soc")) {
+		camss->res = &endpoint_other_resources;
+		expected = -EOPNOTSUPP;
+	} else if (!strcmp(name, "generic-phy")) {
+		camss->legacy_phy = false;
+		expected = -EOPNOTSUPP;
+	} else if (!strcmp(name, "invalid-port")) {
+		port = "port@8";
+	} else if (!strcmp(name, "dphy-settle")) {
+		props[0] = (struct property_entry)PROPERTY_ENTRY_U32("bus-type", 4);
+	}
+	KUNIT_EXPECT_EQ(test, endpoint_parse(test, props, port, &csd), expected);
+	KUNIT_EXPECT_MEMEQ(test, &csd, &before, sizeof(csd));
+}
+
+static void endpoint_dphy_test(struct kunit *test)
+{
+	struct camss *camss = test->priv;
+	u32 lanes[] = { 0, 1, 2, 3 };
+	struct property_entry props[] = {
+		PROPERTY_ENTRY_U32("bus-type", V4L2_FWNODE_BUS_TYPE_CSI2_DPHY),
+		PROPERTY_ENTRY_U32_ARRAY("data-lanes", lanes),
+		PROPERTY_ENTRY_U32("clock-lanes", 4),
+		{}
+	};
+	struct camss_async_subdev csd = {};
+	unsigned int i;
+
+	KUNIT_ASSERT_EQ(test, endpoint_parse(test, props, "port@1", &csd), 0);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.bus_type, V4L2_MBUS_CSI2_DPHY);
+	KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.clk.pos, 4);
+	for (i = 0; i < ARRAY_SIZE(lanes); i++)
+		KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.data[i].pos, i);
+	camss->legacy_phy = false;
+	for (i = 0; i < ARRAY_SIZE(lanes); i++)
+		lanes[i]++;
+	props[2] = (struct property_entry)PROPERTY_ENTRY_U32("clock-lanes", 0);
+	KUNIT_ASSERT_EQ(test, endpoint_parse(test, props, "port@1", &csd), 0);
+	for (i = 0; i < ARRAY_SIZE(lanes); i++)
+		KUNIT_EXPECT_EQ(test, csd.interface.csi2.lane_cfg.data[i].pos, i);
+}
+
+static struct kunit_case endpoint_test_cases[] = {
+	KUNIT_CASE(endpoint_cphy_valid_test),
+	KUNIT_CASE_PARAM(endpoint_invalid_test, endpoint_bad_gen_params),
+	KUNIT_CASE(endpoint_dphy_test),
+	{}
+};
+
+static struct kunit_suite endpoint_test_suite = {
+	.name = "camss-endpoint",
+	.init = endpoint_test_init,
+	.test_cases = endpoint_test_cases,
+};
+kunit_test_suite(endpoint_test_suite);
diff --git a/drivers/media/platform/qcom/camss/camss-video-stream-test.c b/drivers/media/platform/qcom/camss/camss-video-stream-test.c
new file mode 100644
index 000000000..8949dcab9
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-video-stream-test.c
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exercise CAMSS stream ordering and cleanup through a real media graph. */
+#include <kunit/test.h>
+
+struct video_stream_test_ctx;
+
+struct video_stream_test_subdev {
+	struct v4l2_subdev sd;
+	struct media_pad pads[2];
+	struct video_stream_test_ctx *ctx;
+	unsigned int id;
+	int start_error;
+	int stop_error;
+};
+
+struct video_stream_test_ctx {
+	struct camss camss;
+	struct camss_video video;
+	struct media_device mdev;
+	struct media_pad pad;
+	struct video_stream_test_subdev subdev[3];
+	unsigned int calls[16];
+	unsigned int num_calls;
+};
+
+static int video_stream_test_call(struct v4l2_subdev *sd, int enable)
+{
+	struct video_stream_test_subdev *subdev =
+		container_of(sd, struct video_stream_test_subdev, sd);
+	struct video_stream_test_ctx *ctx = subdev->ctx;
+
+	if (ctx->num_calls >= ARRAY_SIZE(ctx->calls))
+		return -EOVERFLOW;
+	ctx->calls[ctx->num_calls++] = subdev->id + (enable ? 1 : 11);
+	return enable ? subdev->start_error : subdev->stop_error;
+}
+
+static const struct v4l2_subdev_video_ops video_stream_test_video_ops = {
+	.s_stream = video_stream_test_call,
+};
+
+static const struct v4l2_subdev_ops video_stream_test_ops = {
+	.video = &video_stream_test_video_ops,
+};
+
+static const struct v4l2_subdev_video_ops video_stream_test_no_stream_ops;
+static const struct v4l2_subdev_ops video_stream_test_optional_ops = {
+	.video = &video_stream_test_no_stream_ops,
+};
+
+static void video_stream_test_cleanup(void *data)
+{
+	struct video_stream_test_ctx *ctx = data;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->subdev); i++)
+		media_device_unregister_entity(&ctx->subdev[i].sd.entity);
+	media_device_unregister_entity(&ctx->video.vdev.entity);
+	media_device_cleanup(&ctx->mdev);
+	root_device_unregister(ctx->camss.dev);
+}
+
+static int video_stream_test_init(struct kunit *test)
+{
+	struct video_stream_test_ctx *ctx;
+	struct media_entity *sink;
+	unsigned int i;
+	int ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	test->priv = ctx;
+	ctx->camss.dev = root_device_register("camss-video-stream-test");
+	if (IS_ERR(ctx->camss.dev))
+		return PTR_ERR(ctx->camss.dev);
+	ctx->video.camss = &ctx->camss;
+	ctx->video.vdev.entity.name = "test-video";
+	ctx->video.vdev.entity.function = MEDIA_ENT_F_IO_V4L;
+	media_device_init(&ctx->mdev);
+	ret = kunit_add_action_or_reset(test, video_stream_test_cleanup, ctx);
+	if (ret)
+		return ret;
+	ctx->pad.flags = MEDIA_PAD_FL_SINK;
+	sink = &ctx->video.vdev.entity;
+	ret = media_entity_pads_init(sink, 1, &ctx->pad);
+	if (ret)
+		return ret;
+	ret = media_device_register_entity(&ctx->mdev, sink);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(ctx->subdev); i++) {
+		struct video_stream_test_subdev *subdev = &ctx->subdev[i];
+		unsigned int source_pad = i == ARRAY_SIZE(ctx->subdev) - 1 ? 0 : 1;
+
+		subdev->ctx = ctx;
+		subdev->id = i;
+		v4l2_subdev_init(&subdev->sd, &video_stream_test_ops);
+		subdev->sd.dev = ctx->camss.dev;
+		snprintf(subdev->sd.name, sizeof(subdev->sd.name), "test-subdev-%u", i);
+		subdev->sd.entity.function = source_pad ? MEDIA_ENT_F_VID_IF_BRIDGE :
+							MEDIA_ENT_F_CAM_SENSOR;
+		subdev->pads[0].flags = MEDIA_PAD_FL_SINK;
+		subdev->pads[source_pad].flags = MEDIA_PAD_FL_SOURCE;
+		ret = media_entity_pads_init(&subdev->sd.entity, source_pad + 1, subdev->pads);
+		if (ret)
+			return ret;
+		ret = media_device_register_entity(&ctx->mdev, &subdev->sd.entity);
+		if (ret)
+			return ret;
+		ret = media_create_pad_link(&subdev->sd.entity, source_pad, sink, 0,
+					    MEDIA_LNK_FL_ENABLED);
+		if (ret)
+			return ret;
+		sink = &subdev->sd.entity;
+	}
+	return 0;
+}
+
+static void video_stream_success_test(struct kunit *test)
+{
+	struct video_stream_test_ctx *ctx = test->priv;
+	const unsigned int expected[] = { 1, 2, 3, 11, 12, 13 };
+	unsigned int round;
+
+	for (round = 0; round < 2; round++) {
+		ctx->num_calls = 0;
+		KUNIT_ASSERT_EQ(test, video_start_subdevices(&ctx->video), 0);
+		KUNIT_ASSERT_EQ(test, video_stop_subdevices(&ctx->video, NULL), 0);
+		KUNIT_ASSERT_EQ(test, ctx->num_calls, ARRAY_SIZE(expected));
+		KUNIT_EXPECT_MEMEQ(test, ctx->calls, expected, sizeof(expected));
+	}
+}
+
+static const unsigned int video_stream_fail_indices[] = { 0, 1, 2 };
+KUNIT_ARRAY_PARAM(video_stream_fail, video_stream_fail_indices, NULL);
+
+static void video_stream_start_failure_test(struct kunit *test)
+{
+	struct video_stream_test_ctx *ctx = test->priv;
+	unsigned int failed = *(const unsigned int *)test->param_value;
+	unsigned int i;
+
+	ctx->subdev[failed].start_error = -EIO;
+	KUNIT_EXPECT_EQ(test, video_start_subdevices(&ctx->video), -EIO);
+	KUNIT_ASSERT_EQ(test, ctx->num_calls, 2 * failed + 1);
+	for (i = 0; i <= failed; i++)
+		KUNIT_EXPECT_EQ(test, ctx->calls[i], i + 1);
+	for (i = 0; i < failed; i++)
+		KUNIT_EXPECT_EQ(test, ctx->calls[failed + 1 + i], i + 11);
+	for (i = 0; i < ARRAY_SIZE(ctx->subdev); i++)
+		KUNIT_EXPECT_FALSE(test, ctx->subdev[i].sd.s_stream_enabled);
+	ctx->subdev[failed].start_error = 0;
+	ctx->num_calls = 0;
+	KUNIT_ASSERT_EQ(test, video_start_subdevices(&ctx->video), 0);
+	KUNIT_EXPECT_EQ(test, video_stop_subdevices(&ctx->video, NULL), 0);
+	KUNIT_EXPECT_EQ(test, ctx->num_calls, 6);
+}
+
+static void video_stream_cleanup_failure_test(struct kunit *test)
+{
+	struct video_stream_test_ctx *ctx = test->priv;
+	const unsigned int expected[] = { 1, 2, 3, 11, 12 };
+
+	ctx->subdev[2].start_error = -ENOLINK;
+	ctx->subdev[0].stop_error = -ETIMEDOUT;
+	KUNIT_EXPECT_EQ(test, video_start_subdevices(&ctx->video), -ENOLINK);
+	KUNIT_ASSERT_EQ(test, ctx->num_calls, ARRAY_SIZE(expected));
+	KUNIT_EXPECT_MEMEQ(test, ctx->calls, expected, sizeof(expected));
+}
+
+static void video_stream_stop_failure_test(struct kunit *test)
+{
+	struct video_stream_test_ctx *ctx = test->priv;
+	const unsigned int expected[] = { 1, 2, 3, 11, 12, 13 };
+	unsigned int i;
+
+	KUNIT_ASSERT_EQ(test, video_start_subdevices(&ctx->video), 0);
+	ctx->subdev[0].stop_error = -ETIMEDOUT;
+	ctx->subdev[1].stop_error = -EIO;
+	/* V4L2 logs driver stop errors and clears state, but returns success. */
+	KUNIT_EXPECT_EQ(test, video_stop_subdevices(&ctx->video, NULL), 0);
+	KUNIT_ASSERT_EQ(test, ctx->num_calls, ARRAY_SIZE(expected));
+	KUNIT_EXPECT_MEMEQ(test, ctx->calls, expected, sizeof(expected));
+	for (i = 0; i < ARRAY_SIZE(ctx->subdev); i++)
+		KUNIT_EXPECT_FALSE(test, ctx->subdev[i].sd.s_stream_enabled);
+}
+
+static void video_stream_optional_callback_test(struct kunit *test)
+{
+	struct video_stream_test_ctx *ctx = test->priv;
+	const unsigned int expected[] = { 1, 3, 11, 13 };
+
+	ctx->subdev[1].sd.ops = &video_stream_test_optional_ops;
+	KUNIT_ASSERT_EQ(test, video_start_subdevices(&ctx->video), 0);
+	KUNIT_EXPECT_EQ(test, video_stop_subdevices(&ctx->video, NULL), 0);
+	KUNIT_ASSERT_EQ(test, ctx->num_calls, ARRAY_SIZE(expected));
+	KUNIT_EXPECT_MEMEQ(test, ctx->calls, expected, sizeof(expected));
+}
+
+static struct kunit_case video_stream_test_cases[] = {
+	KUNIT_CASE(video_stream_success_test),
+	KUNIT_CASE_PARAM(video_stream_start_failure_test, video_stream_fail_gen_params),
+	KUNIT_CASE(video_stream_cleanup_failure_test),
+	KUNIT_CASE(video_stream_stop_failure_test),
+	KUNIT_CASE(video_stream_optional_callback_test),
+	{}
+};
+
+static struct kunit_suite video_stream_test_suite = {
+	.name = "camss-video-stream",
+	.init = video_stream_test_init,
+	.test_cases = video_stream_test_cases,
+};
+kunit_test_suite(video_stream_test_suite);
