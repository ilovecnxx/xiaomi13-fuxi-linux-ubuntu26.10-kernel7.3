+static void cphy_stream_lifecycle_test(struct kunit *test)
+{
+	struct cphy_clock_test_ctx *ctx = test->priv;
+	unsigned int i;
+
+	cphy_clock_add_link(test);
+	KUNIT_ASSERT_EQ(test, csiphy_set_clock_rates_cphy(&ctx->csiphy), 0);
+	for (i = 0; i < 2; i++) {
+		KUNIT_ASSERT_EQ(test, csiphy_set_stream_legacy(&ctx->csiphy.subdev, 1), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1000 / 4], 0x0eU);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1014 / 4], 0x2aU);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1018 / 4], 1U);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x20c / 4], 30U);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x60c / 4], 30U);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0xa0c / 4], 30U);
+		KUNIT_ASSERT_EQ(test, csiphy_set_stream_legacy(&ctx->csiphy.subdev, 0), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1000 / 4], 1U);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1014 / 4], 0U);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1018 / 4], 0U);
+	}
+}
+
+static const char * const cphy_stream_bad_cases[] = {
+	"frequency-changed", "source-error", "missing-frequency", "wrong-timer",
+	"zero-settle", "large-settle", "clock-mux", "duplicate-trio", "wrong-soc",
+};
+
+KUNIT_ARRAY_PARAM(cphy_stream_bad, cphy_stream_bad_cases, cphy_clock_bad_desc);
+
+static void cphy_stream_invalid_test(struct kunit *test)
+{
+	struct cphy_clock_test_ctx *ctx = test->priv;
+	const char *name = *(const char * const *)test->param_value;
+	u32 *before;
+	int expected = -EINVAL;
+
+	before = kunit_kmalloc(test, sizeof(ctx->regs), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, before);
+	memset(ctx->regs, 0xa5, sizeof(ctx->regs));
+	memcpy(before, ctx->regs, sizeof(ctx->regs));
+	ctx->mbus_freq = ctx->menu[0];
+	ctx->csiphy.timer_clk_rate = 400000000;
+	if (!strcmp(name, "frequency-changed")) {
+		ctx->mbus_freq = ctx->menu[1];
+		KUNIT_EXPECT_EQ(test, csiphy_set_clock_rates_cphy(&ctx->csiphy), -EINVAL);
+		KUNIT_EXPECT_EQ(test, ctx->mock[0].writes, 0U);
+		KUNIT_EXPECT_EQ(test, ctx->mock[1].writes, 0U);
+	} else if (!strcmp(name, "source-error")) {
+		ctx->mbus_error = -EIO;
+		expected = -EIO;
+	} else if (!strcmp(name, "missing-frequency")) {
+		ctx->mbus_freq = 0;
+		expected = -ENOENT;
+	} else if (!strcmp(name, "wrong-timer")) {
+		ctx->csiphy.timer_clk_rate = 200000000;
+	} else if (!strcmp(name, "zero-settle")) {
+		ctx->csi2.cphy_settle_count = 0;
+		expected = -ERANGE;
+	} else if (!strcmp(name, "large-settle")) {
+		ctx->csi2.cphy_settle_count = 65536;
+		expected = -ERANGE;
+	} else if (!strcmp(name, "clock-mux")) {
+		ctx->csiphy.base_clk_mux = ctx->csiphy.base;
+		expected = -EOPNOTSUPP;
+	} else if (!strcmp(name, "duplicate-trio")) {
+		ctx->lanes[2].pos = 1;
+	} else if (!strcmp(name, "wrong-soc")) {
+		ctx->resources.version = CAMSS_7280;
+		expected = -EOPNOTSUPP;
+		KUNIT_EXPECT_EQ(test, csiphy_set_stream_legacy(&ctx->csiphy.subdev, 0),
+				-EOPNOTSUPP);
+	}
+	KUNIT_EXPECT_EQ(test, csiphy_set_stream_legacy(&ctx->csiphy.subdev, 1), expected);
+	KUNIT_EXPECT_MEMEQ(test, ctx->regs, before, sizeof(ctx->regs));
+}
+
+static void dphy_stream_regression_test(struct kunit *test)
+{
+	static const struct csiphy_subdev_resources resources = {
+		.hw_ops = &csiphy_ops_3ph_1_0,
+		.formats = &csiphy_formats_sdm845,
+	};
+	struct cphy_clock_test_ctx *ctx = test->priv;
+	struct v4l2_ctrl *ctrl;
+	unsigned int round;
+
+	ctx->csiphy.res = &resources;
+	ctx->csiphy.timer_clk_rate = 400000000;
+	ctx->csiphy.fmt[MSM_CSIPHY_PAD_SINK].code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	ctx->csi2.bus_type = V4L2_MBUS_CSI2_DPHY;
+	ctx->csi2.lane_cfg.num_data = 2;
+	ctx->csi2.lane_cfg.clk.pos = 4;
+	/* D-PHY still accepts the existing pixel-rate fallback. */
+	ctrl = v4l2_ctrl_new_std(&ctx->controls, NULL, V4L2_CID_PIXEL_RATE,
+				0, 2000000000, 1, 200000000);
+	KUNIT_ASSERT_NOT_NULL(test, ctrl);
+	KUNIT_ASSERT_EQ(test, resources.hw_ops->init(&ctx->csiphy), 0);
+	for (round = 0; round < 2; round++) {
+		KUNIT_ASSERT_EQ(test, csiphy_set_stream_legacy(&ctx->csiphy.subdev, 1), 0);
+		/* Clock and data lanes 0/1, with the C-PHY mode bit clear. */
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1014 / 4], 0x85U);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1018 / 4], 1U);
+		KUNIT_ASSERT_EQ(test, csiphy_set_stream_legacy(&ctx->csiphy.subdev, 0), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1014 / 4], 0U);
+		KUNIT_EXPECT_EQ(test, ctx->regs[0x1018 / 4], 0U);
+	}
+}
+
 static struct kunit_case cphy_clock_cases[] = {
 	KUNIT_CASE(cphy_clock_link_sources_test),
 	KUNIT_CASE(cphy_clock_rates_test),
 	KUNIT_CASE_PARAM(cphy_clock_invalid_test, cphy_clock_bad_gen_params),
 	KUNIT_CASE(cphy_clock_conversion_test),
 	KUNIT_CASE(cphy_clock_provider_failure_test),
+	KUNIT_CASE(cphy_stream_lifecycle_test),
+	KUNIT_CASE_PARAM(cphy_stream_invalid_test, cphy_stream_bad_gen_params),
+	KUNIT_CASE(dphy_stream_regression_test),
 	{}
 };
 
