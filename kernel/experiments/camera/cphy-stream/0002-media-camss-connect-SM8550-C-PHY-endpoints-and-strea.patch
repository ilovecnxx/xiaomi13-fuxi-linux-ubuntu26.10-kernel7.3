@@ -4680,33 +4680,110 @@ static const struct parent_dev_ops vfe_parent_dev_ops = {
 	.get_base_address = vfe_parent_dev_ops_get_base_address
 };
 
+/* Validate the raw C-PHY mapping before V4L2 can replace duplicates. */
+static int camss_parse_cphy_endpoint(struct device *dev, struct fwnode_handle *ep,
+				     struct csiphy_csi2_cfg *csi2)
+{
+	u32 lanes[MSM_CSIPHY_MAX_CPHY_TRIOS], orders[MSM_CSIPHY_MAX_CPHY_TRIOS];
+	u32 used = 0;
+	int count, i, ret;
+
+	if (fwnode_property_present(ep, "clock-lanes") ||
+	    fwnode_property_present(ep, "lane-polarities") ||
+	    fwnode_property_present(ep, "clock-noncontinuous"))
+		return -EINVAL;
+	count = fwnode_property_count_u32(ep, "data-lanes");
+	if (count < 1 || count > MSM_CSIPHY_MAX_CPHY_TRIOS)
+		return -EINVAL;
+	ret = fwnode_property_read_u32_array(ep, "data-lanes", lanes, count);
+	if (ret)
+		return ret;
+	for (i = 0; i < count; i++) {
+		if (lanes[i] >= MSM_CSIPHY_MAX_CPHY_TRIOS || (used & BIT(lanes[i])))
+			return -EINVAL;
+		used |= BIT(lanes[i]);
+	}
+	if (fwnode_property_present(ep, "line-orders")) {
+		if (fwnode_property_count_u32(ep, "line-orders") != count)
+			return -EINVAL;
+		ret = fwnode_property_read_u32_array(ep, "line-orders", orders, count);
+		if (ret)
+			return ret;
+		for (i = 0; i < count; i++)
+			if (orders[i])
+				return -EOPNOTSUPP;
+	}
+	/* A calibrated count is valid only at this one link rate and 400 MHz timer. */
+	if (fwnode_property_count_u64(ep, "link-frequencies") != 1 ||
+	    fwnode_property_count_u32(ep, "qcom,cphy-settle-count") != 1)
+		return -EINVAL;
+	ret = fwnode_property_read_u64(ep, "link-frequencies", &csi2->cphy_link_freq);
+	if (ret)
+		return ret;
+	if (csiphy_2_1_2_cphy_data_rate(csi2->cphy_link_freq) < 0)
+		return -ERANGE;
+	ret = fwnode_property_read_u32(ep, "qcom,cphy-settle-count",
+				       &csi2->cphy_settle_count);
+	if (ret)
+		return ret;
+	if (!csi2->cphy_settle_count || csi2->cphy_settle_count > U16_MAX)
+		return -ERANGE;
+	csi2->lane_cfg.data = devm_kcalloc(dev, count, sizeof(*csi2->lane_cfg.data),
+					 GFP_KERNEL);
+	if (!csi2->lane_cfg.data)
+		return -ENOMEM;
+	csi2->lane_cfg.num_data = count;
+	csi2->bus_type = V4L2_MBUS_CSI2_CPHY;
+	for (i = 0; i < count; i++)
+		csi2->lane_cfg.data[i].pos = lanes[i];
+	return 0;
+}
