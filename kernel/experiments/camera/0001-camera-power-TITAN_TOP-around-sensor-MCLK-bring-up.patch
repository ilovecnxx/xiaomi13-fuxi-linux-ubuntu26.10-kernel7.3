From 221d44d5ca96be2f6b1487e9bbbdd32cac6c7a60 Mon Sep 17 00:00:00 2001
From: codex <ilovecnxx@gmail.com>
Date: Sun, 8 Nov 2026 00:31:32 +0800
Subject: [PATCH 1/2] camera: power TITAN_TOP around sensor MCLK bring-up

---
 .../dts/qcom/sm8550-xiaomi-fuxi-camera.dtsi    |  4 ++++
 drivers/misc/fuxi-camera-power.c               | 18 ++++++++++++++++--
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-camera.dtsi b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-camera.dtsi
index 74e76de6b..e53c3afd4 100644
--- a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-camera.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-camera.dtsi
@@ -59,6 +59,7 @@ cam_tele_avdd: regulator-cam-tele-avdd {
 
 	cam0_power: camera-power-cam0 {
 		compatible = "xiaomi,fuxi-camera-power";
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
 		supply-names = "vio", "vana", "vdig", "custom1", "custom2", "vaf", "bob2";
 		vio-supply = <&vreg_l2c_1p8>;
 		vana-supply = <&cam_wide_avdd1>;
@@ -75,6 +76,7 @@ cam0_power: camera-power-cam0 {
 
 	cam2_power: camera-power-cam2 {
 		compatible = "xiaomi,fuxi-camera-power";
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
 		supply-names = "vio", "vana", "vdig", "bob2";
 		vio-supply = <&vreg_l2c_1p8>;
 		vana-supply = <&cam_ultra_avdd>;
@@ -88,6 +90,7 @@ cam2_power: camera-power-cam2 {
 
 	cam1_power: camera-power-cam1 {
 		compatible = "xiaomi,fuxi-camera-power";
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
 		supply-names = "vio", "vana", "vdig";
 		vio-supply = <&vreg_l5m_1p8>;
 		vana-supply = <&vreg_l3m_2p8>;
@@ -100,6 +103,7 @@ cam1_power: camera-power-cam1 {
 
 	cam3_power: camera-power-cam3 {
 		compatible = "xiaomi,fuxi-camera-power";
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
 		supply-names = "vio", "vana", "vdig", "custom1", "vaf", "bob2", "bob1";
 		vio-supply = <&vreg_l2c_1p8>;
 		vana-supply = <&cam_tele_avdd>;
diff --git a/drivers/misc/fuxi-camera-power.c b/drivers/misc/fuxi-camera-power.c
index 3b33fc428..98ce28ec0 100644
--- a/drivers/misc/fuxi-camera-power.c
+++ b/drivers/misc/fuxi-camera-power.c
@@ -23,6 +23,7 @@
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
 
 #define FUXI_CAM_MAX_SUPPLIES	8
@@ -43,6 +44,11 @@ static int fuxi_cam_power_on(struct fuxi_cam_power *cp)
 {
 	int i, ret;
 
+	/* MCLK branches require the TITAN_TOP domain before touching clocks. */
+	ret = pm_runtime_resume_and_get(cp->dev);
+	if (ret < 0)
+		return ret;
+
 	gpiod_set_value_cansleep(cp->reset, 1);
 
 	for (i = 0; i < cp->num_supplies; i++) {
@@ -56,8 +62,10 @@ static int fuxi_cam_power_on(struct fuxi_cam_power *cp)
 	}
 
 	ret = clk_set_rate(cp->mclk, cp->mclk_rate);
-	if (ret)
-		dev_warn(cp->dev, "failed to set MCLK to %u: %d\n", cp->mclk_rate, ret);
+	if (ret) {
+		dev_err(cp->dev, "failed to set MCLK to %u: %d\n", cp->mclk_rate, ret);
+		goto err_supplies;
+	}
 	ret = clk_prepare_enable(cp->mclk);
 	if (ret) {
 		dev_err(cp->dev, "failed to enable MCLK: %d\n", ret);
@@ -74,6 +82,7 @@ static int fuxi_cam_power_on(struct fuxi_cam_power *cp)
 err_supplies:
 	while (--i >= 0)
 		regulator_disable(cp->supplies[i].consumer);
+	pm_runtime_put_sync_suspend(cp->dev);
 	return ret;
 }
 
@@ -86,6 +95,7 @@ static void fuxi_cam_power_off(struct fuxi_cam_power *cp)
 	clk_disable_unprepare(cp->mclk);
 	for (i = cp->num_supplies - 1; i >= 0; i--)
 		regulator_disable(cp->supplies[i].consumer);
+	pm_runtime_put_sync_suspend(cp->dev);
 	dev_info(cp->dev, "powered off\n");
 }
 
@@ -163,6 +173,10 @@ static int fuxi_cam_power_probe(struct platform_device *pdev)
 	if (IS_ERR(cp->reset))
 		return dev_err_probe(dev, PTR_ERR(cp->reset), "failed to get reset\n");
 
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
 	platform_set_drvdata(pdev, cp);
 	return 0;
 }
-- 
2.55.0

