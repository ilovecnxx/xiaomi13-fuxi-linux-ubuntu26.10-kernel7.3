From be673aa6b2d91e7b2c9529766858415ba7c8279c Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 14 Nov 2026 21:16:11 +0800
Subject: [PATCH 1/3] dt-bindings: media: qcom,sm8550-camss: describe optional
 CPAS top

Allow the additional CPAS top register region while retaining compatibility
with the existing nineteen-region layout. This belongs to an isolated
diagnostic experiment.
---
 .../devicetree/bindings/media/qcom,sm8550-camss.yaml         | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml b/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
index 4b9ab1352..e2fc7da42 100644
--- a/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
+++ b/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
@@ -17,9 +17,11 @@ properties:
     const: qcom,sm8550-camss
 
   reg:
-    maxItems: 19
+    minItems: 19
+    maxItems: 20
 
   reg-names:
+    minItems: 19
     items:
       - const: csid0
       - const: csid1
@@ -40,6 +42,7 @@ properties:
       - const: vfe2
       - const: vfe_lite0
       - const: vfe_lite1
+      - const: cpas_top
 
   clocks:
     maxItems: 36
