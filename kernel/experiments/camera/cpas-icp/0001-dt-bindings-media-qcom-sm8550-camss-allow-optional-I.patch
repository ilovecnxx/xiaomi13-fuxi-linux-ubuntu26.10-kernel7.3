From d936f8ed6be5db0edbae07610f851cccafd34a54 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sun, 15 Nov 2026 01:33:53 +0800
Subject: [PATCH 1/3] dt-bindings: media: qcom,sm8550-camss: allow optional ICP
 clock

Allow an optional final ICP clock for powered CPAS diagnostics while
preserving the existing 36-clock device tree interface.

---
 .../devicetree/bindings/media/qcom,sm8550-camss.yaml         | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml b/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
index e2fc7da42..391931b59 100644
--- a/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
+++ b/Documentation/devicetree/bindings/media/qcom,sm8550-camss.yaml
@@ -45,9 +45,11 @@ properties:
       - const: cpas_top
 
   clocks:
-    maxItems: 36
+    minItems: 36
+    maxItems: 37
 
   clock-names:
+    minItems: 36
     items:
       - const: camnoc_axi
       - const: cpas_ahb
@@ -85,6 +87,7 @@ properties:
       - const: vfe_lite_ahb
       - const: vfe_lite_cphy_rx
       - const: vfe_lite_csid
+      - const: icp
 
   interrupts:
     maxItems: 18
-- 
2.55.0

