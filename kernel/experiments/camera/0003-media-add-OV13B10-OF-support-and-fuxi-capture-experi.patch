From b990e8bc080de8dd3a25cc83c528e872f89edf75 Mon Sep 17 00:00:00 2001
From: codex <ilovecnxx@gmail.com>
Date: Sun, 8 Nov 2026 00:45:53 +0800
Subject: [PATCH] media: add OV13B10 OF support and fuxi capture experiment

---
 .../bindings/media/i2c/ovti,ov13b10.yaml      | 103 ++++++++++++++++++
 arch/arm64/boot/dts/qcom/Makefile             |   1 +
 .../dts/qcom/sm8550-xiaomi-fuxi-ov13b10.dts   |  46 ++++++++
 drivers/media/i2c/ov13b10.c                   |  16 ++-
 4 files changed, 164 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml
 create mode 100644 arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-ov13b10.dts

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml
new file mode 100644
index 000000000..bfb55f2bd
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml
@@ -0,0 +1,103 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov13b10.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV13B10 CMOS image sensor
+
+maintainers:
+  - ilovecnxx <ilovecnxx@gmail.com>
+
+description:
+  The OV13B10 is a 13 megapixel image sensor with a 19.2 MHz input clock
+  and a two or four lane MIPI CSI-2 D-PHY output.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov13b10
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low reset input.
+    maxItems: 1
+
+  dovdd-supply:
+    description: Digital I/O supply.
+
+  avdd-supply:
+    description: Analog supply.
+
+  dvdd-supply:
+    description: Digital core supply.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+        properties:
+          data-lanes:
+            oneOf:
+              - items:
+                  - const: 1
+                  - const: 2
+              - items:
+                  - const: 1
+                  - const: 2
+                  - const: 3
+                  - const: 4
+          link-frequencies:
+            items:
+              - const: 560000000
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensor@36 {
+            compatible = "ovti,ov13b10";
+            reg = <0x36>;
+            clocks = <&sensor_clk>;
+            dovdd-supply = <&vdd_io>;
+            avdd-supply = <&vdd_analog>;
+            dvdd-supply = <&vdd_core>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <560000000>;
+                    remote-endpoint = <&csi_in>;
+                };
+            };
+        };
+    };
diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index ec13c0b63..60248a929 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -439,6 +439,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-hdk.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-mtp.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-xiaomi-fuxi.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-xiaomi-fuxi-camera.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-xiaomi-fuxi-ov13b10.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-xiaomi-fuxi-sleep.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-qrd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8550-samsung-q5q.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-ov13b10.dts b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-ov13b10.dts
new file mode 100644
index 000000000..133c418b2
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8550-xiaomi-fuxi-ov13b10.dts
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* OV13B10 capture experiment; retain the other manual diagnostic nodes. */
+
+#include "sm8550-xiaomi-fuxi-camera.dts"
+
+&cam2_power {
+	status = "disabled";
+};
+
+&cci0_i2c0 {
+	sensor@36 {
+		compatible = "ovti,ov13b10";
+		reg = <0x36>;
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
+		clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+		assigned-clock-rates = <19200000>;
+		reset-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk1_default>;
+		pinctrl-names = "default";
+		dovdd-supply = <&vreg_l2c_1p8>;
+		avdd-supply = <&cam_ultra_avdd>;
+		dvdd-supply = <&vreg_l1c_1p2>;
+		rotation = <90>;
+
+		port {
+			ov13b10_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <560000000>;
+				remote-endpoint = <&csiphy0_in>;
+			};
+		};
+	};
+};
+
+&camss {
+	ports {
+		port@0 {
+			csiphy0_in: endpoint {
+				clock-lanes = <4>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ov13b10_out>;
+			};
+		};
+	};
+};
diff --git a/drivers/media/i2c/ov13b10.c b/drivers/media/i2c/ov13b10.c
index 242a95834..4cfc14a7f 100644
--- a/drivers/media/i2c/ov13b10.c
+++ b/drivers/media/i2c/ov13b10.c
@@ -7,6 +7,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
@@ -1481,7 +1482,8 @@ static int ov13b10_get_pm_resources(struct ov13b10 *ov13b)
 	int ret;
 
 	ov13b->reset = devm_gpiod_get_optional(ov13b->dev, "reset",
-					       GPIOD_OUT_LOW);
+					       dev_of_node(ov13b->dev) ?
+					       GPIOD_OUT_HIGH : GPIOD_OUT_LOW);
 	if (IS_ERR(ov13b->reset))
 		return dev_err_probe(ov13b->dev, PTR_ERR(ov13b->reset),
 				     "failed to get reset gpio\n");
@@ -1674,7 +1676,8 @@ static int ov13b10_probe(struct i2c_client *client)
 	dev_err(ov13b->dev, "%s failed:%d\n", __func__, ret);
 
 error_power_off:
-	ov13b10_power_off(ov13b->dev);
+	if (full_power)
+		ov13b10_power_off(ov13b->dev);
 
 	return ret;
 }
@@ -1689,6 +1692,8 @@ static void ov13b10_remove(struct i2c_client *client)
 	ov13b10_free_controls(ov13b);
 
 	pm_runtime_disable(ov13b->dev);
+	if (!pm_runtime_status_suspended(ov13b->dev))
+		ov13b10_power_off(ov13b->dev);
 	pm_runtime_set_suspended(ov13b->dev);
 }
 
@@ -1706,11 +1711,18 @@ static const struct acpi_device_id ov13b10_acpi_ids[] = {
 MODULE_DEVICE_TABLE(acpi, ov13b10_acpi_ids);
 #endif
 
+static const struct of_device_id ov13b10_of_match[] = {
+	{ .compatible = "ovti,ov13b10" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ov13b10_of_match);
+
 static struct i2c_driver ov13b10_i2c_driver = {
 	.driver = {
 		.name = "ov13b10",
 		.pm = pm_ptr(&ov13b10_pm_ops),
 		.acpi_match_table = ACPI_PTR(ov13b10_acpi_ids),
+		.of_match_table = ov13b10_of_match,
 	},
 	.probe = ov13b10_probe,
 	.remove = ov13b10_remove,
-- 
2.55.0

