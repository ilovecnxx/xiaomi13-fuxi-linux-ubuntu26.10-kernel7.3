From 7d9d247c3b71e1f3d862c8b1cb2ffbb0db39c054 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sun, 15 Nov 2026 19:02:06 +0800
Subject: [PATCH] media: camss: hold shared clocks across Titan 780 Q-channel
 handshake

Own CPAS AHB and CAMNOC clocks through the global runtime PM lifetime.
Temporarily enable ICP around start and stop requests. Manage HF explicitly
to propagate clock acquisition failures before submitting bandwidth votes.

Retain shared clocks and latch a runtime PM error after failed suspend,
blocking new producers until reboot. This candidate does not repair ICC
provider error suppression or prove recovery from an RPMh timeout.

Exercise the real PM callbacks with counted clocks and RAM registers,
including last-user shutdown, 20 cycles and failed start/stop paths.
---
 .../platform/qcom/camss/camss-cpas-pm-test.c  | 351 ++++++++++++++++++
 drivers/media/platform/qcom/camss/camss.c     | 123 +++++-
 drivers/media/platform/qcom/camss/camss.h     |   3 +
 3 files changed, 469 insertions(+), 8 deletions(-)
 create mode 100644 drivers/media/platform/qcom/camss/camss-cpas-pm-test.c

diff --git a/drivers/media/platform/qcom/camss/camss-cpas-pm-test.c b/drivers/media/platform/qcom/camss/camss-cpas-pm-test.c
new file mode 100644
index 000000000..ebb9cd9db
--- /dev/null
+++ b/drivers/media/platform/qcom/camss/camss-cpas-pm-test.c
@@ -0,0 +1,351 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Real runtime PM and clock core; RAM registers supply hardware responses. */
+#include <kunit/device.h>
+
+struct cpas_pm_test;
+
+struct cpas_pm_clock {
+	struct clk_hw hw;
+	struct clk *clk;
+	struct cpas_pm_test *ctx;
+	unsigned long rate;
+	unsigned int enables;
+	unsigned int disables;
+	int prepare_error;
+	int enable_error;
+	int rate_error;
+	bool enabled;
+};
+
+struct cpas_pm_test {
+	struct camss camss;
+	struct cpas_pm_clock clocks[4];
+	u32 regs[32];
+	u32 response;
+	bool bad_clock_order;
+};
+
+static int cpas_pm_prepare(struct clk_hw *hw)
+{
+	struct cpas_pm_clock *clock = container_of(hw, struct cpas_pm_clock, hw);
+
+	return clock->prepare_error;
+}
+
+static int cpas_pm_enable(struct clk_hw *hw)
+{
+	struct cpas_pm_clock *clock = container_of(hw, struct cpas_pm_clock, hw);
+	struct cpas_pm_test *ctx = clock->ctx;
+
+	clock->enables++;
+	if (clock->enable_error)
+		return clock->enable_error;
+	if (clock != &ctx->clocks[3] && !ctx->clocks[3].enabled)
+		ctx->bad_clock_order = true;
+	if (clock == &ctx->clocks[2]) {
+		if (!ctx->clocks[0].enabled || !ctx->clocks[1].enabled)
+			ctx->bad_clock_order = true;
+		writel(ctx->response, ctx->camss.cpas_top_base + CPAS_QCHANNEL_STATUS);
+	}
+	clock->enabled = true;
+	return 0;
+}
+
+static void cpas_pm_disable(struct clk_hw *hw)
+{
+	struct cpas_pm_clock *clock = container_of(hw, struct cpas_pm_clock, hw);
+	struct cpas_pm_test *ctx = clock->ctx;
+
+	if (clock != &ctx->clocks[2] && ctx->clocks[2].enabled)
+		ctx->bad_clock_order = true;
+	if (clock == &ctx->clocks[3] &&
+	    (ctx->clocks[0].enabled || ctx->clocks[1].enabled))
+		ctx->bad_clock_order = true;
+	clock->enabled = false;
+	clock->disables++;
+}
+
+static unsigned long cpas_pm_recalc_rate(struct clk_hw *hw, unsigned long parent)
+{
+	struct cpas_pm_clock *clock = container_of(hw, struct cpas_pm_clock, hw);
+
+	return clock->rate;
+}
+
+static int cpas_pm_determine_rate(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	struct cpas_pm_clock *clock = container_of(hw, struct cpas_pm_clock, hw);
+
+	return clock->rate_error;
+}
+
+static int cpas_pm_set_rate(struct clk_hw *hw, unsigned long rate, unsigned long parent)
+{
+	struct cpas_pm_clock *clock = container_of(hw, struct cpas_pm_clock, hw);
+
+	clock->rate = rate;
+	return 0;
+}
+
+static const struct clk_ops cpas_pm_clock_ops = {
+	.prepare = cpas_pm_prepare,
+	.enable = cpas_pm_enable,
+	.disable = cpas_pm_disable,
+	.recalc_rate = cpas_pm_recalc_rate,
+	.determine_rate = cpas_pm_determine_rate,
+	.set_rate = cpas_pm_set_rate,
+};
+
+static const struct camss_resources cpas_pm_resources = {
+	.version = CAMSS_8550,
+};
+
+static void cpas_pm_clock_free(void *data)
+{
+	struct cpas_pm_clock *clock = data;
+
+	clk_put(clock->clk);
+	clk_hw_unregister(&clock->hw);
+}
+
+static int cpas_pm_test_init(struct kunit *test)
+{
+	static const char * const names[] = {
+		"cpas-test-ahb", "cpas-test-camnoc", "cpas-test-icp", "cpas-test-hf",
+	};
+	struct cpas_pm_test *ctx;
+	struct device_driver *driver;
+	struct device *dev;
+	int i, ret;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	test->priv = ctx;
+	driver = kunit_driver_create(test, "camss-cpas-pm-test");
+	if (IS_ERR(driver))
+		return PTR_ERR(driver);
+	driver->pm = &camss_pm_ops;
+	dev = kunit_device_register_with_driver(test, "camss-cpas-pm-test", driver);
+	if (IS_ERR(dev))
+		return PTR_ERR(dev);
+	ctx->camss.dev = dev;
+	ctx->camss.res = &cpas_pm_resources;
+	ctx->camss.cpas_top_base = (void __iomem *)ctx->regs;
+	mutex_init(&ctx->camss.cpas_diag_lock);
+	dev_set_drvdata(dev, &ctx->camss);
+	ctx->regs[CPAS_CAMERA_VERSION / 4] = 0x00070800;
+	ctx->regs[CPAS_VERSION / 4] = 0x10000000;
+	ctx->response = BIT(0);
+	for (i = 0; i < ARRAY_SIZE(ctx->clocks); i++) {
+		struct cpas_pm_clock *clock = &ctx->clocks[i];
+		struct clk_init_data init = {
+			.name = names[i],
+			.ops = &cpas_pm_clock_ops,
+		};
+
+		clock->ctx = ctx;
+		clock->rate = 19200000;
+		clock->hw.init = &init;
+		ret = clk_hw_register(NULL, &clock->hw);
+		if (ret)
+			return ret;
+		clock->clk = clk_hw_get_clk(&clock->hw, NULL);
+		if (IS_ERR(clock->clk)) {
+			clk_hw_unregister(&clock->hw);
+			return PTR_ERR(clock->clk);
+		}
+		ret = kunit_add_action_or_reset(test, cpas_pm_clock_free, clock);
+		if (ret)
+			return ret;
+	}
+	ctx->camss.cpas_clks[0].clk = ctx->clocks[0].clk;
+	ctx->camss.cpas_clks[1].clk = ctx->clocks[1].clk;
+	ctx->camss.cpas_icp_clk = ctx->clocks[2].clk;
+	ctx->camss.cpas_hf_clk = ctx->clocks[3].clk;
+	pm_runtime_enable(dev);
+	return 0;
+}
+
+static void cpas_pm_expect_clocks(struct kunit *test, bool on)
+{
+	struct cpas_pm_test *ctx = test->priv;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->clocks); i++) {
+		bool enabled = on && i != 2;
+
+		KUNIT_EXPECT_EQ_MSG(test, !!clk_hw_is_enabled(&ctx->clocks[i].hw),
+				    enabled, "clock %u enable state", i);
+		KUNIT_EXPECT_EQ_MSG(test, !!clk_hw_is_prepared(&ctx->clocks[i].hw),
+				    enabled, "clock %u prepare state", i);
+	}
+}
+
+static void cpas_pm_test_exit(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+	struct device *dev = ctx->camss.dev;
+
+	KUNIT_EXPECT_EQ(test, atomic_read(&dev->power.usage_count), 0);
+	while (atomic_read(&dev->power.usage_count) > 0)
+		pm_runtime_put_noidle(dev);
+	pm_runtime_disable(dev);
+	/* The failed-stop test deliberately leaves these references retained. */
+	if (clk_hw_is_enabled(&ctx->clocks[0].hw))
+		clk_bulk_disable_unprepare(ARRAY_SIZE(ctx->camss.cpas_clks), ctx->camss.cpas_clks);
+	if (clk_hw_is_enabled(&ctx->clocks[3].hw))
+		clk_disable_unprepare(ctx->camss.cpas_hf_clk);
+	cpas_pm_expect_clocks(test, false);
+	KUNIT_EXPECT_FALSE(test, ctx->bad_clock_order);
+	mutex_destroy(&ctx->camss.cpas_diag_lock);
+}
+
+static void cpas_pm_two_users_test(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+	struct device *dev = ctx->camss.dev;
+	unsigned int i;
+
+	for (i = 0; i < 20; i++) {
+		ctx->response = BIT(0);
+		KUNIT_ASSERT_GE(test, pm_runtime_resume_and_get(dev), 0);
+		KUNIT_ASSERT_GE(test, pm_runtime_resume_and_get(dev), 0);
+		KUNIT_EXPECT_EQ(test, ctx->clocks[2].enables, 2 * i + 1);
+		KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], 1U);
+		cpas_pm_expect_clocks(test, true);
+		KUNIT_EXPECT_GE(test, pm_runtime_put_sync(dev), 0);
+		KUNIT_EXPECT_EQ(test, ctx->clocks[2].enables, 2 * i + 1);
+		cpas_pm_expect_clocks(test, true);
+		ctx->response = 0;
+		KUNIT_EXPECT_GE(test, pm_runtime_put_sync(dev), 0);
+		KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], 0U);
+		KUNIT_EXPECT_EQ(test, ctx->clocks[2].enables, 2 * i + 2);
+		KUNIT_EXPECT_TRUE(test, pm_runtime_suspended(dev));
+		cpas_pm_expect_clocks(test, false);
+	}
+}
+
+struct cpas_pm_failure {
+	const char *name;
+	unsigned int clock;
+	int prepare_error;
+	int enable_error;
+	int rate_error;
+};
+
+static const struct cpas_pm_failure cpas_pm_failures[] = {
+	{ "ahb-prepare", 0, -EIO, 0, 0 },
+	{ "camnoc-enable", 1, 0, -EIO, 0 },
+	{ "icp-prepare", 2, -EIO, 0, 0 },
+	{ "icp-enable", 2, 0, -EIO, 0 },
+	{ "ahb-rate", 0, 0, 0, -EIO },
+	{ "camnoc-rate", 1, 0, 0, -EIO },
+	{ "hf-prepare", 3, -EIO, 0, 0 },
+	{ "hf-enable", 3, 0, -EIO, 0 },
+};
+
+static void cpas_pm_failure_description(const struct cpas_pm_failure *param, char *desc)
+{
+	strscpy(desc, param->name, KUNIT_PARAM_DESC_SIZE);
+}
+
+KUNIT_ARRAY_PARAM(cpas_pm_failure, cpas_pm_failures, cpas_pm_failure_description);
+
+static void cpas_pm_resume_failure_test(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+	const struct cpas_pm_failure *param = test->param_value;
+	struct cpas_pm_clock *clock = &ctx->clocks[param->clock];
+
+	clock->prepare_error = param->prepare_error;
+	clock->enable_error = param->enable_error;
+	clock->rate_error = param->rate_error;
+	KUNIT_EXPECT_LT(test, pm_runtime_resume_and_get(ctx->camss.dev), 0);
+	KUNIT_EXPECT_TRUE(test, pm_runtime_suspended(ctx->camss.dev));
+	KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], 0U);
+	cpas_pm_expect_clocks(test, false);
+}
+
+static void cpas_pm_start_timeout_test(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+
+	ctx->response = BIT(1);
+	KUNIT_EXPECT_EQ(test, pm_runtime_resume_and_get(ctx->camss.dev), -ETIMEDOUT);
+	KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], 1U);
+	cpas_pm_expect_clocks(test, false);
+}
+
+static void cpas_pm_unknown_version_test(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+
+	ctx->regs[CPAS_CAMERA_VERSION / 4]++;
+	KUNIT_EXPECT_EQ(test, pm_runtime_resume_and_get(ctx->camss.dev), -ENODEV);
+	KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], 0U);
+	KUNIT_EXPECT_EQ(test, ctx->clocks[2].enables, 0U);
+	cpas_pm_expect_clocks(test, false);
+}
+
+static void cpas_pm_reserved_control_test(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+
+	ctx->regs[CPAS_QCHANNEL_CTRL / 4] = BIT(3);
+	KUNIT_EXPECT_EQ(test, pm_runtime_resume_and_get(ctx->camss.dev), -EINVAL);
+	KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], BIT(3));
+	KUNIT_EXPECT_EQ(test, ctx->clocks[2].enables, 0U);
+	cpas_pm_expect_clocks(test, false);
+}
+
+static void cpas_pm_stop_clock_failure_test(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+	struct device *dev = ctx->camss.dev;
+
+	KUNIT_ASSERT_GE(test, pm_runtime_resume_and_get(dev), 0);
+	ctx->clocks[2].enable_error = -EIO;
+	KUNIT_EXPECT_EQ(test, pm_runtime_put_sync(dev), -EIO);
+	KUNIT_EXPECT_FALSE(test, pm_runtime_suspended(dev));
+	KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], 1U);
+	cpas_pm_expect_clocks(test, true);
+	KUNIT_EXPECT_LT(test, pm_runtime_resume_and_get(dev), 0);
+	cpas_pm_expect_clocks(test, true);
+}
+
+static void cpas_pm_stop_failure_test(struct kunit *test)
+{
+	struct cpas_pm_test *ctx = test->priv;
+	struct device *dev = ctx->camss.dev;
+
+	KUNIT_ASSERT_GE(test, pm_runtime_resume_and_get(dev), 0);
+	ctx->response = BIT(1);
+	KUNIT_EXPECT_EQ(test, pm_runtime_put_sync(dev), -EIO);
+	KUNIT_EXPECT_FALSE(test, pm_runtime_suspended(dev));
+	KUNIT_EXPECT_EQ(test, ctx->regs[CPAS_QCHANNEL_CTRL / 4], 0U);
+	cpas_pm_expect_clocks(test, true);
+	KUNIT_EXPECT_LT(test, pm_runtime_resume_and_get(dev), 0);
+	KUNIT_EXPECT_EQ(test, ctx->clocks[2].enables, 2U);
+	cpas_pm_expect_clocks(test, true);
+}
+
+static struct kunit_case cpas_pm_test_cases[] = {
+	KUNIT_CASE(cpas_pm_two_users_test),
+	KUNIT_CASE_PARAM(cpas_pm_resume_failure_test, cpas_pm_failure_gen_params),
+	KUNIT_CASE(cpas_pm_start_timeout_test),
+	KUNIT_CASE(cpas_pm_unknown_version_test),
+	KUNIT_CASE(cpas_pm_reserved_control_test),
+	KUNIT_CASE(cpas_pm_stop_clock_failure_test),
+	KUNIT_CASE(cpas_pm_stop_failure_test),
+	{}
+};
+
+static struct kunit_suite cpas_pm_test_suite = {
+	.name = "camss-cpas-runtime-pm",
+	.init = cpas_pm_test_init,
+	.exit = cpas_pm_test_exit,
+	.test_cases = cpas_pm_test_cases,
+};
+
+kunit_test_suite(cpas_pm_test_suite);
diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index e6bf45c3e..e96e51953 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -5386,7 +5386,8 @@ static int camss_init_pm_clks(struct camss *camss)
 	unsigned int i;
 	int ret;
 
-	if (!camss->res->pm_clks[0])
+	/* The CPAS path owns HF explicitly so clock failures reach runtime PM. */
+	if (camss->cpas_top_base || !camss->res->pm_clks[0])
 		return 0;
 
 	if (IS_ENABLED(CONFIG_PM_CLK)) {
@@ -5413,6 +5414,42 @@ static int camss_init_pm_clks(struct camss *camss)
 #define CPAS_QCHANNEL_CTRL	0x5c
 #define CPAS_QCHANNEL_STATUS	0x60
 
+/* CAMSS runtime PM owns the shared clocks, including after VFE clock-off. */
+static int camss_cpas_handshake(struct camss *camss, bool on)
+{
+	void __iomem *base = camss->cpas_top_base;
+	u32 status, control, mask = on ? BIT(0) : BIT(0) | BIT(1);
+	int ret;
+
+	mutex_lock(&camss->cpas_diag_lock);
+	if (readl(base + CPAS_CAMERA_VERSION) != 0x00070800 ||
+	    readl(base + CPAS_VERSION) != 0x10000000) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	control = readl(base + CPAS_QCHANNEL_CTRL);
+	if (control & ~BIT(0)) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+
+	ret = clk_prepare_enable(camss->cpas_icp_clk);
+	if (ret)
+		goto unlock;
+
+	writel(on ? 1 : 0, base + CPAS_QCHANNEL_CTRL);
+	/* Flush the request before polling the clocked acknowledgement. */
+	readl(base + CPAS_QCHANNEL_CTRL);
+	ret = readl_poll_timeout(base + CPAS_QCHANNEL_STATUS, status,
+				 (status & mask) == (on ? BIT(0) : 0), 100, 10000);
+	dev_info(camss->dev, "CPAS %s qctrl=%u status=%08x result=%d\n",
+		 on ? "start" : "stop", on, status, ret);
+	clk_disable_unprepare(camss->cpas_icp_clk);
+unlock:
+	mutex_unlock(&camss->cpas_diag_lock);
+	return ret;
+}
+
 /* Call only while the VFE's CPAS AHB clock and CAMSS power domain are on. */
 void camss_cpas_snapshot(struct camss *camss, unsigned int vfe_id,
 			 const char *phase)
@@ -5487,7 +5524,7 @@ static int camss_probe(struct platform_device *pdev)
 	camss->dev = dev;
 	platform_set_drvdata(pdev, camss);
 
-	/* Optional diagnostic resource: older DTBs retain their existing path. */
+	/* Older DTBs without CPAS retain their existing path. */
 	if (camss->res->version == CAMSS_8550) {
 		cpas = platform_get_resource_byname(pdev, IORESOURCE_MEM, "cpas_top");
 		if (cpas) {
@@ -5497,10 +5534,20 @@ static int camss_probe(struct platform_device *pdev)
 			if (IS_ERR(camss->cpas_top_base))
 				return PTR_ERR(camss->cpas_top_base);
 			mutex_init(&camss->cpas_diag_lock);
-			camss->cpas_icp_clk = devm_clk_get_optional(dev, "icp");
+			camss->cpas_icp_clk = devm_clk_get(dev, "icp");
 			if (IS_ERR(camss->cpas_icp_clk))
 				return dev_err_probe(dev, PTR_ERR(camss->cpas_icp_clk),
 						     "failed to get CPAS ICP clock\n");
+			camss->cpas_clks[0].id = "cpas_ahb";
+			camss->cpas_clks[1].id = "camnoc_axi";
+			ret = devm_clk_bulk_get(dev, ARRAY_SIZE(camss->cpas_clks),
+						camss->cpas_clks);
+			if (ret)
+				return dev_err_probe(dev, ret, "failed to get CPAS clocks\n");
+			camss->cpas_hf_clk = devm_clk_get(dev, "gcc_axi_hf");
+			if (IS_ERR(camss->cpas_hf_clk))
+				return dev_err_probe(dev, PTR_ERR(camss->cpas_hf_clk),
+						     "failed to get CPAS HF clock\n");
 		}
 	}
 
@@ -5917,10 +5964,25 @@ static int __maybe_unused camss_runtime_suspend(struct device *dev)
 	int i;
 	int ret;
 
+	if (camss->cpas_top_base) {
+		ret = camss_cpas_handshake(camss, false);
+		if (ret)
+			goto cpas_failed;
+	}
+
 	for (i = 0; i < camss->res->icc_path_num; i++) {
 		ret = icc_set_bw(camss->icc_path[i], 0, 0);
-		if (ret)
+		if (ret) {
+			if (camss->cpas_top_base)
+				goto cpas_failed;
 			return ret;
+		}
+	}
+
+	if (camss->cpas_top_base) {
+		clk_bulk_disable_unprepare(ARRAY_SIZE(camss->cpas_clks), camss->cpas_clks);
+		clk_disable_unprepare(camss->cpas_hf_clk);
+		return 0;
 	}
 
 #if IS_ENABLED(CONFIG_PM_CLK)
@@ -5928,6 +5990,11 @@ static int __maybe_unused camss_runtime_suspend(struct device *dev)
 #else
 	return 0;
 #endif
+
+cpas_failed:
+	/* A fatal runtime PM error blocks new users and retains the power domain. */
+	dev_err(dev, "CPAS suspend failed: %d; retaining shared clocks, reboot required\n", ret);
+	return -EIO;
 }
 
 static int __maybe_unused camss_runtime_resume(struct device *dev)
@@ -5937,21 +6004,60 @@ static int __maybe_unused camss_runtime_resume(struct device *dev)
 	int i;
 	int ret;
 
+	if (camss->cpas_top_base) {
+		ret = clk_prepare_enable(camss->cpas_hf_clk);
+		if (ret)
+			return ret;
+	}
+
 #if IS_ENABLED(CONFIG_PM_CLK)
-	ret = pm_clk_resume(dev);
-	if (ret)
-		return ret;
+	if (!camss->cpas_top_base) {
+		ret = pm_clk_resume(dev);
+		if (ret)
+			return ret;
+	}
 #endif
 
 	for (i = 0; i < camss->res->icc_path_num; i++) {
 		ret = icc_set_bw(camss->icc_path[i],
 				 icc_res[i].icc_bw_tbl.avg,
 				 icc_res[i].icc_bw_tbl.peak);
-		if (ret)
+		if (ret) {
+			if (camss->cpas_top_base)
+				goto clear_bw;
 			return ret;
+		}
+	}
+
+	if (camss->cpas_top_base) {
+		ret = clk_set_rate(camss->cpas_clks[0].clk, 80000000);
+		if (ret)
+			goto clear_bw;
+		ret = clk_set_rate(camss->cpas_clks[1].clk, 300000000);
+		if (ret)
+			goto clear_bw;
+		ret = clk_bulk_prepare_enable(ARRAY_SIZE(camss->cpas_clks), camss->cpas_clks);
+		if (ret)
