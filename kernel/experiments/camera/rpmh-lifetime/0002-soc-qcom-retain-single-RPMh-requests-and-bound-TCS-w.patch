From de9363f69d693c46fbeff60fdbc242057d218d93 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Sat, 14 Nov 2026 20:58:32 +0800
Subject: [PATCH] soc: qcom: retain single RPMh requests and bound TCS waits

Keep synchronous request storage alive until transport completion, release rejected asynchronous requests, and bound each conflict-free TCS availability wait without cancelling outstanding commands. Extend KUnit coverage to single-request ownership and the actual RSC wait path backed by RAM.
---
 drivers/soc/qcom/Kconfig         |   9 +-
 drivers/soc/qcom/rpmh-internal.h |   6 ++
 drivers/soc/qcom/rpmh-rsc-test.c | 179 +++++++++++++++++++++++++++++++
 drivers/soc/qcom/rpmh-rsc.c      |  24 +++--
 drivers/soc/qcom/rpmh-test.c     | 154 +++++++++++++++++++++++++-
 drivers/soc/qcom/rpmh.c          | 128 ++++++++++++++--------
 6 files changed, 444 insertions(+), 56 deletions(-)
 create mode 100644 drivers/soc/qcom/rpmh-rsc-test.c

diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index a8b693a68..dc4b8e26e 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -163,12 +163,13 @@ config QCOM_RPMH
 	  help apply the aggregated state on the resource.
 
 config QCOM_RPMH_KUNIT_TEST
-	bool "KUnit tests for RPMh batch request lifetime" if !KUNIT_ALL_TESTS
-	depends on KUNIT=y && QCOM_RPMH=y
+	bool "KUnit tests for RPMh request lifetime and TCS waits" if !KUNIT_ALL_TESTS
+	depends on KUNIT=y && QCOM_RPMH=y && QCOM_COMMAND_DB=y
 	default KUNIT_ALL_TESTS
 	help
-	  Exercise batch completion, submission failures and late responses
-	  after timeout using a fake transport. No RPMh hardware is accessed.
+	  Exercise completion, submission failures, late responses and TCS
+	  availability waits using a fake transport and register backing memory.
+	  No RPMh hardware is accessed.
 	  Enable KASAN to detect accesses to prematurely freed requests.
 	  Timeout tests each wait for the normal ten-second response deadline.
 
